[
  {
    "name": "Noxian podium",
    "origin": "Saved SparkleRiley screenplay; opening podium excerpt, frozen 2026-10-12",
    "blocks": [
      {
        "id": "5001563e-5d6b-4818-bf6e-44740aaeb01a",
        "kind": "Scene",
        "spans": [
          {
            "text": "EXT. NOXIAN MAIN PLAZA — DAY",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "8bb38cf5-5462-4833-8b44-8c9cbdb052b6",
        "kind": "Action",
        "spans": [
          {
            "text": "A judicial bench and battered defendant’s podium occupy a sunlit square. Three curious citizens stop to watch. Beyond the rooftops, an enormous black fortress dominates the skyline, its battlements bristling with crimson banners.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "f2908c82-0cda-4d6d-a9b5-f4bdd3d33ef8",
        "kind": "Action",
        "spans": [
          {
            "text": "The guard places Riley behind the podium. She edges toward an open passage. Without looking up, he slides his chair into her path. She returns to the podium.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "1ce579b4-b93a-4911-83a4-d3a66f98718d",
        "kind": "Action",
        "spans": [
          {
            "text": "A NOXIAN MAGISTRATE sits behind the bench, armored in black iron. He puts on very small reading glasses.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "9cb7c748-9d0d-499e-8e2a-5ba69da90cc2",
        "kind": "Character",
        "spans": [
          {
            "text": "MAGISTRATE",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "c3a7c82b-2510-40be-9223-b1f9783c8add",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "You entered Noxus under suspicious circumstances—",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "baa5ef46-4b21-4427-9576-99d1acab1859",
        "kind": "Character",
        "spans": [
          {
            "text": "RILEY",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "412bb2d9-2f3a-498d-8532-927e55e11c83",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "That’s fair.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "3c3f1286-0dbb-4910-80d4-179e1773d279",
        "kind": "Character",
        "spans": [
          {
            "text": "MAGISTRATE",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "d8c6b36b-a86f-47f5-b95b-cec736d38f25",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "—and knowingly selected Lux for the top lane.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "7a00d858-7214-459f-ab41-fac9f7f6df5a",
        "kind": "Character",
        "spans": [
          {
            "text": "RILEY",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "e00e60f3-496e-41d7-9b05-5d200d7173b0",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "I’d like to focus on the first thing.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "ec53eedb-529d-4b52-8dd5-8c0d9f141a59",
        "kind": "Action",
        "spans": [
          {
            "text": "A spectator leans closer. Riley shifts behind the podium, avoiding their gaze.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "b84785aa-d4c6-4244-8dfa-decf6d343dce",
        "kind": "Character",
        "spans": [
          {
            "text": "GUARD",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "60fbc714-8a98-4e21-812c-b19510e7333e",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Her team’s statement: “Please. We need someone to stand in front.”",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "ee49a2be-486a-4849-b003-849b6ce486db",
        "kind": "Character",
        "spans": [
          {
            "text": "RILEY",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "eabe9046-b5e9-4a4e-b923-9f9853fe5065",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "I can stand in front.",
            "bold": false,
            "italic": false
          }
        ]
      },
      {
        "id": "f9181a6a-10b9-44af-bb04-dad0ef66f058",
        "kind": "Action",
        "spans": [
          {
            "text": "The magistrate peers at her over the podium. She reluctantly straightens.",
            "bold": false,
            "italic": false
          }
        ]
      }
    ]
  },
  {
    "name": "Ensemble accusation",
