          }
        ]
      }
    ]
  },
  {
    "name": "Sustained dialogue",
    "origin": "Authored evaluation fixture, frozen 2026-10-12",
    "blocks": [
      {
        "id": "39269648-9722-53ee-95fc-43c78e4bf3ff",
        "kind": "Scene",
        "spans": [
          {
            "text": "INT. OBSERVATORY - DAWN"
          }
        ]
      },
      {
        "id": "fa292184-e7b7-51d5-b3cf-7a13fec3503e",
        "kind": "Action",
        "spans": [
          {
            "text": "Two astronomers wait beside a covered telescope. The younger keeps reaching for the cover; the older steadies her hand."
          }
        ]
      },
      {
        "id": "a3349e1b-723a-57ab-a3f6-6988668ff183",
        "kind": "Character",
        "spans": [
          {
            "text": "OLDER"
          }
        ]
      },
      {
        "id": "200900f8-011c-5ffd-bf4c-5433329cfc3d",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "When you look through there, you will want to give it a name. Wait. Let it be something you do not understand for a moment."
          }
        ]
      },
      {
        "id": "a5b8d717-76ce-53d6-892f-6c52f7060a26",
        "kind": "Character",
        "spans": [
          {
            "text": "YOUNGER"
          }
        ]
      },
      {
        "id": "02139e6d-6786-54e8-850b-13dd46cfef4d",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "And if it disappears?"
          }
        ]
      },
      {
        "id": "e594744d-d953-5048-8f26-6e78d8c27d87",
        "kind": "Character",
        "spans": [
          {
            "text": "OLDER"
          }
        ]
      },
      {
        "id": "a606b105-4c0a-572a-8121-346fc223781d",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Then we will have seen it together."
          }
        ]
      },
      {
        "id": "b8c2cdba-3881-51b4-ba05-355f6e18afaf",
        "kind": "Action",
        "spans": [
          {
            "text": "They lift the cover together as the room begins to brighten."
          }
        ]
      }
    ]
  }
