      {
        "id": "4d6b5f69-ad9d-5313-b7cf-22021891d410",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Have we met?"
          }
        ]
      },
      {
        "id": "4f2c3f13-2a2f-54a4-8dc0-3f1f7bba9cac",
        "kind": "Character",
        "spans": [
          {
            "text": "ADA"
          }
        ]
      },
      {
        "id": "3e4c45f4-57a1-5cc1-b3b9-10a957cd3518",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "I would remember."
          }
        ]
      },
