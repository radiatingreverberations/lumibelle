      },
      {
        "id": "947b65d4-3ec0-5aa6-b767-1cd41916ab8b",
        "kind": "Action",
        "spans": [
          {
            "text": "Five council members sit together. Mara stands alone at the open end of their table. Len places a sealed letter in front of her."
          }
        ]
      },
      {
        "id": "95159caf-2434-5c2e-a732-8137692090e1",
        "kind": "Character",
        "spans": [
          {
            "text": "LEN"
          }
        ]
      },
      {
        "id": "9bb76fd5-85a6-5b7a-b652-d66dc3e2ec94",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Your seal. Your handwriting."
          }
        ]
      },
      {
        "id": "e8f901e7-1748-5f10-95c5-b3b5b668a635",
        "kind": "Character",
        "spans": [
          {
            "text": "MARA"
          }
        ]
      },
      {
        "id": "5d314760-ea59-5a03-b44c-71e4265cbe63",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Then someone has learned both."
          }
        ]
      },
      {
        "id": "472912ca-cf32-5892-9a45-72adcc8e111c",
        "kind": "Action",
        "spans": [
          {
            "text": "The youngest councillor looks at Len. One by one the others turn their chairs away from Mara. Mara stays standing."
          }
        ]
      }
    ]
  },
