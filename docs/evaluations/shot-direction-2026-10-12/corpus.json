          }
        ]
      },
      {
        "id": "84e7586d-271c-5ee8-b5d5-5de1f1192ad5",
        "kind": "Action",
        "spans": [
          {
            "text": "An empty space separates two sisters on a bench. Lea puts a repaired cup in that space."
