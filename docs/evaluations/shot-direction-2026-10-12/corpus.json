        "id": "17dd3b83-7ae9-56cc-ad12-feaaf9b0053c",
        "kind": "Action",
        "spans": [
          {
            "text": "The kettle whistles. His daughter reaches past him and switches it off, keeping her eyes on him."
          }
        ]
      },
      {
        "id": "0ab4ecaa-d492-5d1e-9771-6a6534e2fc33",
        "kind": "Character",
        "spans": [
          {
            "text": "DAUGHTER"
          }
        ]
      },
      {
        "id": "a6d3ed58-e1b5-5174-8101-8309a8715cc0",
        "kind": "Dialogue",
        "spans": [
          {
            "text": "Go on."
          }
        ]
      },
      {
        "id": "5ad851c2-018a-52f8-a04f-ed82dcd95b5a",
        "kind": "Action",
        "spans": [
