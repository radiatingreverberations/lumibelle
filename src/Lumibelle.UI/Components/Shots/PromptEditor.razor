@inject IJSRuntime JS
@implements IAsyncDisposable
<section class="prompt-document @(_exact ? "exact-text" : "styled-text")">
    <div class="prompt-toolbar"><strong>H3 prompt</strong>@ToolbarActions<button @onclick="Undo" disabled="@(!_canUndo)" aria-label="Undo prompt edit">Undo</button><button @onclick="Redo" disabled="@(!_canRedo)" aria-label="Redo prompt edit">Redo</button><label><input type="checkbox" @bind="_exact" />Exact text</label></div>
    <div class="prompt-editor-host" @ref="_element" data-prompt-ready="@(_module is not null ? "true" : "false")" style="@(Placeholder is null ? null : $"--prompt-placeholder:\"{Placeholder.Replace("\\", "").Replace("\"", "'")}\"")"></div>
</section>
@code {
    [Parameter] public RenderFragment? ToolbarActions { get; set; }
    // Shown in an empty editor only.
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string? HistoryKey { get; set; }
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public EventCallback<int> PictureClicked { get; set; }
    [Parameter] public EventCallback<int> VideoClicked { get; set; }
    private bool _exact, _disposed, _canUndo, _canRedo;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PromptEditor>? _self;
    private long _sequence;
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed) return;
        if (firstRender) {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("prompt-editor.js"));
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module; _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("mount", _element, _self, Text, HistoryKey);
            if (!_disposed) StateHasChanged();
        }
        else if (_module is not null) await _module.InvokeVoidAsync("replace", _element, Text);
    }
    [JSInvokable] public async Task OnPromptInput(string value, long sequence) { if (sequence <= _sequence) return; _sequence = sequence; Text = value; await TextChanged.InvokeAsync(value); }
    [JSInvokable] public Task OnHistoryChanged(bool canUndo, bool canRedo) { if (_disposed) return Task.CompletedTask; _canUndo = canUndo; _canRedo = canRedo; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task OnPicture(int number) => PictureClicked.InvokeAsync(number);
    [JSInvokable] public Task OnVideo(int number) => VideoClicked.InvokeAsync(number);
    public async Task FlushAsync() { if (_module is not null && !_disposed) { var value = await _module.InvokeAsync<string?>("flush", _element); if (value is not null && value != Text) await TextChanged.InvokeAsync(value); } }
    private Task Undo() => Command("undo");
    private Task Redo() => Command("redo");
    private async Task Command(string command) { if (_module is not null) await _module.InvokeVoidAsync("command", _element, command); }
    public async ValueTask DisposeAsync() { _disposed = true; try { if (_module is not null) { await _module.InvokeVoidAsync("dispose", _element); await _module.DisposeAsync(); } } catch (JSDisconnectedException) { } _self?.Dispose(); }
}
