@inject IVideoGenerator Generator
<form class="settings-card video-model-form" id="@("ai-video-panel-" + Section)" role="tabpanel" aria-labelledby="@("ai-video-" + Section)" @onsubmit="Save" @onsubmit:preventDefault>
    @if (Section == H3Section)
    {
    <div class="video-setup-heading">
        <div><h2>MiniMax H3 Ref2VA</h2><p class="field-hint">@CheckedLabel</p></div>
        <MudButton Disabled="@(_busy || Busy)" OnClick="Refresh" Variant="Variant.Outlined">@(_busy ? "Checking…" : "Check again")</MudButton>
    </div>
    <p class="video-setup-summary" role="status" data-state="@Summary.State">@Summary.Text</p>

    <section class="video-setup-group" aria-labelledby="video-required-files">
        <h3 id="video-required-files">Required files</h3>
        <p class="field-hint">Every preset needs these four. Put each file in the folder shown inside your ComfyUI folder, then check again.</p>
        @foreach (var requirement in H3Requirements.Required) { @RequirementRow(requirement) }
    </section>

    <section class="video-setup-group video-preset-settings" aria-label="Generation presets">
        <h3>Presets</h3>
        <p class="field-hint">Offered in the Shots preset picker. Each lists only what it needs beyond the required files.</p>
        @foreach (var key in H3Presets.Offered) { @PresetRow(key) }
        <details class="video-retired-presets"><summary>Retired presets (@H3Presets.Keys.Count(H3Presets.Retired))</summary>
            <p class="field-hint">No longer offered for new choices. Shots and saved setups that already use them keep generating with these settings.</p>
            @foreach (var key in H3Presets.Keys.Where(H3Presets.Retired)) { @PresetRow(key) }
        </details>
    </section>

    <section class="video-setup-group" aria-labelledby="video-add-ons">
        <h3 id="video-add-ons">Optional add-ons</h3>
        <details class="video-add-on" data-add-on="upscaled-preview"><summary><span class="video-row-title">Upscaled preview</span><span class="field-hint">Samples small, saves full size</span>@Status(UpscaleState)</summary>
            <p>Choose Upscaled preview in Shots to generate at preview size and save native-size video. It adds upscaling, decoding and saving time, and fine detail is softer than native generation.</p>
            @foreach (var requirement in H3Requirements.UpscaledPreview) { @RequirementRow(requirement) }
            @if (_catalog is { DiscoverySucceeded: true, PreviewUpscaling.Issue: { } upscaleIssue }) { <p role="status">@upscaleIssue</p> }
        </details>
        <details class="video-add-on" data-add-on="attention"><summary><span class="video-row-title">Attention</span><span class="field-hint">@H3Performance.Label(_draft.Performance.Attention)</span>@Status(AttentionState)</summary>
            <label>Dense attention<select aria-label="H3 dense attention" @bind="_draft.Performance.Attention" disabled="@(_busy || Busy)">
                @foreach (var backend in Enum.GetValues<H3AttentionBackend>()) { <option value="@backend">@H3Performance.Label(backend)</option> }
            </select></label>
            <p class="field-hint">Server default follows ComfyUI's launch configuration. PyTorch and Comfy Kitchen use built-in nodes. SageAttention also needs the KJNodes node pack.</p>
            @if (_draft.Performance.Attention == H3AttentionBackend.Sage) { @RequirementRow(H3Requirements.SageNodes) }
            @if (_catalog?.AttentionIssue is { } attentionIssue) { <p role="status">@attentionIssue</p> }
        </details>
    </section>
    }
    else
    {
    <h2>Video defaults</h2><p>Apply to video requests and media handling across projects. Queued batches keep their captured settings.</p>
    <label>Video timeout (seconds)<input type="number" min="30" max="86400" @bind="_draft.TimeoutSeconds" /></label>
    <p class="field-hint">The timeout starts when a request starts, not while it waits in Lumibelle.</p>
    <h3>Local media tools</h3>
    <label>FFmpeg executable<input @bind="_draft.Ffmpeg" /></label><label>ffprobe executable<input @bind="_draft.Ffprobe" /></label>
    <p class="field-hint">Used to validate media, prepare voice excerpts and export cuts. Use executable names on PATH or absolute paths.</p>
    }
    @if (_message is not null) { <p role="status">@_message</p> }
    @if (_error is not null) { <p role="alert">@_error</p> }
    <div class="settings-section-actions"><MudButton ButtonType="ButtonType.Submit" Disabled="@(_busy || Busy)" Color="Color.Primary" Variant="Variant.Filled">Save @SectionName</MudButton><MudButton Disabled="@(_busy || Busy)" OnClick="Cancel">Cancel</MudButton></div>
</form>
@code {
    [Parameter, EditorRequired] public AiSettings Settings { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public Func<H3Settings, Task<bool>> SaveSettings { get; set; } = default!;
    // The AI settings page lists these in its sidebar; the draft is shared and each section saves only its own fields.
    public const string H3Section = "h3";
    public static readonly (string Key, string Label, string Kind)[] Sections = [(H3Section, "MiniMax H3 Ref2VA", "ComfyUI")];
    [Parameter] public string Section { get; set; } = H3Section;
    private string SectionName => Section == H3Section ? "video models" : "video defaults";
    private H3Settings? _checked; private H3Settings _draft = new(); private H3Configuration? _catalog; private DateTime? _checkedAt;
    private bool _loaded, _busy, _autoChecked; private string? _error, _message;
    private bool CommonSetupUnchanged => _checked is not null && _checked.Model == _draft.Model && _checked.Encoder == _draft.Encoder && _checked.VideoVae == _draft.VideoVae && _checked.AudioVae == _draft.AudioVae;
    private bool Checked => _catalog is { DiscoverySucceeded: true };
    protected override void OnParametersSet() { if (!_loaded) { _loaded = true; _draft = ShotCopy.Of(Settings.H3); } }
    // Check as soon as the page shows, so nothing reads "not checked" until someone remembers to refresh.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Section != H3Section || _autoChecked || string.IsNullOrWhiteSpace(Settings.ComfyUrl)) return;
        _autoChecked = true; _busy = true; StateHasChanged(); await Refresh(); StateHasChanged();
    }

    private string CheckedLabel => _checkedAt is { } at ? $"Checked at {at:HH:mm} on {Settings.ComfyUrl}" :
        string.IsNullOrWhiteSpace(Settings.ComfyUrl) ? "Connect ComfyUI under Connections first." : $"Not checked yet on {Settings.ComfyUrl}";
    private (string Text, string State) Summary
    {
        get
        {
            if (_catalog is null) return (_busy ? "Checking ComfyUI…" : "Not checked yet.", "NotChecked");
            if (!_catalog.DiscoverySucceeded) return (_catalog.Message, "Missing");
            var missing = H3Requirements.Required.Count(r => State(r) == H3RequirementState.Missing);
            if (missing > 0) return (missing == 1 ? "1 required file is missing. Presets work once it's in place." : $"{missing} required files are missing. Presets work once they're in place.", "Missing");
            if (!CommonSetupUnchanged) return ("Your file choices changed. Check again to update the presets.", "NotChecked");
            if (!_catalog.StandardReady) return (_catalog.Presets.FirstOrDefault(p => p.Key == "standard")?.Issue ?? _catalog.Message, "Missing");
            var offered = H3Presets.Offered.ToArray(); var waiting = offered.Where(k => PresetState(k).State != H3RequirementState.Installed).Select(H3Presets.Label).ToArray();
            return waiting.Length == 0 ? ("Ready. Every preset can generate.", "Installed")
                : ($"{offered.Length - waiting.Length} of {offered.Length} presets ready. Not set up yet: {string.Join(", ", waiting)}.", "Installed");
        }
    }
    private H3RequirementState State(H3Requirement r) => H3Requirements.Status(r, _draft, _catalog).State;
    private (string Label, H3RequirementState State) PresetState(string key)
    {
        if (!Checked) return ("Not checked", H3RequirementState.NotChecked);
        if (H3Requirements.Required.Any(r => State(r) == H3RequirementState.Missing)) return ("Needs required files", H3RequirementState.Missing);
        var extra = H3Requirements.ForPreset(key).Select(r => H3Requirements.Status(r, _draft, _catalog)).ToArray();
        if (extra.Any(s => s.State == H3RequirementState.Missing && s.Requirement.Kind == H3RequirementKind.NodePack)) return ("Needs node pack", H3RequirementState.Missing);
        if (extra.Any(s => s.State == H3RequirementState.Missing)) return ("Needs file", H3RequirementState.Missing);
        if (!CommonSetupUnchanged || H3Presets.Checkpoint(key, _checked!) != H3Presets.Checkpoint(key, _draft)) return ("Check again", H3RequirementState.NotChecked);
        return _catalog!.Presets.FirstOrDefault(p => p.Key == key)?.Issue is null ? ("Ready", H3RequirementState.Installed) : ("Setup needed", H3RequirementState.Missing);
    }
    private (string Label, H3RequirementState State) UpscaleState => !Checked ? ("Not checked", H3RequirementState.NotChecked) :
        _catalog!.PreviewUpscaling.Issue is null && H3Requirements.UpscaledPreview.All(r => State(r) != H3RequirementState.Missing) ? ("Ready", H3RequirementState.Installed) : ("Not set up", H3RequirementState.NotChecked);
    private (string Label, H3RequirementState State) AttentionState => !Checked ? ("Not checked", H3RequirementState.NotChecked) :
        _catalog!.AttentionIssue is null ? ("Ready", H3RequirementState.Installed) : ("Setup needed", H3RequirementState.Missing);
    private static string StateLabel(H3RequirementStatus s) => s.State switch
    {
        H3RequirementState.Installed => "Installed", H3RequirementState.OtherFile => "Other file",
        H3RequirementState.Missing => s.Requirement.Kind == H3RequirementKind.NodePack ? "Not found" : "Missing", _ => "Not checked"
    };
    private static string PresetSummary(string key) => key switch
    {
        "standard" => "20 steps · the reference recipe", H3Presets.Beta => "Standard with the beta scheduler", H3Presets.EulerBeta => "Euler with the beta scheduler",
        "larry" => "6 steps", "pdd" => "8 steps · dialogue distorted in our small test", "turbo4" => "4 steps · fastest",
        H3HyperFlow.Key => "8 steps · not benchmarked", _ => "Retired"
    };
    private static string Recipe(string key) => key switch
    {
        "standard" => "Twenty steps · res_multistep · simple · BasicGuider.",
        H3Presets.Beta or H3Presets.EulerBeta => $"Twenty steps · {(key == H3Presets.Beta ? "res_multistep" : "euler")} · beta · BasicGuider. Built-in ComfyUI nodes only.",
        "larry" => "Six steps · dedicated Turbo sampler · simple schedule · strength 1 · low-VRAM merging off.",
        "pdd" => "Eight evaluations · supplied sigmas · Euler · shifts 12/3 · strengths 1/1 · strict model and schedule checks.",
        "turbo4" => "Four steps · res_multistep · simple · strength 1.", H3Presets.TurboLight => "Four steps · res_multistep · simple · strength 0.75. Uses the Turbo 4-step LoRA.",
        "turbo8" => "Eight steps · Euler · video shift 12 · audio shift 3 · strength 1.",
        "spectrum" => "Standard 20-step schedule · video blend 0.5 · audio blend 0 · smoothing replay · system-RAM history and replay archive.",
        H3HyperFlow.Key => "Eight Euler evaluations · shifts 12/3 · strength 1 · BasicGuider · full denoising. No automatic scheduler fallback.", _ => ""
    };
    private static RenderFragment Status((string Label, H3RequirementState State) s) => @<span class="video-status" data-state="@s.State">@s.Label</span>;

    private RenderFragment PresetRow(string key)
    {
        var state = PresetState(key); var issue = Checked && state.Label == "Setup needed" ? _catalog!.Presets.FirstOrDefault(p => p.Key == key)?.Issue : null;
        return @<details class="video-preset-setup" data-preset="@key">
            <summary><span class="video-row-title">@H3Presets.Label(key)</span><span class="field-hint">@PresetSummary(key)</span>@Status(state)</summary>
            <p>@H3Presets.Help(key)</p>
            @foreach (var requirement in H3Requirements.ForPreset(key)) { @RequirementRow(requirement) }
            @if (H3Requirements.ForPreset(key).Count == 0) { <p class="field-hint">Needs nothing beyond the required files.</p> }
            @if (issue is not null) { <p role="status">@issue</p> }
            <details class="video-recipe"><summary>Recipe details</summary><p class="field-hint">@Recipe(key)</p>
                @if (key == H3HyperFlow.Key) { <p class="field-hint">This is the drbaph ComfyUI conversion with a fixed schedule, not HyperFlow's own loader. Sampler-domain video sigmas, already shifted by 12:</p><code>@H3HyperFlow.VideoSigmas</code> }
            </details>
        </details>;
    }

    private RenderFragment RequirementRow(H3Requirement r)
    {
        var status = H3Requirements.Status(r, _draft, _catalog); var suggested = r.Downloads[0];
        var isFile = r.Kind == H3RequirementKind.File;
        IReadOnlyList<string> installed = _catalog is null ? [] : H3Requirements.Installed(r, _catalog);
        IReadOnlyList<string> recognized = _catalog is null ? [] : H3Requirements.Recognized(r, _catalog);
        var suggestedFiles = installed.Where(f => H3Requirements.Suggested(r, f)).ToArray();
        var h3Files = installed.Where(f => !suggestedFiles.Contains(f) && recognized.Contains(f)).ToArray();
        var otherFiles = installed.Where(f => !suggestedFiles.Contains(f) && !h3Files.Contains(f)).ToArray();
        // Several downloads are alternatives: one of them is enough.
        var downloads = r.Downloads.Count > 1 ? $"{(isFile ? "Download" : "Install")} one of these ({r.Downloads.Count})" : isFile ? "Download link" : "Where to get it";
        return @<div class="video-requirement" data-requirement="@r.Id" data-state="@status.State">
            <span class="video-requirement-label">@r.Label</span>
            <div class="video-requirement-body">
                @if (isFile && Checked)
                {
                    <select class="video-requirement-select" aria-label="@(r.Label + " file")" value="@status.Selected" @onchange="e => Choose(r, e.Value?.ToString() ?? string.Empty)" disabled="@(_busy || Busy)">
                        @if (!installed.Contains(status.Selected ?? string.Empty)) { <option value="@status.Selected">@(string.IsNullOrEmpty(status.Selected) ? "Choose an installed file…" : status.Selected + " (not installed)")</option> }
                        @foreach (var (label, files) in new[] { ("Suggested", suggestedFiles), ("Other H3 files", h3Files), (h3Files.Length > 0 ? "Everything else installed" : "Other installed files", otherFiles) })
                        {
                            if (files.Length > 0) { <optgroup label="@label">@foreach (var option in files) { <option value="@option">@option</option> }</optgroup> }
                        }
                    </select>
                }
                else { <div class="video-requirement-file">@(isFile && !string.IsNullOrEmpty(status.Selected) ? status.Selected : suggested.Name)</div> }
                <p class="field-hint video-requirement-hint">@switch (status.State)
                {
                    case H3RequirementState.Installed when isFile: <span>Found in <code>@r.Folder</code>.</span> break;
                    case H3RequirementState.Installed: <span>Installed in <code>custom_nodes</code>.</span> break;
                    case H3RequirementState.OtherFile: <span>Found in <code>@r.Folder</code>. It isn't one of the suggested files, so it works only if it's a compatible H3 file.</span> break;
                    case H3RequirementState.Missing when isFile && installed.Count > 0: <span>Not found in <code>@r.Folder</code>. Download a supported file and put it there, or choose another installed file above. Then check again.</span> break;
                    case H3RequirementState.Missing when isFile: <span>Not found in <code>@r.Folder</code>. Download a supported file, put it there, then check again.</span> break;
                    case H3RequirementState.Missing: <span>Not found. Install it into <code>custom_nodes</code>, restart ComfyUI, then check again.</span> break;
                    default: <span>Goes in <code>@r.Folder</code>.</span> break;
                }</p>
                <details class="video-requirement-options" open="@(status.State == H3RequirementState.Missing)"><summary>@downloads</summary><ul>
                    @foreach (var download in r.Downloads)
                    {
                        <li><a href="@download.Url" target="_blank" rel="noopener">@download.Name</a>
                            <span class="video-badges">
                                @Badge(download.Publisher, $"Published by {download.Publisher} on {download.Site}.", "source")
                                @if (download.Size is { } size) { @Badge(size, "Download size.", "size") }
                                @if (download.Format is { } format) { @Badge(format, H3Requirements.FormatHint(format), "format") }
                                @if (H3Requirements.GpuFit(r, download) is { } fit) { @Badge(fit.Label, fit.Hint, "gpu") }
                                @foreach (var tag in download.Tags) { @Badge(tag.Label, tag.Hint, "tag") }
                            </span>
                            @if (download.Note is not null) { <span class="field-hint video-download-note">@download.Note</span> }
                        </li>
                    }
                </ul></details>
            </div>
            <span class="video-status" data-state="@status.State">@StateLabel(status)</span>
        </div>;
    }
    // Focusable so the explanation also shows on keyboard focus and tap, and is read out after the label.
    private static RenderFragment Badge(string label, string hint, string kind) =>
        @<span class="video-badge" data-kind="@kind" data-hint="@hint" tabindex="0">@label<span class="sr-only">: @hint</span></span>;
    private void Choose(H3Requirement r, string value) => H3Requirements.Select(r, _draft, value);

    private async Task Refresh()
    {
        _busy = true; _error = null;
        try { _catalog = await Generator.CheckAsync(Settings with { H3 = ShotCopy.Of(_draft) }); _checked = ShotCopy.Of(_draft); _checkedAt = DateTime.Now; _message = null; }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        _error = null;
        try
        {
            var section = Section; var settings = ShotCopy.Of(Settings.H3);
            Copy(section, ShotCopy.Of(_draft), settings); H3Policy.ValidateSettings(settings);
            if (!await SaveSettings(settings)) return;
            if (section == H3Section) await Refresh();
            _message = char.ToUpperInvariant(SectionName[0]) + SectionName[1..] + " saved.";
        }
        catch (Exception e) { _error = e.Message; }
    }
    private void Cancel() { Copy(Section, ShotCopy.Of(Settings.H3), _draft); _error = null; _message = null; }
    private static void Copy(string section, H3Settings from, H3Settings to)
    {
        if (section == H3Section)
        {
            to.Model = from.Model; to.Encoder = from.Encoder; to.VideoVae = from.VideoVae; to.AudioVae = from.AudioVae; to.Performance = from.Performance;
            to.LarryLora = from.LarryLora; to.PddCheckpoint = from.PddCheckpoint; to.HyperFlowLora = from.HyperFlowLora; to.TurboLora = from.TurboLora;
            to.Turbo8StepLora = from.Turbo8StepLora; to.LatentUpscaler = from.LatentUpscaler;
        }
        else { to.TimeoutSeconds = from.TimeoutSeconds; to.Ffmpeg = from.Ffmpeg; to.Ffprobe = from.Ffprobe; }
    }
}
