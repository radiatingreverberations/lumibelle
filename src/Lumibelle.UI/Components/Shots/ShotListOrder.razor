@implements IAsyncDisposable
@inject IJSRuntime JS
@* Wraps the shot list so rows can be dragged by their [data-shot-drag] handle within their scene. *@
<div class="shot-list" @ref="_element">@ChildContent</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ShotMove> Moved { get; set; }
    public sealed record ShotMove(Guid Id, Guid Target, bool After);
    private ElementReference _element;
    private DotNetObjectReference<ShotListOrder>? _reference;
    private IJSObjectReference? _module, _drag;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("shot-list-order.js"));
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        _drag = await _module.InvokeAsync<IJSObjectReference>("attach", _element, _reference);
        if (_disposed) { await _drag.InvokeVoidAsync("dispose"); await _drag.DisposeAsync(); }
    }
    [JSInvokable] public Task Move(string id, string target, bool after) => Disabled ? Task.CompletedTask : Moved.InvokeAsync(new(Guid.Parse(id), Guid.Parse(target), after));
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_drag is not null) { await _drag.InvokeVoidAsync("dispose"); await _drag.DisposeAsync(); } if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
