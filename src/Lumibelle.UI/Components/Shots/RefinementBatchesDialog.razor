@inherits ProjectAwareComponent
@using lumibelle.Services.Production
@using lumibelle.Services.Shots
@using lumibelle.Components.AI
@inject RefinementBatchWorkflow Batches
@inject AiJobCoordinator Jobs
@inject IShotStore Shots
@inject IAssetStore AssetStore
@implements IAsyncDisposable

<InlineDialog Visible="Visible" VisibleChanged="VisibleChanged" Options="DialogSizes.Large" Class="refinement-batches-dialog"
              Title="Refinement batches" CloseLabel="Close refinement batches">
    <TitleContent>
        <DialogHeader Title="Refinement batches" CloseLabel="Close refinement batches" Close="Close" />
        <div class="refinement-tabs" role="tablist" aria-label="Refinement batches">
            <button role="tab" id="batches-active" aria-controls="batch-list" aria-selected="@(!_history ? "true" : "false")" @onclick="() => SelectTab(false)">Active <span class="count-badge">@(_doc?.Runs.Count(r => r.Active) ?? 0)</span></button>
            <button role="tab" id="batches-history" aria-controls="batch-list" aria-selected="@(_history ? "true" : "false")" @onclick="() => SelectTab(true)">History <span class="count-badge">@(_doc?.Runs.Count(r => !r.Active) ?? 0)</span></button>
        </div>
    </TitleContent>
    <DialogContent>
    <lumibelle.Components.AI.AiResultAcknowledgement Observed="SeenJobs" />
    <div class="refinement-studio">
        @if (_error is not null) { <p role="alert">@_error</p> }
        @if (_doc is { Runs.Count: 0 }) { <p role="status">No refinement batches yet. Select takes or reels, then choose Refine selected…</p> }
        else if (!Ordered.Any()) { <p role="status">@(_history ? "No finished batches yet." : "No active batches.")</p> }
        <div id="batch-list" role="tabpanel" aria-labelledby="@(_history ? "batches-history" : "batches-active")">
        @foreach (var run in Ordered)
        {
            var views = RefinementBatchWorkflow.View(run, Jobs.View.Jobs); var counts = RefinementBatchWorkflow.Count(views);
            var current = views.FirstOrDefault(v => v.Item.State == RefinementItemState.Submitted && v.Stage is RefinementItemStage.Waiting or RefinementItemStage.Generating);
            <section @key="run.Id" class="refinement-batch @(run.Id == RequestedBatchId ? "is-requested" : null)" data-batch-id="@run.Id" aria-labelledby="batch-@run.Id">
                <button class="refinement-batch-summary" aria-expanded="@(run.Id == ExpandedBatchId ? "true" : "false")" @onclick="() => OpenBatch(run)">
                    <strong id="batch-@run.Id">@run.Name</strong><span class="refinement-state">@StateLabel(run)</span><time>@run.CreatedUtc.ToLocalTime().ToString("g")</time>
                    <span>@counts.Total @(counts.Total == 1 ? "clip" : "clips") · @counts.Completed completed</span>
                    @if (views.Count(v => v.Stage == RefinementItemStage.Cancelled) is > 0 and var cancelled) { <span>@cancelled cancelled</span> }
                    @if (counts.Failed > 0) { <span class="refinement-error">@counts.Failed @(counts.Failed == 1 ? "needs" : "need") attention</span> }
                    @if (views.Count(v => v.Stage == RefinementItemStage.Completed && v.Job?.Unread == true) is > 0 and var unread) { <span class="refinement-state">@unread new</span> }
                    <MudIcon Icon="@(run.Id == ExpandedBatchId ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" aria-hidden="true" />
                </button>
                @if (run.Id == ExpandedBatchId) {
                <header class="refinement-batch-heading">
                    <dl class="refinement-counts" aria-label="Batch progress">
                        <div><dt>Completed</dt><dd>@counts.Completed</dd></div><div><dt>Failed</dt><dd>@counts.Failed</dd></div>
                        <div><dt>Waiting</dt><dd>@counts.Waiting</dd></div><div><dt>Reviewed</dt><dd>@counts.Reviewed / @counts.Total</dd></div>
                    </dl>
                    <div class="refinement-controls" role="group" aria-label="Batch controls">
                        @if (run.State is RefinementBatchState.Held or RefinementBatchState.Paused || run.PauseRequested) { <button disabled="@_busy" @onclick="() => Command(() => Batches.StartAsync(ProjectId, run.Id, _lifetime.Token))">@(run.State == RefinementBatchState.Held ? "Start batch" : "Resume batch")</button> }
                        @if (run.State == RefinementBatchState.Running && !run.PauseRequested) { <button disabled="@_busy" @onclick="() => Command(() => Batches.PauseAsync(ProjectId, run.Id, _lifetime.Token))">Pause after current clip</button> }
                        @if (current is not null || run.Items.Any(i => i.State is RefinementItemState.Preparing or RefinementItemState.Ready)) { <button disabled="@_busy" title="Stop the current render and cancel waiting clips" @onclick="() => CancelBatch(run.Id)">Cancel batch</button> }
                        @if (run.Items.Any(i => i.State is RefinementItemState.Preparing or RefinementItemState.Ready)) { <button disabled="@_busy" @onclick="() => Command(() => Batches.CancelWaitingAsync(ProjectId, run.Id, _lifetime.Token))">Cancel waiting clips</button> }
                        @if (current is not null) { <button disabled="@_busy" @onclick="() => Command(() => Batches.CancelCurrentAsync(ProjectId, run.Id, _lifetime.Token))">Cancel current render</button> }
                        @if (views.Count(v => v.Stage is RefinementItemStage.Failed or RefinementItemStage.NeedsAttention && v.Job?.RemoteUnconfirmed != true) is > 0 and var failed) {
                            <button disabled="@_busy" title="Retries them together, so they render in batch order." @onclick="() => Command(() => Batches.RetryFailedAsync(ProjectId, run.Id, _lifetime.Token))">@(failed == 1 ? "Retry failed clip" : $"Retry {failed} failed clips")</button>
                        }
                    </div>
                    @if (run.PauseRequested) { <p class="field-hint" role="status">Pausing after the current clip.</p> }
                    @if (current?.Job is { } job) {
                        @if (run.UseRefinedFrames) { <p class="field-hint">Clips that reference another clip here wait for its refined take and use the same moment from it.</p> }
                        <div class="refinement-current"><strong>@current.Item.Name</strong><AiJobProgressView Job="job" Queue="Jobs.View" Progress="Jobs.Progress(job.Id)" /><AiJobPriorityAction Job="job" /></div>
                    }
                </header>
                <ul class="refinement-items">
                    @foreach (var view in views)
                    {
                        var item = view.Item; var final = FinalUrl(item);
                        <li @key="item.Id" class="refinement-item" data-item-id="@item.Id" data-stage="@view.Stage">
                            <div class="refinement-item-summary">
                                <img src="@ReferenceVideos.ThumbnailUrl(ProjectId, item.Options.Draft.Source.Media.Id)" alt="" loading="lazy" />
                                <div class="refinement-item-text">
                                    <strong>@item.Name</strong>
                                    <span class="refinement-stage stage-@view.Stage.ToString().ToLowerInvariant()">@StageLabel(view.Stage)</span>
                                    <span class="refinement-facts">@H3Presets.Label(item.Options.GenerationPreset) · @VideoResolutions.Label(item.Options.Resolution) · @(item.Kind == RefinementSourceKind.Take ? "Take" : "Reel")@(item.AcceptedUtc is not null ? " · Accepted" : item.ReviewedUtc is not null ? " · Reviewed" : "")</span>
                                    @if (item.Notice is not null && view.Stage is RefinementItemStage.Preparing or RefinementItemStage.Ready or RefinementItemStage.Waiting) { <span class="field-hint" role="status">@item.Notice</span> }
                                    @foreach (var adjustment in item.Adjustments) { <span class="field-hint">@adjustment</span> }
                                    @if ((item.Error ?? (view.Stage == RefinementItemStage.NeedsAttention ? view.Job?.Error ?? "The generation request is no longer in the queue." : null)) is { } problem) { <span class="refinement-error" role="alert">@problem</span> }
                                </div>
                                <div class="refinement-item-actions">
                                    @if (final is not null) {
                                        <button aria-expanded="@(_comparing.Contains(item.Id) ? "true" : "false")" @onclick="() => ToggleCompare(item.Id)">@(_comparing.Contains(item.Id) ? "Hide comparison" : "Compare")</button>
                                        @* Opening a result leaves this dialog for the take or reel. *@
                                        <a href="@ResultLink(item)" @onclick="Close">@(item.Kind == RefinementSourceKind.Take ? "Open take" : "Open reel")</a>
                                        @if (item.Kind == RefinementSourceKind.Reel && ResultReel(item) is { } reel) { <a href="@ProjectLink(ProjectId, $"/assets?assetId={reel.AssetId}&reelId={reel.Id}")" @onclick="Close">Choose keyframes</a> }
                                        @if (item.AcceptedUtc is null) { <button disabled="@_busy" @onclick="() => Decide(item.Id, () => Batches.AcceptAsync(ProjectId, run.Id, item.Id, _lifetime.Token))">@(item.Kind == RefinementSourceKind.Take ? "Use this take" : "Prefer this reel")</button> }
                                        @if (item.AcceptedUtc is null) { <button disabled="@_busy" aria-pressed="@(item.ReviewedUtc is not null ? "true" : "false")" @onclick="() => item.ReviewedUtc is null ? Decide(item.Id, () => Batches.MarkReviewedAsync(ProjectId, run.Id, item.Id, true, _lifetime.Token)) : Command(() => Batches.MarkReviewedAsync(ProjectId, run.Id, item.Id, false, _lifetime.Token))">@(item.ReviewedUtc is null ? "Mark reviewed" : "Reviewed")</button> }
                                    }
                                    @if (view.Stage is RefinementItemStage.Failed or RefinementItemStage.Cancelled or RefinementItemStage.NeedsAttention && view.Job?.RemoteUnconfirmed != true) { <button disabled="@_busy" @onclick="() => Command(() => Batches.RetryAsync(ProjectId, run.Id, item.Id, _lifetime.Token))">Retry</button> }
                                    @if (view.Stage is not (RefinementItemStage.Preparing or RefinementItemStage.Generating)) { <button disabled="@_busy" title="Change resolution, prompt or instructions. Creates a new request with a new seed." @onclick="() => _revise = item">New request…</button> }
                                </div>
                            </div>
                            @if (item.AcceptedUtc is not null && item.Kind == RefinementSourceKind.Reel) { <p class="field-hint">Preferred for new use. Shots keep the source reel until you use Replace in shots… on it.</p> }
                            @if (final is not null && _comparing.Contains(item.Id)) { <RefinementComparison Name="@item.Name" SourceUrl="@ReferenceVideos.Url(ProjectId, item.Options.Draft.Source.Media.Id)" FinalUrl="@final" /> }
                        </li>
                    }
                </ul>
                }
            </section>
        }
        </div>
    </div>
</DialogContent><Actions><MudButton OnClick="Close">Close</MudButton></Actions></InlineDialog>
<RefineFromVideoDialog ProjectId="ProjectId" Revise="_revise" Closed="() => _revise = null" Queued="Queued" />

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    // Highlighted when opened from a batch's "View batch" notice.
    [Parameter] public Guid? RequestedBatchId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly HashSet<Guid> _comparing = [];
    private RefinementBatches? _doc;
    private ShotDocument? _shots;
    private AssetLibrary? _library;
    private RefinementBatchItem? _revise;
    private string? _error;
    private bool _busy, _disposed, _refreshing, _refreshAgain, _shown;
    private bool _history, _selectOnLoad;
    private Guid? _activeExpanded, _historyExpanded, _lastRequested;
    private Guid? ExpandedBatchId
    {
        get => _history ? _historyExpanded : _activeExpanded;
        set { if (_history) _historyExpanded = value; else _activeExpanded = value; }
    }
    private int _loads;
    // Completed clips are seen once the open dialog shows them, which clears the new marks on Batches and Takes.
    private AiJobHeader[] SeenJobs => Ordered.Where(r => _shown && r.Id == ExpandedBatchId).SelectMany(r => RefinementBatchWorkflow.View(r, Jobs.View.Jobs))
        .Where(v => v.Stage == RefinementItemStage.Completed && v.Job is { Unread: true }).Select(v => v.Job!).ToArray();
    private IEnumerable<RefinementBatch> Ordered => _doc is null ? [] : _doc.Runs.Where(r => r.Active != _history).OrderByDescending(r => r.CreatedUtc);

    protected override void OnInitialized() { Batches.Changed += BatchesChanged; Jobs.Changed += Refresh; }
    // Pages keep it mounted after the first opening, since removing an open MudDialog leaves it on screen.
    // It loads on each opening and follows progress only while open.
    protected override async Task OnParametersSetAsync()
    {
        if (Visible == _shown && RequestedBatchId == _lastRequested) return;
        _shown = Visible;
        _lastRequested = RequestedBatchId;
        if (!Visible) return;
        _selectOnLoad = true;
        try { await Load(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception e) { _error = e.Message; }
    }
    private async Task Load()
    {
        // Only the newest load is shown; an older one that finishes later must not undo a command's result.
        var load = ++_loads;
        var doc = await Batches.LoadAsync(ProjectId, _lifetime.Token);
        if (_disposed || load != _loads) return;
        if (_selectOnLoad) {
            _activeExpanded = _historyExpanded = null;
            var requested = doc.Runs.FirstOrDefault(r => r.Id == RequestedBatchId);
            _history = requested is not null ? !requested.Active : !doc.Runs.Any(r => r.Active);
            ExpandedBatchId = requested?.Id ?? (_history ? null : doc.Runs.Where(r => r.Active).OrderByDescending(r => r.CreatedUtc).FirstOrDefault()?.Id);
            _selectOnLoad = false;
        }
        else if (doc.Runs.FirstOrDefault(r => r.Id == ExpandedBatchId) is { } opened && _history == opened.Active) {
            ExpandedBatchId = null;
            _history = !opened.Active;
            ExpandedBatchId = opened.Id;
        }
        _activeExpanded = doc.Runs.FirstOrDefault(r => r.Id == _activeExpanded && r.Active)?.Id;
        _historyExpanded = doc.Runs.FirstOrDefault(r => r.Id == _historyExpanded && !r.Active)?.Id;
        var items = doc.Runs.Where(r => r.Id == ExpandedBatchId).SelectMany(r => r.Items).ToArray();
        var shots = items.Any(i => i.Kind == RefinementSourceKind.Take && i.ResultId is not null) ? await Shots.LoadAsync(ProjectId, _lifetime.Token) : null;
        var library = items.Any(i => i.Kind == RefinementSourceKind.Reel && i.ResultId is not null) ? await AssetStore.LoadAsync(ProjectId, _lifetime.Token) : null;
        if (_disposed || load != _loads) return;
        _doc = doc; _shots = shots; _library = library;
    }
    private Task SelectTab(bool history) => Command(() => {
        _history = history; _comparing.Clear(); return Task.CompletedTask;
    });
    private Task OpenBatch(RefinementBatch run) => Command(() => {
        ExpandedBatchId = ExpandedBatchId == run.Id ? null : run.Id; _comparing.Clear(); return Task.CompletedTask;
    });
    private void BatchesChanged(Guid project) { if (project == ProjectId) Refresh(); }
    private void Refresh()
    {
        if (_disposed || !_shown) return;
        // Job progress fires often while rendering: events that arrive during a load collapse into one more.
        _ = InvokeAsync(async () => {
            if (_refreshing) { _refreshAgain = true; return; }
            _refreshing = true;
            try {
                do {
                    _refreshAgain = false;
                    try { await Load(); } catch (Exception e) when (e is not OperationCanceledException) { _error = e.Message; }
                } while (_refreshAgain && !_disposed);
            }
            finally { _refreshing = false; }
            if (!_disposed) StateHasChanged();
        });
    }
    private async Task Command(Func<Task> action)
    {
        if (_busy || _disposed) return;
        _busy = true; _error = null;
        try { await action(); await Load(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
    private Task Close() => VisibleChanged.InvokeAsync(false);
    private Task CancelBatch(Guid batch) => Command(async () =>
    {
        var ct = _lifetime.Token;
        // Cancel waiting clips first so stopping the current render cannot start the next one.
        await Batches.CancelWaitingAsync(ProjectId, batch, ct);
        await Batches.CancelCurrentAsync(ProjectId, batch, ct);
    });
    // Accepting or reviewing a clip finishes looking at it, so its comparison closes.
    private Task Decide(Guid item, Func<Task> action) => Command(async () => { await action(); _comparing.Remove(item); });
    private Task Queued(RefinementBatch batch) { _revise = null; return Load(); }
    private void ToggleCompare(Guid item) { if (!_comparing.Remove(item)) _comparing.Add(item); }
    private ShotTake? ResultTake(RefinementBatchItem item) => item.Kind == RefinementSourceKind.Take ? _shots?.Takes.FirstOrDefault(t => t.Id == item.ResultId) : null;
    private AssetReferenceReel? ResultReel(RefinementBatchItem item) => item.Kind == RefinementSourceKind.Reel ? _library?.Reels.FirstOrDefault(r => r.Id == item.ResultId) : null;
    private string? FinalUrl(RefinementBatchItem item) => ResultTake(item) is { } take ? $"/media/projects/{ProjectId}/takes/{take.Id}"
        : ResultReel(item) is { } reel ? ReferenceVideos.Url(ProjectId, reel.Media.Id) : null;
    private string ResultLink(RefinementBatchItem item) => ResultTake(item) is { } take ? ProjectLink(ProjectId, $"/shots?shotId={take.ShotId}&view=Takes")
        : ResultReel(item) is { } reel ? ProjectLink(ProjectId, $"/assets?assetId={reel.AssetId}&view=reels") : ProjectLink(ProjectId, "/shots");
    private static string StateLabel(RefinementBatch run) => run.State switch {
        RefinementBatchState.Held => "Held · start when convenient",
        RefinementBatchState.Running => run.PauseRequested ? "Pausing" : "Running",
        RefinementBatchState.Paused => "Paused",
        _ => "Finished"
    };
    private static string StageLabel(RefinementItemStage stage) => stage switch {
        RefinementItemStage.Preparing => "Preparing media",
        RefinementItemStage.NeedsAttention => "Needs attention",
        RefinementItemStage.Failed => "Preparation failed",
        _ => stage.ToString()
    };
    public async ValueTask DisposeAsync() { _disposed = true; Batches.Changed -= BatchesChanged; Jobs.Changed -= Refresh; await _lifetime.CancelAsync(); _lifetime.Dispose(); }
}
