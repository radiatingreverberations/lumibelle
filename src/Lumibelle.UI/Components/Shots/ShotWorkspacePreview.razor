@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="shot-workspace-preview" aria-label="Shot preview" @ref="_element">
    @if (Preview is { } take)
    {
        @* The caption heads the preview as the Action and camera label heads the direction, so the video and the text line up beside it. *@
        <div class="shot-preview-caption">
            <span><strong>Take @(Takes.ToList().FindIndex(t => t.Id == take.Id) + 1)</strong><small>@(take.Id == SelectedTakeId ? "Selected take" : "Preview only") · @TakeDisplay.Badge(take)</small></span>
            <div class="shot-preview-actions"><button type="button" aria-label="Previous take preview" disabled="@(PreviewIndex <= 0)" @onclick="() => Step(-1)">‹</button><button type="button" aria-label="Next take preview" disabled="@(PreviewIndex >= Takes.Count - 1)" @onclick="() => Step(1)">›</button><button type="button" @onclick="() => Review.InvokeAsync(take)">Review take</button></div>
            @if (_failed) { <p role="alert">This preview could not load. Open Review take to inspect the saved media.</p> }
        </div>
        <video @key="take.Id" controls playsinline preload="none" src="@Url(take)" poster="@(Url(take) + "/frames/0")" aria-label="Shot take preview" @onerror="() => _failed = true"></video>
    }
    else
    {
        <div class="shot-preview-empty"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="10" width="38" height="28" rx="4" /><path d="m20 18 11 6-11 6z" /></svg><strong>Your shot starts here</strong><span>Write the direction, choose references, then generate a take.</span></div>
    }
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ShotId { get; set; }
    [Parameter] public Guid? SelectedTakeId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ShotTake> Takes { get; set; } = [];
    [Parameter] public EventCallback<ShotTake> Review { get; set; }
    private Guid? _shotId, _previewId;
    private bool _failed, _disposed;
    private ElementReference _element;
    private IJSObjectReference? _module, _preview;
    private ShotTake? Preview => Takes.FirstOrDefault(t => t.Id == _previewId);
    private int PreviewIndex => Takes.ToList().FindIndex(t => t.Id == _previewId);
    private string Url(ShotTake take) => $"/media/projects/{ProjectId}/takes/{take.Id}";
    protected override void OnParametersSet()
    {
        if (_shotId != ShotId) { _shotId = ShotId; _previewId = null; _failed = false; }
        if (Preview is null) {
            _previewId = (Takes.FirstOrDefault(t => t.Id == SelectedTakeId) ?? Takes.LastOrDefault(t => t.Snapshot.Dub is null) ?? Takes.LastOrDefault())?.Id;
            _failed = false;
        }
    }
    private void Step(int direction)
    {
        var index = PreviewIndex + direction;
        if (index < 0 || index >= Takes.Count) return;
        _previewId = Takes[index].Id; _failed = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("shot-workspace-preview.js"));
            if (_disposed) { await _module.DisposeAsync(); return; }
            _preview = await _module.InvokeAsync<IJSObjectReference>("attach", _element);
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try {
            if (_preview is not null) { await _preview.InvokeVoidAsync("dispose"); await _preview.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException) { }
    }
}
