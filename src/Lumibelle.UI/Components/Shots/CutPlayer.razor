@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="cut-player" @ref="_element" aria-label="Cut preview">
    @if (_loadError is not null) { <p role="alert">@_loadError</p> }
    <div class="cut-player-stage">
        @if (Clips.Count == 0) { <div class="cut-player-empty"><h2>Assemble your cut</h2><p>No clips yet. Choose saved takes from your shots, then trim and arrange them here.</p><button type="button" class="lumi-button primary" @onclick="ChooseTakes">Choose takes…</button></div> }
        <video playsinline preload="metadata" aria-label="Cut playback" hidden></video>
        <video playsinline preload="metadata" aria-hidden="true" hidden></video>
        <img class="cut-paused-frame" alt="" hidden />
        <span class="cut-buffering" role="status" hidden>Buffering…</span>
    </div>
    <div class="cut-transport">
        <button type="button" data-action="play" disabled="@(!CanPlay)">Play</button>
        <button type="button" data-action="beginning" disabled="@(!CanPlay)">Play from beginning</button>
        <button type="button" data-action="previous" disabled="@(Clips.Count == 0)" aria-label="Previous frame" title="Previous frame"><MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" /></button>
        <button type="button" data-action="next" disabled="@(Clips.Count == 0)" aria-label="Next frame" title="Next frame"><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" /></button>
        <output data-position aria-label="Cut position">0:00</output>
        <button type="button" data-action="mute" disabled="@(Clips.Count == 0)" aria-pressed="false">Mute</button>
        <label>Volume<input type="range" data-action="volume" disabled="@(Clips.Count == 0)" min="0" max="1" step="0.05" value="1" /></label>
        <button type="button" data-action="fullscreen" disabled="@(Clips.Count == 0)">Fullscreen</button>
    </div>
    <div class="cut-frame-tools" aria-label="Trim at preview frame" hidden>
        <div class="cut-frame-actions">
            <button type="button" data-action="preview-selected" disabled>Preview selected clip</button>
            <button type="button" data-action="return-cut" hidden>Return to cut</button>
            <span data-trim-target>Pause on a frame to set trim points.</span>
            <span class="cut-mark-actions">
                <button type="button" data-action="mark-start" title="Keep the visible frame as the first frame." disabled>Start here</button>
                <button type="button" data-action="mark-end" title="Keep the visible frame as the last frame." disabled>End here</button>
            </span>
        </div>
        <div class="cut-source-review" data-source-review hidden>
            <label>Source frame<input type="range" data-action="source-frame" min="1" max="1" step="1" value="1" /></label>
            <output data-source-position aria-label="Source frame position"></output>
            <small>Review the full take, including trimmed frames. Use ‹ / › for one frame at a time. Play returns to the cut.</small>
        </div>
        <span data-mark-error role="alert" hidden></span>
    </div>
    <div class="cut-player-messages"><span data-message role="status"></span><span data-error role="alert" hidden></span>
        <button type="button" data-action="retry-frame" hidden>Retry frame</button>
    </div>
    <CutTimeline />
</section>

@code {
    [Parameter] public EventCallback ChooseTakes { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<CutClip> Clips { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public int Version { get; set; }
    [Parameter] public int PreviewSelection { get; set; }
    [Parameter] public IReadOnlyList<Guid> Unavailable { get; set; } = [];
    [Parameter] public EventCallback<Guid> SelectionChanged { get; set; }
    [Parameter] public EventCallback<CutTrimEdit> Trimmed { get; set; }
    [Parameter] public EventCallback<CutOrderEdit> Reordered { get; set; }
    private bool CanPlay => Clips.Count > 0 && Unavailable.Count == 0;
    private ElementReference _element;
    private IJSObjectReference? _module, _player;
    private DotNetObjectReference<CutPlayer>? _reference;
    private bool _disposed, _initializing;
    private string? _loadError, _sent;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _initializing || _loadError is not null) return;
        try
        {
            if (_player is null)
            {
                _initializing = true;
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("cut-player.js"));
                if (_disposed) { await _module.DisposeAsync(); return; }
                _reference ??= DotNetObjectReference.Create(this);
                _player = await _module.InvokeAsync<IJSObjectReference>("attach", _element, _reference, ProjectId);
                if (_disposed) { await _player.InvokeVoidAsync("dispose"); return; }
            }
            var signature = System.Text.Json.JsonSerializer.Serialize(new { Clips, SelectedId, Version, Unavailable, PreviewSelection });
            if (_sent != signature) { _sent = signature; await _player.InvokeVoidAsync("update", Clips, SelectedId, Version, Unavailable, PreviewSelection); }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { _loadError = "The preview player could not load. Reload the page to retry."; if (!_disposed) StateHasChanged(); }
        finally { _initializing = false; }
    }
    [JSInvokable] public Task SelectClip(string id) => !_disposed && Guid.TryParse(id, out var clip) ? SelectionChanged.InvokeAsync(clip) : Task.CompletedTask;
    [JSInvokable] public Task TrimClip(Guid id, int start, int end, int version) => !_disposed ? Trimmed.InvokeAsync(new(id, start, end, version)) : Task.CompletedTask;
    [JSInvokable] public Task ReorderClip(Guid id, Guid? before, int version) => !_disposed ? Reordered.InvokeAsync(new(id, before, version)) : Task.CompletedTask;
    public async Task PauseAsync() { if (_player is not null && !_disposed) await _player.InvokeVoidAsync("pause"); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_player is not null) { await _player.InvokeVoidAsync("dispose"); await _player.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException) { }
        _reference?.Dispose();
    }
}
