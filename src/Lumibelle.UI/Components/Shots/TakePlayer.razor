@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="take-player" @ref="_element" aria-label="Take player" @onkeydown="KeyDown">
    <div class="take-player-stage" style="aspect-ratio:@Take.Width / @Take.Height">
        <video data-ai-candidate="@Take.Id" playsinline preload="metadata" src="@VideoUrl" aria-label="Generated take"></video>
        <img class="take-paused-frame" alt="@(Take.HasLosslessFrames ? "Lossless frame" : "MP4 frame") @(_index + 1) of @Take.FrameCount" hidden />
    </div>
    <div class="take-transport">
        <button type="button" data-action="play" aria-label="@(_playing ? "Pause" : "Play")">@(_playing ? "Pause" : "Play")</button>
        <button type="button" data-action="previous" aria-label="Previous frame">‹</button>
        <input data-action="seek" type="range" min="0" max="@(Take.FrameCount - 1)" value="0" step="1" aria-label="Video position" />
        <button type="button" data-action="next" aria-label="Next frame">›</button>
        <button type="button" data-action="mute" aria-label="Mute audio" aria-pressed="false">Sound</button>
        <label class="take-volume">Volume<input data-action="volume" type="range" min="0" max="1" step="0.05" value="1" /></label>
        <button type="button" data-action="fullscreen">Fullscreen</button>
    </div>
    @if (!Take.HasLosslessFrames) { <p class="field-hint">Frames are extracted from compressed MP4 video; @(Take.FrameArchiveRemoval is null ? "no lossless archive was saved." : "the lossless archive was removed.")</p> }
    <div class="take-frame-actions">
        <span role="status">@(_playing ? "Playing" : $"Frame {_index + 1} / {Take.FrameCount} · {(_index / Take.Fps):0.000} s")@(!_playing && !_ready && _error is null ? " · Loading frame…" : "")</span>
        <span class="take-frame-buttons">
            @if (ContinueRequested.HasDelegate) { <button type="button" class="take-continue-frame" disabled="@(_saving || (!_playing && !_ready))" title="Add a shot after this one that starts exactly on this frame" @onclick="() => Capture(ContinueRequested)">Continue from this frame</button> }
            @if (ShowSaveFrame) { <button type="button" class="take-save-frame" disabled="@(_saving || (!_playing && !_ready))" @onclick="() => Capture(SaveRequested)">Save frame to Assets</button> }
        </span>
    </div>
    @if (_error is not null) { <p role="alert">@_error <button type="button" @onclick="Retry">Retry frame</button></p> }
</section>

@code {
    [Parameter, EditorRequired] public ShotTake Take { get; set; } = default!;
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback<int> SaveRequested { get; set; }
    [Parameter] public bool ShowSaveFrame { get; set; } = true;
    /// <summary>Receives the paused frame index to start a new shot from; the button shows only when set.</summary>
    [Parameter] public EventCallback<int> ContinueRequested { get; set; }
    [Parameter] public int RangeStart { get; set; }
    [Parameter] public int? RangeEndExclusive { get; set; }
    private (int, int)? _appliedRange;
    public async Task<int> CaptureFrameAsync() => _player is null || _disposed ? -1 : await _player.InvokeAsync<int>("pauseForSave");
    public async Task PauseAsync() { if (_player is not null && !_disposed) await _player.InvokeVoidAsync("pause"); }
    private ElementReference _element;
    private IJSObjectReference? _module, _player;
    private DotNetObjectReference<TakePlayer>? _reference;
    private int _index; private bool _playing, _ready, _saving, _disposed; private string? _error;
    private string VideoUrl => $"/media/projects/{ProjectId}/takes/{Take.Id}";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await InitializePlayer();
        if (_player is not null && _appliedRange != (RangeStart, RangeEndExclusive ?? Take.FrameCount)) {
            _appliedRange = (RangeStart, RangeEndExclusive ?? Take.FrameCount);
            await _player.InvokeVoidAsync("setRange", RangeStart, RangeEndExclusive ?? Take.FrameCount);
        }
    }
    private async Task InitializePlayer()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("take-player.js"));
            if (_disposed) { await _module.DisposeAsync(); return; }
            _reference ??= DotNetObjectReference.Create(this);
            _player = await _module.InvokeAsync<IJSObjectReference>("attach", _element, _reference, VideoUrl, Take.FrameCount, Take.Fps, Take.HasLosslessFrames);
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            _error = "The player could not load. Retry, or reload the page to use the current application version. Your saved take is unchanged.";
            if (!_disposed) StateHasChanged();
        }
    }
    [JSInvokable] public Task PlayerState(int index, bool playing, bool ready, string? error)
    {
        if (_disposed) return Task.CompletedTask;
        _index = index; _playing = playing; _ready = ready; _error = error;
        return InvokeAsync(StateHasChanged);
    }
    // Both frame actions pause on the displayed frame first, so they act on exactly the frame shown.
    private async Task Capture(EventCallback<int> requested)
    {
        if (_player is null || _saving) return;
        _saving = true;
        try { var index = await _player.InvokeAsync<int>("pauseForSave"); if (index >= 0 && !_disposed) await requested.InvokeAsync(index); }
        catch (JSDisconnectedException) { }
        finally { _saving = false; }
    }
    private async Task Retry() { _error = null; if (_player is not null) await _player.InvokeVoidAsync("retry"); else await InitializePlayer(); }
    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (_player is not null && e.Key is "[" or "]") await _player.InvokeVoidAsync("step", e.Key == "[" ? -1 : 1);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_player is not null) { await _player.InvokeVoidAsync("dispose"); await _player.DisposeAsync(); } if (_module is not null) await _module.DisposeAsync(); }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException) { }
        _reference?.Dispose();
    }
}
