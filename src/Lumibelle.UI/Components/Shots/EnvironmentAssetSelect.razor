@inherits ProjectAwareComponent

<section class="environment-asset-select" aria-label="Shot environment">
    <label>Environment<select aria-label="Environment" value="@AssetId" @onchange="Select" disabled="@Disabled">
        <option value="">None</option>
        @if (AssetId is not null && Owner is null) { <option value="@AssetId">Unavailable environment</option> }
        @foreach (var asset in Library.Assets.Where(a => a.Category == AssetCategory.Environment)) { <option value="@asset.Id">@asset.Name</option> }
    </select></label>
    @if (Owner is { } owner) {
        var reels = Library.Reels.Where(r => r.AssetId == owner.Id).ToArray();
        <p>@owner.Images.Count images · @reels.Length reels · @reels.Sum(r => r.Keyframes?.Frames.Count ?? 0) saved views.
            <a href="@ProjectLink(ProjectId, $"/assets?assetId={owner.Id}")">Manage sources</a></p>
        <small>Choose views from this library to attach as shot references.</small>
        @foreach (var reel in reels.Where(r => r.Keyframes?.Frames.Count is not > 0)) {
            <small class="environment-missing">@reel.Name · Needs keyframes <a href="@ProjectLink(ProjectId, $"/assets?assetId={owner.Id}&view=reels&reelId={reel.Id}")">Choose views in Assets</a></small>
        }
    }
    else if (AssetId is not null) { <p role="alert">Restore this environment in Assets or choose another.</p> }
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public AssetLibrary Library { get; set; } = null!;
    [Parameter] public Guid? AssetId { get; set; }
    [Parameter] public EventCallback<Guid?> AssetIdChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private ReferenceAsset? Owner => Library.Assets.FirstOrDefault(a => a.Id == AssetId && a.Category == AssetCategory.Environment);
    private Task Select(ChangeEventArgs e) => AssetIdChanged.InvokeAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
