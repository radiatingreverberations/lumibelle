@inherits ProjectAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IReferenceVideoStore ReelMedia
@inject IAiSettingsStore AiSettings
@inject IServiceProvider ReferenceServices
<section class="manual-references" aria-label="@(ReelAuthoring ? "Reel references" : AllowReels ? "Setup references" : AllowInference ? "Composition image references" : "Shot image references")">
    <ImageReviewFocus Target="@_actionFocus" Handled="() => _actionFocus = null" />
    <ReferencePicker BrowserTitle="@(AllowReels && !ReelAuthoring ? "Add references" : null)" UseCustomBrowser="@(_sourceBrowser != "Assets")" Library="Library" IncludeReels="AllowReels" Disabled="_busy" OnlyKind="@(_replacing is not null ? "Images" : ReelTarget is not null ? "Reels" : null)"
        Maximum="@(ReelTarget is not null ? 0 : _replacing is not null ? 1 : Math.Max(0, 9 - ResolvedReferences.For(_draft).Pictures.Count))" Excluded="Assigned" ImagePicked="Add"
        MaximumReels="@(_replacing is not null ? 0 : ReelTarget is not null ? 1 : 3 - ReferenceVideos.ReelSlotCount(_draft))" ExcludedVideoMedia="@_draft.Videos.Select(v => v.Media.Id).ToArray()" ReferencePicked="PickReference"
        ReelAction="@(ReelTarget is { } target ? $"Replace Video {_draft.Videos.FindIndex(v => v.Id == target) + 1}" : null)"
        ImageAction="@(_replacing is { } imageTarget ? $"Replace Picture {_draft.Images.FindIndex(v => v.Id == imageTarget) + 1}" : null)"
        SelectedCount="@(ResolvedReferences.For(_draft).Pictures.Count + (AllowReels ? ReferenceVideos.ReelSlotCount(_draft) : 0))" @bind-SelectedTab="_selectedTab">
        <BrowserSources>
            @if (AllowReels && !ReelAuthoring) {
                <div class="reference-source-choices" role="group" aria-label="Reference sources">
                    @foreach (var source in new[] { "Assets", "Environment", "Shot frames" }) {
                        @if (source != "Shot frames" || FrameShots.Count > 0) {
                            <button type="button" aria-pressed="@(_sourceBrowser == source ? "true" : "false")" disabled="@_busy" @onclick="() => ChooseSource(source)">@source</button>
                        }
                    }
                </div>
            }
        </BrowserSources>
        <BrowserContent>
    @if (_sourceBrowser == "Environment") {
        <section class="scene-environment-browser" aria-label="Scene environment">
            <label>Environment<select aria-label="Reference environment" value="@EnvironmentChoice" @onchange="ChangeEnvironment" disabled="@_busy">
                @if (SceneEnvironment is { } sceneSetup) { <option value="scene">Scene environment · @(Library.Assets.FirstOrDefault(a => a.Id == sceneSetup.AssetId)?.Name ?? "Unavailable environment")</option> }
                <option value="">None</option>
                @if (_draft.EnvironmentAssetId is { } missing && !Library.Assets.Any(a => a.Id == missing && a.Category == AssetCategory.Environment)) { <option value="@missing">Unavailable environment</option> }
                @foreach (var owner in Library.Assets.Where(a => a.Category == AssetCategory.Environment)) { <option value="@owner.Id">@owner.Name</option> }
            </select></label>
            @if (EffectiveEnvironment?.AssetId is { } environment) {
                <div>
                    <p class="field-hint">@EnvironmentCandidates.Count available · Scene views first · One picture slot per view</p>
                    <div class="environment-view-grid">@foreach (var view in ShownEnvironmentCandidates) {
                        var picked = EnvironmentPictures.Contains(_draft, view);
                        <EnvironmentViewCard @key="view.Id" ProjectId="Library.ProjectId" Candidate="view" Compact="true" Selected="picked" SelectedChanged="v => SelectEnvironmentPicture(view, v)" Disabled="@(_busy || !picked && ResolvedReferences.For(_draft).Pictures.Count >= 9)" />
                    }</div>
                    @if (!_allEnvironmentViews && EnvironmentCandidates.Count > ShownEnvironmentCandidates.Count()) { <MudButton OnClick="() => _allEnvironmentViews = true" Variant="Variant.Outlined" Size="Size.Small">Browse all environment views</MudButton> }
                    @foreach (var reel in Library.Reels.Where(r => r.AssetId == environment && r.Keyframes?.Frames.Count is not > 0)) {
                        <p><a href="@ProjectLink(Library.ProjectId, $"/assets?assetId={environment}&view=reels&reelId={reel.Id}")">@reel.Name · Needs keyframes</a></p>
                    }
                    @if (EnvironmentCandidates.Count == 0) { <p>No saved pictures available. Add stills or save reel keyframes in Assets.</p> }
                </div>
            }

        </section>
    }
            else if (_sourceBrowser == "Shot frames") {
                <ShotFramePicker ProjectId="Library.ProjectId" CurrentShot="Shot" Shots="FrameShots" Takes="FrameTakes" Value="_draft.ContinuityFrame"
                    PictureCount="ResolvedReferences.For(_draft).Pictures.Count" Disabled="_busy" Picked="PickShotFrame" />
            }
        </BrowserContent>
        <Toolbar>
            @if (AssistPicking && AllowReels && AllowInference && !ReelAuthoring)
            {
                <AssetPickAssistant @key="_draft.Id" Shot="_draft" Library="Library" Prompt="@ReferencePrompt"
                    DirectingNotes="@ReferenceDirectingNotes" Disabled="_busy" RequestedJobId="RequestedAssetPickJobId"
                    Staged="StageAssistedReferences" />
            }
            @if (ShowCopyControls && AllowReels && (CopySources.Count > 0 || PreviousCopySource is not null))
            {
                <div class="reference-copy-toolbar">
                    <label><span class="sr-only">Copy references from</span><select aria-label="Copy references from" @bind="_copySource" disabled="@_busy">
                        <option value="">Copy references from…</option>
                        @if (PreviousCopySource is not null) { <option value="previous">Previous shot · @CopyLabel(PreviousCopySource)</option> }
                        @if (CopySourceNumber is null) { @foreach (var source in OtherCopySources) { <option value="@source.Id">@source.Title</option> } }
                        else
                        {
                            @* Nearby shots most often share references, so each side of this shot is listed nearest first. *@
                            @if (OtherCopySources.Where(s => CopySourceNumber(s) < CurrentShotNumber).OrderByDescending(CopySourceNumber).ToArray() is { Length: > 0 } earlier)
                            { <optgroup label="Earlier shots">@foreach (var source in earlier) { <option value="@source.Id">@CopyLabel(source)</option> }</optgroup> }
                            @if (OtherCopySources.Where(s => CopySourceNumber(s) > CurrentShotNumber).OrderBy(CopySourceNumber).ToArray() is { Length: > 0 } later)
                            { <optgroup label="Later shots">@foreach (var source in later) { <option value="@source.Id">@CopyLabel(source)</option> }</optgroup> }
                        }
                    </select></label>
                    <MudButton Variant="Variant.Outlined" aria-label="Copy references" Disabled="@(_busy || string.IsNullOrEmpty(_copySource))" OnClick="() => CopyFromChanged(new ChangeEventArgs { Value = _copySource })">Copy</MudButton>
                    @if (!string.IsNullOrEmpty(_copySource)) { <small>Replaces this draft's references. Apply changes to save.</small> }
                </div>
            }
        </Toolbar>
        <BrowserNotice>
            @if (_replacing is { } replacing && _draft.Images.FirstOrDefault(i => i.Id == replacing) is { } priorImage) { <p class="reference-browser-notice" role="status">Replacing Picture @(_draft.Images.IndexOf(priorImage) + 1): @priorImage.Name. Choose an image below.<button @onclick="() => _replacing = null">Cancel replacement</button></p> }
            else if (ReelTarget is not null) { <p class="reference-browser-notice" role="status">Choose the replacement reel below.<button @onclick="() => { _replacingVideo = null; _swapVideo = null; }">Cancel replacement</button></p> }
            else if (ResolvedReferences.For(_draft).Pictures.Count >= 9) { <p class="reference-browser-notice" role="status">@ResolvedReferences.For(_draft).Pictures.Count/9 pictures. Replace an image, remove a picture, or reduce a reel's keyframes to fit the budget.</p> }
            @if (_selectionNotice is not null) { <p class="reference-selection-notice" role="status">@_selectionNotice</p> }
        </BrowserNotice>
        <SelectionToolbar>
            <div class="reference-section-links" role="group" aria-label="Jump to selected references">
                <button type="button" @onclick="async () => await _imagesHeading.FocusAsync()">Pictures · @ResolvedReferences.For(_draft).Pictures.Count/9</button>
                @if (AllowReels) {
                    <button type="button" @onclick="async () => await _reelsHeading.FocusAsync()">Reels · @ReferenceVideos.ReelSlotCount(_draft)/3</button>
                    @if (!ReelAuthoring) { <button type="button" @onclick="async () => await _voicesHeading.FocusAsync()">Voices</button> }
                }
            </div>
        </SelectionToolbar>
        <Selection>
            <h3 @ref="_imagesHeading" tabindex="-1">Pictures · @ResolvedReferences.For(_draft).Pictures.Count/9</h3>
            <p class="reference-browser-hint">@PictureBreakdown. Picture numbers follow this order.</p>
            @if (_draft.Images.Count == 0 && _draft.ContinuityFrame is null) { <p>Choose images from the library. Their order becomes the Picture numbering in your prompt.</p> }
            <ol class="manual-reference-list">
                @foreach (var binding in _draft.Images)
                {
                    var number = _draft.Images.IndexOf(binding) + 1;
                    <ReferenceSelectionRow @key="binding.Id" data-reference-id="@binding.Id" Label="@($"Picture {number}")"
                        Title="@binding.Name" Name="@($"Picture {number}")" Status="@($"{Role(binding)} · {(binding.Crop is null ? "Full image" : "Cropped")}")"
                        Disabled="_busy" First="@(number == 1)" Last="@(number == _draft.Images.Count)" MoveUp="() => Move(binding, -1)" MoveDown="() => Move(binding, 1)" Remove="() => Remove(binding)">
                        <Thumbnail><CropThumbnail Url="@Url(binding)" Width="@(Image(binding)?.Width ?? 0)" Height="@(Image(binding)?.Height ?? 0)" Crop="binding.Crop" Label="@($"Picture {number}")" Failed="() => _missing.Add(binding.Id)" /></Thumbnail>
                        <Actions>
                            <button type="button" class="reference-crop-button @(binding.Crop is not null ? "is-active" : "")" aria-label="@($"Picture {number}: Crop image")" title="Crop image" aria-haspopup="dialog" disabled="@(_busy || Image(binding) is null || _missing.Contains(binding.Id))" @onclick="() => _cropTarget = binding.Id"><MudIcon Icon="@Icons.Material.Outlined.Crop" Size="Size.Small" aria-hidden="true" /></button>
                        </Actions>
                        <QuickActions>
                            <button type="button" aria-label="@($"Picture {number}: Replace image")" disabled="@_busy" @onclick="() => StartImageReplacement(binding)">Replace</button>
                            <button type="button" class="reference-settings-button @(_expanded == binding.Id ? "is-active" : "")" aria-label="@($"Picture {number}: Reference settings")" aria-expanded="@(_expanded == binding.Id ? "true" : "false")" disabled="@_busy" @onclick="() => _expanded = _expanded == binding.Id ? null : binding.Id">Settings</button>
                        </QuickActions>
                        <ChildContent>
                        @if (Issue(binding) is { } issue) { <p class="reference-issue" role="status">@issue</p> }
                        @if (RestoreTrashedImage is not null && Trashed(binding) is { } trashed) { <p class="reference-trash-restore">In Trash · @trashed.Remaining(Now) <MudButton OnClick="() => Restore(binding, trashed)" Disabled="_busy" Variant="Variant.Outlined" Size="Size.Small">Restore image</MudButton></p> }
                        @if (_expanded == binding.Id)
                        {
                            <fieldset class="reference-fields" disabled="@_busy">
                                <legend class="sr-only">Edit Picture @number</legend>
                                @if (AllowInference) { <label>AI use hint<select aria-label="AI use hint" @bind="binding.AiUseHint">@foreach (var hint in new[] { "Auto", "Identity", "Clothing", "Setting", "Prop", "Style", "Framing", "First frame", "Last frame" }) { <option>@hint</option> }</select></label><p class="field-hint">Guides the next AI composition. Your direction and prompt take precedence.</p> }
                                else {
                                <ReferenceUseSelect Image="binding" Shot="_draft" Changed="RoleChanged" AllowInference="AllowInference" />
                                @if (ReferenceSetups.IsAnchor(binding))
                                {
                                    <p class="field-hint">Whole-frame guidance for the @(binding.Use == ShotImageUse.FirstFrame ? "opening" : "ending") composition. Ref2VA may vary from the supplied frame; this is not an exact frame lock.</p>
                                }
                                else
                                {
                                    <label>Character<select aria-label="Character" value="@binding.RepresentsId" @onchange="LinkCharacter"><option value="">No character link</option>@foreach (var c in ShotReferences.Characters(_draft)) { <option value="@c.Id">@c.Name</option> }</select></label>
                                    @if (CharacterAsset(binding) is { } asset && !ShotReferences.Characters(_draft).Any(c => string.Equals(c.Name, asset.Name, StringComparison.OrdinalIgnoreCase)))
                                    { <button @onclick="() => AddCharacter(asset)">Add @asset.Name to this shot and link</button> }
                                    <p class="field-hint">New character links start as identity references; they do not assign an outfit.</p>
                                    <details><summary>Character looks and transitions</summary><ShotAppearanceEditor Shot="_draft" Library="Library" Changed="characters => _draft.Characters = characters" /></details>
                                }
                                @if (Image(binding) is { } image && image.LookId != binding.LookId)
                                { <button @onclick="() => binding.LookId = image.LookId">Use current image assignment</button> }
                                }
                                <section class="reference-guidance">
                                    <h4>What to preserve · @(Guidance(binding).Override is null ? "Inherited" : "Local override")</h4>
                                    @if (ReferenceSetups.IsAnchor(binding)) { <p class="field-hint">Anchors use image guidance only. Asset and character/look instructions are excluded.</p> }
                                    @if (Guidance(binding).Override is null)
                                    { <p class="preservation-text">@(Guidance(binding).Effective.Length == 0 ? "No shared guidance yet." : Guidance(binding).Effective)</p><button @ref="_customizeButton" data-guidance-customize @onclick="Customize">Customize for this @ContextName</button> }
                                    else
                                    { <label>@(AllowInference ? "Composition" : "Shot") preservation override<textarea @ref="_guidanceInput" rows="4" maxlength="50000" @bind="binding.PreservationOverride" @bind:event="oninput"></textarea></label><button @onclick="ResetGuidance">Reset to shared defaults</button> }
                                    <a href="@(ProjectLink(Library.ProjectId, $"/assets?assetId={binding.AssetId}"))" target="_blank" rel="noopener">Open Assets ↗</a>
                                </section>
                            </fieldset>
                        }
                        </ChildContent>
                    </ReferenceSelectionRow>
                }
            </ol>
            @* Numbered right after the images, so it is listed there. *@
            @if (_draft.ContinuityFrame is { } continuity)
            {
                var continuityNumber = ResolvedReferences.For(_draft).Pictures.Single(p => p.Continuity is not null).Number;
                <ol class="manual-reference-list shot-frame-reference-list">
                    <ReferenceSelectionRow Label="@($"Picture {continuityNumber}")" Title="@ShotFrameTitle(continuity)" Name="@($"Picture {continuityNumber}")"
                        Status="@ShotFramePicker.Label(continuity, FrameShots, FrameTakes)" CanReorder="false" Disabled="_busy" Remove="() => _draft.ContinuityFrame = null">
                        <Thumbnail><img class="shot-frame-reference-thumbnail" src="@($"/media/projects/{Library.ProjectId}/takes/{continuity.TakeId}/frames/{continuity.Frame}")" alt="@($"Picture {continuityNumber}")" loading="lazy" /></Thumbnail>
                        <QuickActions>@if (FrameShots.Count > 0) { <button type="button" aria-label="@($"Picture {continuityNumber}: Change shot frame")" disabled="@_busy" @onclick="ChooseShotFrames">Change</button> }</QuickActions>
                        <ChildContent>@if (ShotFrameTakeChanged(continuity)) { <p class="field-hint">The source shot has a different selected take. Change this picture to review it.</p> }</ChildContent>
                    </ReferenceSelectionRow>
                </ol>
            }
            else if (FrameShots.Count == 0 && PreviousCopySource is { } previousShot && ContinuityFrameOf is not null)
            {
                var available = ContinuityFrameOf(previousShot) is not null; var full = ResolvedReferences.For(_draft).Pictures.Count >= 9;
                <button type="button" class="add-continuity-frame" disabled="@(_busy || !available || full)" @onclick="AddContinuityFrame">Add the last frame of @previousShot.Title</button>
                @if (!available) { <p class="field-hint">Choose a production take for @previousShot.Title first, with Use this take in its take review.</p> }
                else if (full) { <p class="field-hint">@ResolvedReferences.For(_draft).Pictures.Count/9 pictures. Remove some pictures or select fewer reel keyframes to add another.</p> }
            }
            @if (AllowReels) {
                <h3 @ref="_reelsHeading" tabindex="-1" class="reel-selection-heading">Reels and picture sources · @ReferenceVideos.ReelSlotCount(_draft)/3 reel slots</h3>
                @if (_draft.Videos.Any(v => v.EffectiveVisuals == ReelVisuals.Keyframes)) { <p class="field-hint">Selected keyframes use picture slots. Their source reels use no reel slots. Removing a source here removes its attached pictures from this setup, not from Assets.</p> }
                @if (_draft.Videos.Count == 0) { <p>Choose an asset reel. Its guidance will be copied into this @ContextName.</p> }
                <ol class="manual-reference-list video-reference-list">
                @foreach (var v in _draft.Videos) {
                    var index = _draft.Videos.IndexOf(v);
                    <ReferenceSelectionRow @key="v.Id" data-video-reference-id="@v.Id" Label="@($"Video {index + 1}")" Title="@v.Name"
                        Name="@ResolvedReferences.For(_draft).Label(v)" Status="@($"{VideoResolutions.Badge(v.Media)} · {v.Media.Duration:0.###} s · {(ReferenceVideos.UsesReelSlot(v) ? "1 reel slot" : "No reel slot")} · {ReelVoiceDefaults.Summary(_draft, v, Library)}")"
                        Disabled="_busy" First="@(index == 0)" Last="@(index == _draft.Videos.Count - 1)" MoveUp="() => MoveVideo(index, -1)" MoveDown="() => MoveVideo(index, 1)" Remove="() => RemoveVideo(v)">
                        <Thumbnail><ReferenceVideoThumbnail ProjectId="Library.ProjectId" MediaId="v.Media.Id" /></Thumbnail>
                        <Actions>
                            @if (v.EffectiveVisuals is ReelVisuals.Keyframes or ReelVisuals.RefMod) { <button type="button" aria-label="@($"Video {index + 1}: Manage keyframes")" title="Manage keyframes and crops" aria-haspopup="dialog" disabled="@_busy" @onclick="() => _keyframeBinding = v"><MudIcon Icon="@Icons.Material.Outlined.Crop" Size="Size.Small" aria-hidden="true" /></button> }
                        </Actions>
                        <QuickActions>
                            <button type="button" class="@(_swapVideo == v.Id ? "is-active" : "")" aria-label="@($"Video {index + 1}: Replace reel")" aria-expanded="@(_swapVideo == v.Id ? "true" : "false")" disabled="@_busy" @onclick="() => ToggleSwap(v)">Replace</button>
                            <button type="button" class="reference-settings-button @(_expanded == v.Id ? "is-active" : "")" aria-label="@($"Video {index + 1}: Reference settings")" aria-expanded="@(_expanded == v.Id ? "true" : "false")" disabled="@_busy" @onclick="() => _expanded = _expanded == v.Id ? null : v.Id">Settings</button>
                        </QuickActions>
                        <ChildContent>
                        @if (_swaps.TryGetValue(v.Id, out var swap) && LibraryReel(swap.From) is { } swappedFrom && LibraryReel(swap.To) is { } swappedTo) {
                            <div class="reel-swap-result">
                                <p role="status">Uses @swappedTo.Name · @VideoResolutions.Badge(swappedTo) instead of @swappedFrom.Name · @VideoResolutions.Badge(swappedFrom). Its name, guidance, keyframes and voice carry over.</p>
                                @if (_swapOthers.GetValueOrDefault(v.Id) is > 0 and var others) {
                                    <label class="check-row"><input type="checkbox" checked="@swap.OtherShots" disabled="@_busy" @onchange="e => SwapElsewhere(v, e.Value is true)" />Also replace it in @(others == 1 ? "1 other shot" : $"{others} other shots")</label>
                                }
                            </div>
                        }
                        @if (_swapVideo == v.Id) {
                            var choices = SwapChoices(v); var current = Library.Reels.FirstOrDefault(r => r.Media.Id == v.Media.Id);
                            <section class="reel-swap" aria-label="@($"Replace Video {index + 1}")">
                                <p class="field-hint">Choose a version below or any reel in the reference list. A reel of the same asset keeps this reference's name, guidance, visuals and voice; keyframes move to the same moments.</p>
                                @if (choices.Count == 0) { <p>No other reels of this asset.</p> }
                                <ul class="reel-swap-choices">
                                @foreach (var choice in choices) {
                                    <li @key="choice.Id">
                                        <span class="reel-swap-thumb"><ReferenceVideoThumbnail ProjectId="Library.ProjectId" MediaId="choice.Media.Id" /></span>
                                        <span><strong>@choice.Name</strong><small>@VideoResolutions.Badge(choice) · @LookName(choice) · @choice.Media.Duration.ToString("0.###") s@(RegeneratedFrom(choice, current) ? " · Regenerated from this reel" : "")</small></span>
                                        <button type="button" disabled="@_busy" aria-label="@($"Use {choice.Name} · {VideoResolutions.Badge(choice)}")" @onclick="() => Swap(v, choice)">Use</button>
                                    </li>
                                }
                                </ul>
                                <button type="button" class="reel-swap-browse" disabled="@_busy" @onclick="() => _selectedTab = false">Browse all reels</button>
                            </section>
                        }
                        @if (v.EffectiveVisuals == ReelVisuals.FullReel && v.Media.Duration - ReferenceVideos.EffectiveSeconds(v.Media, _draft) > .001) { <p class="reference-issue">H3 uses the first @ReferenceVideos.EffectiveSeconds(v.Media, _draft).ToString("0.###") s. Later views, including part of a camera turn or route, may be excluded.</p> }
                        @if (_expanded == v.Id) {
                            <fieldset class="reference-fields" disabled="@_busy"><legend class="sr-only">Edit Video @(index + 1)</legend>
                                <video controls preload="metadata" poster="@ReferenceVideos.ThumbnailUrl(Library.ProjectId, v.Media.Id)" src="@ReferenceVideos.Url(Library.ProjectId, v.Media.Id)" aria-label="Preview Video @(index + 1)"></video>
                                @if (!v.Media.HasAudio) { <p>Silent clip</p> }
                                @if (ReelAuthoring) { <p class="field-hint">Choose how this reel supplies visual references. Audio is chosen separately in the reel recipe.</p> }
                                <label>Visuals<select aria-label="Visuals" value="@v.EffectiveVisuals" @onchange="e => ChangeVisuals(v, e)"><option value="Keyframes">Keyframes</option><option value="FullReel">Full reel</option><option value="RefMod">Selected-keyframe RefMod · Experimental</option>@if (!ReelAuthoring) { <option value="None">None</option> }</select></label>
                                @if (Library.Assets.FirstOrDefault(a => a.Id == CharacterVoices.Owner(v, Library)) is { } reelOwner) {
                                    <p class="field-hint">Asset default: @ReelUsageDefaults.Label(ReelUsageDefaults.Initial(reelOwner)). Visuals above applies only to this reference.</p>
                                    <button type="button" @onclick="() => ChangeVisuals(v, new ChangeEventArgs { Value = ReelUsageDefaults.Initial(reelOwner).ToString() })">Use asset default</button>
                                }
                                @if (v.EffectiveVisuals is ReelVisuals.Keyframes or ReelVisuals.RefMod) {
                                    <button @onclick="() => _keyframeBinding = v">Manage keyframes…</button>
                                    @if (Library.Reels.FirstOrDefault(r => r.Media.Id == v.Media.Id)?.Keyframes is { } defaults) { <button @onclick="() => v.Keyframes = ShotCopy.Of(defaults)">Use saved reel keyframes</button> }
                                    <div class="selected-keyframes">@foreach (var picture in ResolvedReferences.For(_draft).Pictures.Where(p => p.Reel == v)) {
                                        <div><CropThumbnail MeasureImage="true" Url="@ReferenceVideos.FrameUrl(Library.ProjectId, picture.Keyframe!.Frame)" Label="@(picture.Keyframe.Name ?? $"Picture {picture.Number}")" Width="v.Media.Width" Height="v.Media.Height" Crop="picture.Keyframe.Crop" /><small>@($"<Picture {picture.Number}>") · @if (!string.IsNullOrWhiteSpace(picture.Keyframe.Name)) { <text>@picture.Keyframe.Name · </text> }@picture.Keyframe.Frame.Seconds.ToString("0.###") s</small></div>
                                    }</div>
                                }
                                @if (v.EffectiveVisuals == ReelVisuals.RefMod) {
                                    <section class="refmod-automatic" aria-label="Automatic RefMod preparation">
                                        <p>@ReelRefMods.Summary(v)</p>
                                        <p class="field-hint">Apply changes to keep the selected frames and crops. Generation builds or reuses the RefMod automatically; no separate build is needed. New references use a 640 × 640 fitted and padded canvas without an extra cover crop; existing references retain their saved canvas. Voice stays a separate Audio input.</p>
                                        <div class="selected-keyframes">@foreach (var frame in v.Keyframes?.Frames ?? []) {
                                            <div><CropThumbnail MeasureImage="true" Url="@ReferenceVideos.FrameUrl(Library.ProjectId, frame.Frame)" Label="@ReelViewSuggestions.Label(frame, v.Keyframes!.Frames.IndexOf(frame) + 1)" Width="v.Media.Width" Height="v.Media.Height" Crop="frame.Crop" /><small>@ReelViewSuggestions.Label(frame, v.Keyframes!.Frames.IndexOf(frame) + 1) · @frame.Frame.Seconds.ToString("0.###") s</small></div>
                                        }</div>
                                    </section>
                                }
                                <label>Name<input @bind="v.Name" @bind:event="oninput" maxlength="500" /></label>
                                <label>Use guidance<textarea @bind="v.Description" @bind:event="oninput" maxlength="20000" rows="4"></textarea></label>
                                <p class="field-hint">Compose inspects selected keyframes and RefMod source stills. For full reels it uses this guidance without inspecting video or audio.</p>
                                @if (!ReelAuthoring && !ManagedVoice(v)) {
                                <label class="soundtrack-choice"><input type="checkbox" @bind="v.UseSoundtrack" disabled="@(!v.Media.HasAudio)" />Use audio</label>
                                @if (v.UseSoundtrack && v.EffectiveVisuals != ReelVisuals.FullReel) {
                                    <div class="reel-audio-excerpt"><label>Audio start (seconds)<input type="number" min="0" step="0.01" value="@N(ResolvedReferences.Excerpt(v).Start)" @onchange="e => AudioChanged(v, e, true)" /></label><label>Audio duration (seconds)<input type="number" min="1" max="15" step="0.01" value="@N(ResolvedReferences.Excerpt(v).Duration)" @onchange="e => AudioChanged(v, e, false)" /></label></div>
                                    <ReelAudioPreview ProjectId="Library.ProjectId" Reel="v" />
                                }
                                @if (v.UseSoundtrack) { <label>Dialogue speaker (optional)<select @bind="v.Speaker"><option value="">No speaker mapping</option>@foreach (var speaker in _draft.Dialogue.Select(d => d.Speaker).Distinct(StringComparer.OrdinalIgnoreCase)) { <option>@speaker</option> }</select></label> }
                                } else if (!ReelAuthoring) { <p class="field-hint">Voice: @CharacterVoices.Label(_draft.CharacterVoices?.FirstOrDefault(c => c.AssetId == v.OwnerAssetId)) · Change under Character voices below.</p> }
                                <button @onclick="() => CopyUsage(index)">Copy usage snippet</button>
                                <button @onclick="() => StartReelReplacement(v)">Replace reel</button>
                            </fieldset>
                        }
                        </ChildContent>
                    </ReferenceSelectionRow>
                }
                </ol>
                @if (!ReelAuthoring) { <h3 @ref="_voicesHeading" tabindex="-1" class="reel-selection-heading">Voices</h3><CharacterVoiceEditor Shot="_draft" Library="Library" Disabled="_busy" Changed="() => { _reelVoiceNotice = null; StateHasChanged(); }" /> }
            }
        </Selection>
        <Footer>
        @if (_reelVoiceNotice is not null) { <p role="status" class="reel-voice-notice">@_reelVoiceNotice</p> }
        @if (_copyNotice is { } copied) { <div class="reference-copy-notice" role="status">@foreach (var (text, warning) in copied) { <p class="@(warning ? "field-error" : "field-hint")">@text</p> }</div> }
        @if (_error is not null) { <p role="alert">@_error</p> }
        @if (ReviewSelectionIssue is { } selectionIssue && selectionIssue != _error) { <p role="alert">@selectionIssue</p> }
        <span role="status">@ResolvedReferences.For(_draft).Pictures.Count/9 pictures @(AllowReels ? $"· {ReferenceVideos.ReelSlotCount(_draft)}/3 reels" : "") · @ResolvedReferences.For(_draft).Audio.Count/3 audio · @(_preparingFrames ? "Preparing reference images…" : _busy ? "Saving…" : "Changes apply together")</span>
        <MudButton Disabled="@(_busy && !_preparingFrames)" OnClick="CancelDialog">Cancel</MudButton>
        @if (ResolvedReferences.For(_draft).Pictures.Count > 9) { <span role="alert">Over picture budget: choose fewer reel keyframes or remove pictures before applying.</span> }
        <MudButton Disabled="@(_busy || ResolvedReferences.For(_draft).Pictures.Count > 9 || ReviewSelectionIssue is not null)" OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled">Apply changes</MudButton>
        </Footer>
    </ReferencePicker>
</section>

<InlineDialog Visible="_keyframeBinding is not null" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false })" Class="reel-keyframes-dialog" Title="@($"Manage keyframes for this {(ReelAuthoring ? "reel" : "setup")}")"><DialogContent>
@if (_keyframeBinding is { } editReel) { <ReelKeyframeEditor @key="editReel.Id" ProjectId="Library.ProjectId" Media="editReel.Media" Initial="editReel.Keyframes" Applied="ApplyKeyframes" Cancelled="() => _keyframeBinding = null" SaveLabel="Apply keyframes" SaveImage="SaveImage" ImageSaved="ImageSaved" /> }
</DialogContent></InlineDialog>

@if (_draft.Images.FirstOrDefault(b => b.Id == _cropTarget) is { } cropTarget && Image(cropTarget) is { } cropMedia) {
    <ImageInputCropDialog @key="cropTarget.Id" Label="@($"Picture {_draft.Images.IndexOf(cropTarget) + 1}")" Url="@Url(cropTarget)" Width="cropMedia.Width" Height="cropMedia.Height" InitialCrop="cropTarget.Crop" Applied="ApplyCrop" Cancelled="CloseCrop" />
}
