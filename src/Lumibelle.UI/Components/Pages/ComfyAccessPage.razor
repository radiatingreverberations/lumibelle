@page "/settings/comfy-access"
@using lumibelle.Services.AI
@inject IComfyAccessCredentialStore Credentials
@inject IComfyAccessProbe Probe
@inject IAiSettingsStore Settings
@implements IDisposable

<PageTitle>ComfyUI access · Lumibelle</PageTitle>
<PageHeading Title="ComfyUI access" BackHref="/settings/ai?tab=connections&provider=comfyui" BackLabel="AI connections" />
<div class="access-settings ai-settings-form">
    <p>For a ComfyUI server protected by Cloudflare Access, create a service token and allow it with a <strong>Service Auth</strong> policy. Servers without Cloudflare Access need no credentials.</p>
    <p>Credentials apply only to the exact HTTPS origin (host and port), across text, image, and video requests and live progress. They are protected using this Lumibelle installation's credential protector, not stored in projects or take snapshots.</p>
    @if (_error is not null && (_loading || _snapshot is not null)) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
    @if (_message is not null) { <p role="status">@_message</p> }
    @if (_loading) { <LoadingState Text="Loading Access settings…" /> }
    else if (_snapshot is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="Access settings couldn’t be loaded" role="alert">
            <ChildContent>@(_error ?? "Saved credentials are unavailable.")</ChildContent>
            <Actions><button type="button" disabled="@_busy" @onclick="Reload">Try again</button></Actions>
        </EmptyState>
    }
    else
    {
        <form class="settings-card" @onsubmit="Save" @onsubmit:preventDefault>
            <fieldset disabled="@_busy">
                <legend>Add or replace service-token credentials</legend>
                <label for="comfy-access-url">ComfyUI server URL</label>
                <input id="comfy-access-url" type="url" @bind="_url" @bind:event="oninput" @bind:after="ClearCheck" required autocomplete="off" />
                <p class="field-hint">HTTPS is required to save a token. A URL path is allowed, but credentials authorize this origin, not just that path. Saving here does not change the server URL in AI connections.</p>
                <label for="comfy-access-client-id">Cloudflare Access Client ID</label>
                <input id="comfy-access-client-id" type="text" @bind="_clientId" @bind:event="oninput" maxlength="4096" required autocomplete="off" autocapitalize="none" spellcheck="false" />
                <label for="comfy-access-client-secret">Cloudflare Access Client Secret</label>
                <input id="comfy-access-client-secret" type="password" @bind="_clientSecret" @bind:event="oninput" maxlength="4096" required autocomplete="new-password" autocapitalize="none" spellcheck="false" />
                <p class="field-hint">Enter both fields to add or rotate a token. Saved values are never loaded into these fields. These are Access service-token credentials, not a Cloudflare account API token.</p>
                <div class="access-actions"><button type="button" @onclick="ClearDraft">Clear entered token</button><button type="submit" class="lumi-button primary">Save credentials</button></div>
            </fieldset>
        </form>
        <section class="settings-card" aria-label="Test saved Access connection">
            <h2>Test the connection</h2>
            <p>Tests the URL above using <strong>saved</strong> credentials. Checks the HTTP API and WebSocket separately without generating anything. Unsaved token fields are not used.</p>
            <button type="button" @onclick="Test" disabled="@_busy">Test saved connection</button>
            @if (_check is not null)
            {
                <dl role="status"><dt>HTTP · @(_check.HttpSucceeded ? "Passed" : "Failed")</dt><dd>@_check.HttpMessage</dd><dt>WebSocket · @(_check.WebSocketSucceeded ? "Passed" : "Unavailable")</dt><dd>@_check.WebSocketMessage</dd></dl>
            }
        </section>
        <section class="settings-card" aria-label="Saved Access connections">
            <h2>Saved origins</h2>
            <button type="button" @onclick="Reload" disabled="@_busy">Reload saved credentials</button>
            @if (_snapshot.Entries.Count == 0) { <p>No Access credentials configured.</p> }
            @foreach (var entry in _snapshot.Entries)
            {
                <article @key="entry.Origin" class="access-origin">
                    <h3>@entry.Origin</h3><p>Last updated @entry.UpdatedUtc.ToLocalTime().ToString("g")</p>
                    <button type="button" disabled="@_busy" @onclick="() => SelectOrigin(entry.Origin)">Use this origin</button>
                    <button type="button" class="lumi-button danger" disabled="@_busy" @onclick="() => _removeOrigin = entry.Origin">Remove credentials…</button>
                </article>
            }
        </section>
    }
</div>
<ConfirmDialog Visible="@(_removeOrigin is not null)" VisibleChanged="visible => { if (!visible && !_busy) _removeOrigin = null; }" Title="Remove credentials?" Context="@_removeOrigin"
               ConfirmLabel="Remove credentials" BusyLabel="Removing…" Danger="true" Busy="_busy" OnConfirm="Remove">
    <ChildContent><p>Stop authenticating new requests to this origin? Running downloads or WebSockets are not closed. This does not revoke the token in Cloudflare.</p></ChildContent>
    <Status>@if (_error is not null) { <span class="field-error">@_error</span> }</Status>
</ConfirmDialog>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private ComfyAccessSettings? _snapshot;
    private ComfyAccessCheck? _check;
    private string _url = "", _clientId = "", _clientSecret = "";
    private string? _error, _message, _removeOrigin;
    private bool _loading = true, _busy, _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _url = (await Settings.LoadAsync(_lifetime.Token)).ComfyUrl;
            _snapshot = await Credentials.LoadAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch { if (!_disposed) _error = "Could not load Access settings. Check this installation's settings directory and try again."; }
        finally { _loading = false; }
    }

    private void ClearCheck() => _check = null;
    private void ClearDraft() { _clientId = ""; _clientSecret = ""; }
    private void SelectOrigin(string origin) { ClearDraft(); _url = origin; _removeOrigin = null; ClearCheck(); }

    private async Task Reload()
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try
        {
            var loaded = await Credentials.LoadAsync(_lifetime.Token);
            if (_disposed) return;
            _snapshot = loaded; _removeOrigin = null; ClearCheck();
            _message = "Saved credentials reloaded. Entered token fields have not been saved.";
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception e) { if (!_disposed) _error = SafeError(e); }
        finally { _busy = false; }
    }

    private async Task Save()
    {
        if (_busy || _snapshot is null) return;
        _busy = true; _error = null; _message = null; ClearCheck();
        try
        {
            var saved = await Credentials.SaveAsync(_url, _clientId, _clientSecret, _snapshot.Revision, _lifetime.Token);
            if (_disposed) return;
            _snapshot = saved; ClearDraft();
            _message = "Credentials saved. New requests and WebSocket reconnects use the updated token. Test the saved connection below.";
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception e) { if (!_disposed) _error = SafeError(e); }
        finally { _busy = false; }
    }

    private async Task Remove()
    {
        if (_busy || _snapshot is null || _removeOrigin is null) return;
        _busy = true; _error = null; _message = null; ClearCheck();
        try
        {
            var saved = await Credentials.RemoveAsync(_removeOrigin, _snapshot.Revision, _lifetime.Token);
            if (_disposed) return;
            _snapshot = saved; _removeOrigin = null;
            _message = "Saved credentials removed. Revoke the token in Cloudflare too if it is no longer needed.";
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception e) { if (!_disposed) _error = SafeError(e); }
        finally { _busy = false; }
    }

    private async Task Test()
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null; ClearCheck();
        try
        {
            var result = await Probe.CheckAsync(_url, _lifetime.Token);
            if (!_disposed) _check = result;
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception e) { if (!_disposed) _error = SafeError(e); }
        finally { _busy = false; }
    }

    private static string SafeError(Exception error) => error is ComfyAccessException ? error.Message :
        "The operation failed. Check this installation's credential storage and network. No token values are shown in diagnostics.";

    public void Dispose()
    {
        _disposed = true; ClearDraft(); _lifetime.Cancel(); _lifetime.Dispose();
    }
}
