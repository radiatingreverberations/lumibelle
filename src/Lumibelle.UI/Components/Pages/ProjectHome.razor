@inherits ProjectAwareComponent
@inject IProjectStore ProjectStore
@inject IDialogService DialogService

<PageTitle>@(_project is null ? "Project" : _project.Name) · Lumibelle</PageTitle>
@if (_loading)
{
    <LoadingState Text="Opening your project…" />
}
else if (_error is not null)
{
    <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="This project couldn’t be opened" role="alert">
        <ChildContent>@_error</ChildContent>
        <Actions><MudButton OnClick="LoadAsync" Variant="Variant.Outlined">Try again</MudButton><MudButton Href="/">All projects</MudButton></Actions>
    </EmptyState>
}
else if (_project is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.FolderOff" Title="Project not found">
        <ChildContent>This project may have moved or is no longer in your library.</ChildContent>
        <Actions><MudButton Href="/" Variant="Variant.Outlined">Back to your projects</MudButton></Actions>
    </EmptyState>
}
else
{
    <PagePosition ProjectId="Id" Studio="overview" />
    <ProjectNavigation Project="_project" />
    <PageHeading Title="@_project.Name" Eyebrow="Project overview">
        <Lead>
            @if (!string.IsNullOrWhiteSpace(_project.Description)) { <p class="project-synopsis">@_project.Description</p> }
            <p class="project-date mt-2"><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" />Created <time datetime="@_project.CreatedUtc.ToString("O")">@_project.CreatedUtc.ToLocalTime().ToString("d MMMM yyyy")</time></p>
        </Lead>
        <Actions>
            <MudButton OnClick="EditProjectAsync" Disabled="_dialogOpen" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit">Edit project…</MudButton>
        </Actions>
    </PageHeading>
    <div class="project-areas">
        <article><span class="area-icon story-area"><MudIcon Icon="@Icons.Material.Outlined.MenuBook" /></span><h2>Source</h2><p>Analyze original material in sections and review an adaptation outline for the whole story.</p><MudButton Href="@(ProjectLink(Id, "/source"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Source</MudButton></article>
        <article><span class="area-icon story-area"><MudIcon Icon="@Icons.Material.Outlined.EditNote" /></span><h2>Script</h2><p>Turn an idea into a screenplay. Write, revise, and develop it with your chosen text model.</p><MudButton Href="@(ProjectLink(Id, "/script"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Script</MudButton></article>
        <article><span class="area-icon assets-area"><MudIcon Icon="@Icons.Material.Outlined.Landscape" /></span><h2>Assets</h2><p>Develop characters, environments, and props. Build their reference libraries.</p><MudButton Href="@(ProjectLink(Id, "/assets"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Assets</MudButton></article>
        <article><span class="area-icon shots-area"><MudIcon Icon="@Icons.Material.Outlined.ViewList" /></span><h2>Scenes</h2><p>Prepare each scene's environment, plan coverage, and review its shots.</p><MudButton Href="@(ProjectLink(Id, "/scenes"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Scenes</MudButton></article>
        <article><span class="area-icon shots-area"><MudIcon Icon="@Icons.Material.Outlined.Movie" /></span><h2>Shots</h2><p>Choose references, compose prompts, and generate takes. Start from planned coverage or a standalone visual idea.</p><MudButton Href="@(ProjectLink(Id, "/shots"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Shots</MudButton></article>
        <article><span class="area-icon shots-area"><MudIcon Icon="@Icons.Material.Outlined.ContentCut" /></span><h2>Cut</h2><p>Assemble saved takes into a sequence, trim each clip, and export the result.</p><MudButton Href="@(ProjectLink(Id, "/cut"))" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.ArrowForward">Open Cut</MudButton></article>
    </div>
}
@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectInfo? _project;
    private string? _error;
    private bool _loading = true;
    private bool _dialogOpen;
    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task EditProjectAsync()
    {
        if (_dialogOpen || _project is null) return;
        var original = _project;
        _dialogOpen = true;
        try
        {
            var dialog = await DialogService.ShowAsync<ProjectDialog>("Edit project",
                new DialogParameters { [nameof(ProjectDialog.Project)] = original },
                DialogSizes.Small);
            var result = await dialog.Result;
            if (Id == original.Id && result is { Canceled: false, Data: ProjectInfo updated })
                _project = updated;
        }
        finally { _dialogOpen = false; }
    }
    private async Task LoadAsync()
    {
        var requestedId = Id;
        _loading = true;
        _error = null;
        _project = null;
        try
        {
            var project = await ProjectStore.GetAsync(requestedId);
            if (requestedId == Id) _project = project;
        }
        catch (ProjectStoreException exception) { if (requestedId == Id) _error = exception.Message; }
        finally { if (requestedId == Id) _loading = false; }
    }
}
