@using lumibelle.Components.Projects
@inherits ProjectAwareComponent
@page "/"
@inject IProjectStore ProjectStore
@inject lumibelle.Services.Projects.IProjectFolders Folders
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Your projects · Lumibelle</PageTitle>
<PageHeading Title="Your projects" Eyebrow="Project library">
    <Lead>A place for your stories, characters, and worlds.</Lead>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="NewProjectAsync" Disabled="_dialogOpen">New project</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="() => { _transferBusy = false; _transferOpen = true; }" Disabled="@(_dialogOpen || _loading)">Export / import project…</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FolderOpen" OnClick="OpenFolderDialog" Disabled="@(_dialogOpen || _loading)">Open project folder…</MudButton>
    </Actions>
</PageHeading>
<section class="library-section" aria-labelledby="library-title">
    <div class="section-heading">
        <div class="section-title"><h2 id="library-title">All projects</h2>@if (_library is not null) { <span class="count-badge">@_library.Projects.Count</span> }</div>
        <span class="sort-label">Newest first <MudIcon Icon="@Icons.Material.Outlined.South" Size="Size.Small" /></span>
    </div>
    @if (_loading)
    {
        <LoadingState Text="Opening your library…" />
    }
    else if (_error is not null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="Your library couldn’t be opened" HeadingLevel="3" role="alert">
            <ChildContent>@_error</ChildContent>
            <Actions><MudButton OnClick="LoadAsync" Variant="Variant.Outlined">Try again</MudButton></Actions>
        </EmptyState>
    }
    else if (_library is not null)
    {
        @if (_library.Issues.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-5" role="alert">
                Some projects couldn’t be opened. Your other projects are still available.
                <details class="project-issues"><summary>Show details (@_library.Issues.Count)</summary>
                    @foreach (var issue in _library.Issues)
                    {
                        <p><code>@issue.ProjectId</code><br />@issue.Message</p>
                        @if (_folders.ContainsKey(issue.ProjectId)) { <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_folderBusy" OnClick="() => RemoveFolderAsync(issue.ProjectId)">Remove from library</MudButton> }
                    }
                    @if (_folderError is not null) { <p role="alert">@_folderError</p> }
                </details>
            </MudAlert>
        }
        @if (_library.Projects.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.CreateNewFolder" Title="@(_library.Issues.Count == 0 ? "Your next story belongs here" : "No readable projects yet")" HeadingLevel="3">
                <ChildContent>Create a project to make room for your ideas.<br />A name is all you need to begin.</ChildContent>
                <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="NewProjectAsync" Disabled="_dialogOpen">Create a project</MudButton></Actions>
            </EmptyState>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in _library.Projects)
                {
                    <a @key="project.Id" class="project-card" href="@(ProjectLink(project.Id, ""))" aria-label="@($"Open {project.Name}")">
                        <div class="project-card-body">
                            <span class="project-symbol" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Movie" /></span>
                            <div class="project-card-copy"><h3>@project.Name</h3><p class="project-description">@(project.Description ?? "No description yet.")</p>
                                @if (_folders.TryGetValue(project.Id, out var folder)) { <p class="project-location" title="@folder.Path"><MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" /><span>@folder.Path</span></p> }</div>
                        </div>
                        <div class="project-card-footer"><time datetime="@project.CreatedUtc.ToString("O")">Created @project.CreatedUtc.ToLocalTime().ToString("d MMM yyyy")</time><span>Open project <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /></span></div>
                    </a>
                }
            </div>
        }
    }
</section>

<InlineDialog Visible="_folderOpen" VisibleChanged="value => { if (!_folderBusy) _folderOpen = value; }" Options="DialogSizes.Small"
              Class="project-folder-dialog" Title="Open project folder" CloseLabel="Close open project folder" CloseDisabled="_folderBusy" CloseOnEscape="!_folderBusy">
    <Summary>Edit a project where it is, outside the library folder.</Summary>
    <DialogContent>
        <ProjectFolderField Id="project-folder" Label="Project folder" @bind-Value="_folderPath" Disabled="_folderBusy">
            <Hint>The folder that contains project.json, or an unzipped project export. Lumibelle adds it to your projects and saves every change there.</Hint>
        </ProjectFolderField>
        @if (_folderError is not null) { <p class="field-error" role="alert">@_folderError</p> }
    </DialogContent>
    <Actions>
        <MudButton Disabled="_folderBusy" OnClick="() => _folderOpen = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_folderBusy || string.IsNullOrWhiteSpace(_folderPath))" OnClick="OpenFolderAsync">@(_folderBusy ? "Opening…" : "Open project")</MudButton>
    </Actions>
</InlineDialog>

<InlineDialog Visible="_transferOpen" VisibleChanged="value => { if (!_transferBusy) _transferOpen = value; }" Options="DialogSizes.Medium"
              Class="project-transfer-dialog" Title="Project packages" CloseLabel="Close project packages" CloseDisabled="_transferBusy" CloseOnEscape="!_transferBusy">
    <Summary>Move a project between libraries as a single ZIP.</Summary>
    <DialogContent>@if (_transferOpen) { <ProjectTransferPanel Projects="@(_library?.Projects ?? [])" ActionsSection="_transferActions" BusyChanged="value => _transferBusy = value" Imported="PackageImported" Closed="() => _transferOpen = false" /> }</DialogContent>
    <DialogActions><SectionOutlet SectionId="_transferActions" /></DialogActions>
</InlineDialog>

@code {
    private bool _transferOpen, _transferBusy;
    private readonly object _transferActions = new();
    private async Task PackageImported(ProjectInfo project)
    {
        _transferOpen = false; await LoadAsync(); Navigation.NavigateTo(ProjectLink(project.Id));
    }

    private bool _folderOpen, _folderBusy;
    private string _folderPath = "";
    private string? _folderError;
    private IReadOnlyDictionary<Guid, ProjectLocation> _folders = new Dictionary<Guid, ProjectLocation>();
    private void OpenFolderDialog() { _folderPath = ""; _folderError = null; _folderOpen = true; }
    private async Task OpenFolderAsync()
    {
        if (_folderBusy) return;
        _folderBusy = true; _folderError = null;
        try
        {
            var project = await Folders.OpenAsync(_folderPath);
            _folderOpen = false;
            await LoadAsync(); Navigation.NavigateTo(ProjectLink(project.Id));
        }
        catch (Exception exception) when (exception is ProjectStoreException or WorkspaceStoreException) { _folderError = exception.Message; }
        finally { _folderBusy = false; }
    }
    private async Task RemoveFolderAsync(Guid project)
    {
        if (_folderBusy) return;
        _folderBusy = true; _folderError = null;
        try { await Folders.RemoveAsync(project); await LoadAsync(); }
        catch (Exception exception) when (exception is ProjectStoreException or WorkspaceStoreException) { _folderError = exception.Message; }
        finally { _folderBusy = false; }
    }

    private ProjectLibrary? _library;
    private bool _loading = true;
    private bool _dialogOpen;
    private string? _error;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _library = await ProjectStore.ListAsync();
            _folders = (await Folders.ListAsync()).ToDictionary(folder => folder.ProjectId);
            if (ProjectRoutes is not null) await ProjectRoutes.RefreshAsync();
        }
        catch (Exception exception) when (exception is ProjectStoreException or WorkspaceStoreException) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private async Task NewProjectAsync()
    {
        if (_dialogOpen) return;
        _dialogOpen = true;
        try
        {
            var dialog = await DialogService.ShowAsync<ProjectDialog>("New project", DialogSizes.Small);
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: ProjectInfo project }) { if (ProjectRoutes is not null) await ProjectRoutes.RefreshAsync(); Navigation.NavigateTo(ProjectLink(project.Id)); }
        }
        catch (Exception exception) when (exception is ProjectStoreException or WorkspaceStoreException) { _error = exception.Message; }
        finally { _dialogOpen = false; }
    }
}
