@inherits ProjectAwareComponent
@page "/trash"
@inject IMediaTrashStore Store
@inject TimeProvider Clock

<PageTitle>@(Archives ? "Lossless archives" : "Trash") · Lumibelle</PageTitle>
<PageHeading Title="@(Archives ? "Lossless archives" : "Trash")" Eyebrow="Storage cleanup" />
<nav class="cleanup-views" aria-label="Storage cleanup"><a href="/trash" aria-current="@(!Archives ? "page" : null)">Discarded media</a><a href="/trash?view=archives" aria-current="@(Archives ? "page" : null)">Lossless archives</a></nav>
@if (Archives)
{
    <FrameArchiveCleanup />
}
else
{
<p class="intro-copy">Images, voices, video takes, reference reels, and saved frames stay here for 30 days. Restore them whenever you need them. Reels removed before they had a Trash period stay until you delete them.</p>
<p class="trash-cleanup-hint">Automatic cleanup runs while Lumibelle is open and catches up after restart. Permanently deleted media cannot be recovered.</p>
<div class="trash-toolbar" data-interactive="@(_interactive ? "true" : "false")">
    <label>Project <select value="@_project" @onchange="FilterChanged"><option value="">All projects</option>@foreach (var project in _library.Items.DistinctBy(r => r.ProjectId)) { <option value="@project.ProjectId">@project.ProjectName</option> }</select></label>
    <button @ref="_refreshButton" disabled="@_busy" @onclick="RefreshAsync">Refresh</button>
    <span>@Filtered.Count item@(Filtered.Count == 1 ? "" : "s") · @StorageSize.Format(Filtered.Sum(r => r.Bytes)) in this scope</span>
    <button disabled="@(_busy || _loading || Filtered.Count == 0 || Filtered.All(r => _selected.Contains(r.Id)))" @onclick="SelectAllInScope">@(_project.Length == 0 ? "Select all projects" : "Select all in this project")</button>
    <button disabled="@(_busy || _loading || _selected.Count == 0)" @onclick="() => _selected.Clear()">Clear selection</button>
    <MudButton Disabled="@(_busy || _selected.Count == 0)" Variant="Variant.Outlined" OnClick="() => RestoreAsync(SelectedRows)">Restore selected (@_selected.Count)</MudButton>
    <MudButton Disabled="@(_busy || _selected.Count == 0)" Color="Color.Error" Variant="Variant.Outlined" OnClick="() => Confirm(SelectedRows, false)">Delete selected permanently…</MudButton>
    <MudButton Disabled="@(_busy || Filtered.Count == 0)" Color="Color.Error" Variant="Variant.Outlined" OnClick="() => Confirm(Filtered, true)">Empty Trash…</MudButton>
    <span class="trash-selection-count" role="status">@_selected.Count selected · selection spans all pages @(_project.Length == 0 ? "across all projects" : "in this project")</span>
</div>
@if (_loading) { <LoadingState Text="Opening Trash…" /> }
@if (_error is not null && _loadFailed && _library.Items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="Trash couldn’t be opened" role="alert">
        <ChildContent>@_error</ChildContent>
        <Actions><MudButton Variant="Variant.Outlined" Disabled="@(_busy || _loading)" OnClick="RefreshAsync">Try again</MudButton></Actions>
    </EmptyState>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error @if (_loadFailed) { <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-2" Disabled="@(_busy || _loading)" OnClick="RefreshAsync">Try again</MudButton> }</MudAlert>
}
@foreach (var issue in _library.Issues) { <MudAlert Severity="Severity.Warning">@issue.Message</MudAlert> }
@if (_notice is not null) { <p role="status" class="trash-notice">@_notice</p> }
@if (_busy) { <p role="status">@_progress</p> }
@if (!_loading && !(_loadFailed && _library.Items.Count == 0) && Filtered.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.DeleteOutline" Title="@($"Nothing in Trash{(_project.Length > 0 ? " for this project" : "")}")">Discarded media will appear here.</EmptyState>
}
<div class="trash-grid">
@foreach (var row in Paged)
{
    var entry = row;
    <article class="trash-card" @key="entry.Id">
        <label class="trash-check"><input type="checkbox" checked="@_selected.Contains(entry.Id)" disabled="@_busy" @onchange="args => Select(entry.Id, args.Value is true)" aria-label="Select media from @entry.OwnerName" /> Select</label>
        <button class="trash-thumbnail" @onclick="() => Preview(row)" disabled="@(entry.Purging || _missing.Contains(entry.Id))" aria-label="Preview media from @entry.OwnerName">
            @if (!entry.Purging && !_missing.Contains(entry.Id)) { @if (entry.ThumbnailUrl is { } thumbnail) { <img src="@thumbnail" alt="@entry.OwnerName" loading="lazy" @onerror="() => _missing.Add(entry.Id)" /> } else { <span>Voice recording</span> } }
            else { <span>Media unavailable</span> }
        </button>
        <div class="trash-card-body"><a href="@ProjectLink(row.OwnerUrl)">@row.ProjectName</a><h2>@entry.OwnerName</h2>
            <p class="trash-tags">@(entry.Title.Length == 0 ? entry.Kind.ToString() : entry.Title)</p>
            <p>@StorageSize.Format(entry.Bytes)</p>
            <p><time datetime="@entry.DeletedUtc.ToString("O")">Deleted @entry.DeletedUtc.ToLocalTime().ToString("d MMM yyyy, HH:mm")</time><br /><strong>@entry.Remaining(Clock.GetUtcNow())</strong></p>
            @if (entry.Error is not null) { <p role="alert">@entry.Error</p> }
            <div class="trash-card-actions"><button disabled="@(_busy || !entry.CanRestore(Clock.GetUtcNow()) || _missing.Contains(entry.Id))" @onclick="() => RestoreAsync([row])">Restore</button><button type="button" class="lumi-button ghost danger" disabled="@_busy" @onclick="() => Confirm([row], false)">Delete permanently…</button></div>
        </div>
    </article>
}
</div>
@if (Filtered.Count > PageSize)
{
    <nav class="trash-pagination" aria-label="Trash pages"><button disabled="@(_page == 0 || _busy)" @onclick="() => _page--">Previous</button><span>Page @(_page + 1) of @PageCount</span><button disabled="@(_page + 1 >= PageCount || _busy)" @onclick="() => _page++">Next</button></nav>
}
<ConfirmDialog Visible="_confirmOpen" VisibleChanged="ConfirmVisibility" CloseLabel="Close delete confirmation" Danger="true" ConfirmLabel="Delete permanently" OnConfirm="PurgeConfirmedAsync"
               Title="@(_emptyAll ? (_project.Length == 0 ? "Empty Trash for all projects?" : "Empty Trash for this project?") : "Delete media permanently?")">
    <p>This permanently removes @_pending.Count saved media item@(_pending.Count == 1 ? "" : "s") and their metadata, freeing approximately <strong>@StorageSize.Format(_pending.Sum(r => r.Bytes))</strong>. Deleting a video take also removes its remaining frame archives and refinement data. A reel's video stays while a shot, take or saved image still uses it. This cannot be undone.</p>
    @if (_emptyAll) { <p>@(_project.Length == 0 ? "All projects are included." : "Only the selected project is included.") Media discarded after this confirmation opened is excluded.</p> }
    <div class="trash-confirm-thumbnails">@foreach (var row in _pending.Take(12)) { <figure>@if (row.ThumbnailUrl is { } thumb) { <img src="@thumb" alt="@row.OwnerName" /> }<figcaption>@row.ProjectName · @row.OwnerName</figcaption></figure> }</div>
</ConfirmDialog>
@if (_preview is { } preview)
{
    <InlineDialog Visible="_previewOpen" VisibleChanged="value => _previewOpen = value" Class="trash-preview" Options="DialogSizes.Media" Title="@preview.OwnerName" Context="In Trash" CloseLabel="Close Trash preview">
        <DialogContent>
            @if (preview.Kind == MediaTrashKind.Image && preview.Image is { } image)
            {
                <ImageComparisonViewer Primary="@(new(new(Guid.Empty, image.Id), "Image in Trash"))" PrimaryImage="@(_previewMissing ? null : image)" PrimaryUrl="@Url(preview)" Unavailable="_ => _previewMissing = true" />
            }
            else if (preview.Kind is MediaTrashKind.Take or MediaTrashKind.Reel) { <video controls playsinline preload="metadata" src="@Url(preview)"></video> }
            else if (preview.Kind == MediaTrashKind.Voice) { <audio controls preload="metadata" src="@Url(preview)"></audio> }
            else { <img src="@Url(preview)" alt="@preview.Title" /> }
            @if (preview.Image?.Source?.Frame is { } frame) { <p>Saved from video frame @(frame.FrameIndex + 1) · @frame.Timestamp.ToString("0.000") s · @frame.Width × @frame.Height · @frame.Fps fps</p><p>Shot @frame.ShotId · take @frame.TakeId</p> }
            @if (preview.Image?.Source?.Crop is { } crop) { <p>Cropped copy of image @crop.ImageId · source @crop.SourceWidth × @crop.SourceHeight</p><p>@System.Text.Json.JsonSerializer.Serialize(crop.Crop)</p> }
            @if (preview.Image?.Generation?.Look is { } look) { <p>Submitted look: @look.AssetName · @look.LookName</p><p class="preservation-text">@look.Description @look.PreservationGuidance</p> }
            @if (preview.Take is { } take) { <ShotAppearanceDetails Appearances="take.Snapshot.Appearances" /><RefinementDetails Take="take" /><VideoLoraDetails Snapshot="take.Snapshot" /> }
            <p>@preview.ProjectName · @preview.Remaining(Clock.GetUtcNow())</p>
            <details><summary>Media details</summary><pre class="shot-source">@System.Text.Json.JsonSerializer.Serialize(preview, AtomicJsonFile.Options)</pre></details>

        </DialogContent>
        <Actions><MudButton OnClick="() => _previewOpen = false">Close</MudButton></Actions>
    </InlineDialog>
}

}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private bool Archives => View == "archives";
    private const int PageSize = 24;
    private MediaTrashLibrary _library = new([], []);
    private HashSet<Guid> _selected = [], _missing = [];
    private IReadOnlyList<MediaTrashRow> _pending = [];
    private MediaTrashRow? _preview;
    private bool _interactive;
    // A failed read leaves the previous list in place; the page offers Try again instead of an empty Trash.
    private bool _loadFailed;
    private bool _loading, _busy, _confirmOpen, _emptyAll, _previewOpen, _focusRefresh, _previewMissing;
    private string _project = "", _progress = "";
    private string? _error, _notice;
    private int _page;
    private ElementReference _refreshButton;
    private IReadOnlyList<MediaTrashRow> Filtered => _library.Items.Where(r => _project.Length == 0 || r.ProjectId.ToString() == _project).ToArray();
    private IEnumerable<MediaTrashRow> Paged => Filtered.Skip(_page * PageSize).Take(PageSize);
    private int PageCount => Math.Max(1, (Filtered.Count + PageSize - 1) / PageSize);
    private IReadOnlyList<MediaTrashRow> SelectedRows => _library.Items.Where(r => _selected.Contains(r.Id)).ToArray();
    protected override Task OnInitializedAsync() => RefreshAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
        if (_focusRefresh) { _focusRefresh = false; if (!Archives) await _refreshButton.FocusAsync(); }
    }
    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            _library = await Store.ListAsync();
            if (_loadFailed) { _loadFailed = false; _error = null; }
            _selected.IntersectWith(_library.Items.Select(r => r.Id));
            _missing.Clear(); _page = Math.Min(_page, PageCount - 1);
        }
        catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException) { _error = e.Message; _loadFailed = true; }
        finally { _loading = false; }
    }
    private void FilterChanged(ChangeEventArgs args) { _project = args.Value?.ToString() ?? ""; _page = 0; _selected.Clear(); }
    private void SelectAllInScope() { if (!_busy && !_loading) _selected = Filtered.Select(r => r.Id).ToHashSet(); }
    private void Select(Guid id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); }
    private void Preview(MediaTrashRow row) { _preview = row; _previewMissing = false; _previewOpen = true; }
    private static string Url(MediaTrashRow row) => row.Url;
    private void Confirm(IReadOnlyList<MediaTrashRow> rows, bool all) { _pending = rows.ToArray(); _emptyAll = all; _confirmOpen = true; }
    private void ConfirmVisibility(bool visible) => _confirmOpen = visible;
    private Task PurgeConfirmedAsync() { _confirmOpen = false; return MutateAsync(_pending, true); }
    private Task RestoreAsync(IReadOnlyList<MediaTrashRow> rows) => MutateAsync(rows.ToArray(), false);
    private async Task MutateAsync(IReadOnlyList<MediaTrashRow> rows, bool purge)
    {
        if (_busy) return;
        _busy = true; _error = null; _progress = purge ? "Deleting media permanently…" : "Restoring media…";
        try
        {
            var result = await Store.ChangeAsync(rows.ToArray(), purge);
            _selected.ExceptWith(result.Succeeded);
            _notice = $"{result.Succeeded.Count} media item(s) {(purge ? "deleted permanently" : "restored")}.";
            if (result.Issues.Count > 0) _error = string.Join(" ", result.Issues.Select(i => i.Message));
            await RefreshAsync(); _focusRefresh = true;
        }
        catch (Exception e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
