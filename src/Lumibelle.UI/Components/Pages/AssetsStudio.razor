    private async Task<string?> RestoreReviewedAsync(Guid trashId)
    {
        if (_library is null) return "The asset library is unavailable.";
        await _saveGate.WaitAsync();
        try
        {
            if (!await SavePendingLockedAsync() || _library is null) return _saveError ?? "Save your changes before restoring.";
            var entry = _library.Trash.FirstOrDefault(t => t.Id == trashId);
            if (entry is null) return "This image is no longer in Trash. Reload the library.";
            var version = _editVersion;
            var saved = await TrashStore.RestoreImagesAsync(Id, [trashId], _library.Revision);
            ApplyStoredMutation(saved, version, []);
            if (_latestEditBatch is { } batch && batch.AssetId == entry.Asset.Id) batch.HiddenTakeIds.Remove(entry.Image.Id);
            await InvokeAsync(StateHasChanged);
            return null;
        }
        catch (WorkspaceConflictException e) { _conflict = true; _saveError = e.Message; _saveStatus = "Conflict"; return e.Message; }
        catch (WorkspaceStoreException e) { return e.Message; }
        finally { _saveGate.Release(); }
    }

    private void ApplyStoredMutation(AssetLibrary saved, long version, IReadOnlyCollection<AssetImageReference> removed)
    {
        if (version == _editVersion || _library is null) _library = saved;
        else
        {
            var local = _library;
            _library = saved with { Assets = saved.Assets.Select(stored =>
            {
                var draft = local.Assets.FirstOrDefault(a => a.Id == stored.Id);
                return draft is null ? stored : draft with { Images = [.. draft.Images.Where(i => !removed.Contains(new(stored.Id, i.Id))),
                    .. stored.Images.Where(i => draft.Images.All(d => d.Id != i.Id))] };
            }).Concat(local.Assets.Where(a => saved.Assets.All(s => s.Id != a.Id))).ToList() };
        }
        _savedLibrary = saved.Copy();
        _saveError = null; _conflict = false; _saveStatus = _dirty ? "Unsaved" : "Saved";
    }

    private async Task<AssetImage?> AddImageSafelyAsync(Guid assetId, Stream content, AssetImageInput input,
        CancellationToken cancellationToken = default)
    {
        await _saveGate.WaitAsync(cancellationToken);
        try
        {
            if (!await SavePendingLockedAsync() || _library is null) return null;
            var beforeIds = _library.Assets.Single(a => a.Id == assetId).Images.Select(i => i.Id).ToHashSet();
            var version = _editVersion;
            _saving = true;
            var saved = await AssetStore.AddImageAsync(Id, assetId, content, input, _library.Revision, cancellationToken);
            _savedLibrary = saved.Copy();
            if (version == _editVersion)
            {
                _library = saved;
                _dirty = false;
            }
            else
            {
                var storedAsset = saved.Assets.Single(asset => asset.Id == assetId);
                _library = _library with
                {
                    Revision = saved.Revision,
                    UpdatedUtc = saved.UpdatedUtc,
                    Trash = saved.Trash,
                    Assets = _library.Assets.Select(asset => asset.Id != assetId ? asset : asset with
                    {
                        Images = [.. asset.Images, .. storedAsset.Images.Where(image => asset.Images.All(existing => existing.Id != image.Id))]
                    }).ToList()
                };
            }
            _saveStatus = _dirty ? "Unsaved" : "Saved";
            _conflict = false;
            return saved.Assets.Single(a => a.Id == assetId).Images.Single(i => !beforeIds.Contains(i.Id));
        }
        finally
        {
            _saving = false;
            _saveGate.Release();
        }
    }

