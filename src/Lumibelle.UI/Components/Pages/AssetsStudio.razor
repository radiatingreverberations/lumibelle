    private void OpenCrop() { if (BaseReference is { } reference) OpenReferenceCrop(reference); }
    private void OpenReferenceCrop(AssetImageReference reference)
    {
        if (_composerLocked || FindImage(reference) is null) return;
        _cropTarget = reference;
        var state = _restoredCrops.TryGetValue(reference, out var restored) ? RestoreCropControls(reference, restored) : reference == BaseReference ? new CropSelection(_cropAspect, _cropZoom, _cropFocusX, _cropFocusY)
            : _referenceCropSelections.GetValueOrDefault(reference) ?? new();
        _draftCropAspect = state.Aspect; _draftCropZoom = state.Zoom;
        _draftCropFocusX = state.X; _draftCropFocusY = state.Y;
        _cropOpen = true; _initializeCropGesture = true;
    }
    private void ApplyCrop()
    {
        if (_composerLocked || _cropTarget is not { } target || FindImage(target) is null) return;
        _restoredCrops.Remove(target);
        if (target == BaseReference)
        {
            _cropAspect = _draftCropAspect; _cropZoom = _draftCropZoom;
            _cropFocusX = _draftCropFocusX; _cropFocusY = _draftCropFocusY;
        }
        else if (_additionalReferences.Contains(target))
            _referenceCropSelections[target] = new(_draftCropAspect, _draftCropZoom, _draftCropFocusX, _draftCropFocusY);
        CancelCrop();
    }
    private void UseFullSource()
    {
