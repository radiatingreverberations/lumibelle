    private async Task MutateVoiceAsync(Func<long, Task<AssetLibrary>> operation)
    {
        await _saveGate.WaitAsync();
        try
        {
            if (!await SavePendingLockedAsync()) throw new WorkspaceStoreException(_saveError ?? "Save asset changes first.");
            var version = _editVersion;
            AssetLibrary saved;
            try { saved = await operation(_library!.Revision); }
            catch (WorkspaceConflictException) {
                var current = await AssetStore.LoadAsync(Id);
                _library = AssetLibraryRebase.Merge(_savedLibrary ?? _library!, _library!, current);
                _savedLibrary = current.Copy();
                throw new WorkspaceStoreException("The library changed while saving. Your edits are retained. Try saving again to merge them with the latest version.");
            }
            _savedLibrary = saved.Copy();
            if (version == _editVersion) _library = saved;
            else _library = _library with { Revision = saved.Revision, UpdatedUtc = saved.UpdatedUtc, Reels = saved.Reels, ReelDrafts = saved.ReelDrafts, ReelTrash = saved.ReelTrash, ReelPublications = saved.ReelPublications, Voices = saved.Voices, VoiceTrash = saved.VoiceTrash, Trash = saved.Trash };
        }
        finally { _saveGate.Release(); if (!_disposed) await InvokeAsync(StateHasChanged); }
    }

