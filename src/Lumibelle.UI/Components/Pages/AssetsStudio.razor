    private void CropZoomChanged(ChangeEventArgs args) => _draftCropZoom = ParseRange(args, _draftCropZoom, 1, 4);
    private void CropHorizontalChanged(ChangeEventArgs args) => _draftCropFocusX = ParseRange(args, _draftCropFocusX, 0, 100);
    private void CropVerticalChanged(ChangeEventArgs args) => _draftCropFocusY = ParseRange(args, _draftCropFocusY, 0, 100);
    private static double ParseRange(ChangeEventArgs args, double current, double minimum, double maximum) =>
        double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var value) ? Math.Clamp(value, minimum, maximum) : current;
    private static string Invariant(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    [JSInvokable]
    public void ApplyCropGesture(double zoom, double focusX, double focusY)
    {
        _draftCropZoom = Math.Clamp(zoom, 1, 4);
        _draftCropFocusX = Math.Clamp(focusX, 0, 100);
        _draftCropFocusY = Math.Clamp(focusY, 0, 100);
        StateHasChanged();
    }
    private void ResetSourceCrop()
    {
        if (BaseReference is { } reference) _restoredCrops.Remove(reference);
        _cropAspect = _draftCropAspect = "Original";
        _cropZoom = _draftCropZoom = 1;
        _cropFocusX = _draftCropFocusX = _cropFocusY = _draftCropFocusY = 50;
    }
    private static ImageCropRegion? CropRegion(AssetImage source, string aspect, double zoom, double focusX,
        double focusY)
    {
        zoom = Math.Clamp(zoom, 1, 4); focusX = Math.Clamp(focusX, 0, 100); focusY = Math.Clamp(focusY, 0, 100);
        var sourceRatio = source.Width / (double)source.Height;
        var targetRatio = aspect == "Original" ? sourceRatio : AspectValue(aspect);
        var maxWidth = targetRatio >= sourceRatio ? 1d : targetRatio / sourceRatio;
        var maxHeight = targetRatio >= sourceRatio ? sourceRatio / targetRatio : 1d;
        var width = maxWidth / zoom; var height = maxHeight / zoom;
        var x = (1 - width) * focusX / 100; var y = (1 - height) * focusY / 100;
        if (Math.Abs(x) < 0.000001 && Math.Abs(y) < 0.000001 && Math.Abs(width - 1) < 0.000001 && Math.Abs(height - 1) < 0.000001) return null;
        return new() { X = x, Y = y, Width = width, Height = height };
    }
    private static string CropStageStyle(AssetImage source) => FormattableString.Invariant(
        $"--source-ratio:{source.Width / (double)source.Height:0.######};aspect-ratio:{source.Width}/{source.Height}");
    private string DraftCropStyle(AssetImage source)
    {
        var crop = CropRegion(source, _draftCropAspect, _draftCropZoom, _draftCropFocusX, _draftCropFocusY) ??
            new ImageCropRegion();
        return FormattableString.Invariant($"left:{crop.X * 100:0.###}%;top:{crop.Y * 100:0.###}%;width:{crop.Width * 100:0.###}%;height:{crop.Height * 100:0.###}%");
    }
    private static double AspectValue(string ratio)
    {
        var parts = ratio.Split(':');
        return double.Parse(parts[0], System.Globalization.CultureInfo.InvariantCulture) /
            double.Parse(parts[1], System.Globalization.CultureInfo.InvariantCulture);
    }
