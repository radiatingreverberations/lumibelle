    private async Task<bool> SaveNowAsync()
    {
        _saveDelay?.Cancel();
        await _saveGate.WaitAsync();
        try { return await SavePendingLockedAsync(); }
        finally { _saveGate.Release(); }
    }

    private async Task<bool> SavePendingLockedAsync()
    {
        if (_library is null) return true;
        try
        {
            await ReconcileLibraryLockedAsync();
            var conflicts = 0;
            while (_dirty && _library is not null)
            {
                _saveDelay?.Cancel();
                if (_library.Assets.Any(asset => string.IsNullOrWhiteSpace(asset.Name)))
                { _saveError = "Every asset needs a name."; _saveStatus = "Failed"; return false; }
                // Progress notifications also reconcile the library. Only an actual
                // author save should disable and dim the surrounding controls.
                _saving = true;
                var version = _editVersion; var local = _library;
                _saveStatus = "Saving…"; _saveError = null;
                AssetLibrary saved;
                try { saved = await AssetStore.SaveAsync(local, local.Revision); }
                catch (WorkspaceConflictException) when (++conflicts < 3)
                { await ReconcileLibraryLockedAsync(); continue; }
                if (version == _editVersion)
                { _library = saved; _dirty = false; _saveStatus = "Saved"; }
                else
                { _library = AssetLibraryRebase.Merge(local, _library, saved); _saveStatus = "Unsaved"; }
                _savedLibrary = saved.Copy();
                _conflict = false;
            }
            return true;
        }
        catch (WorkspaceConflictException e) { _saveError = e.Message; _saveStatus = "Conflict"; _conflict = true; return false; }
        catch (WorkspaceStoreException e) { _saveError = e.Message; _saveStatus = "Failed"; return false; }
        finally { _saving = false; }
    }

    private void QueueSave()
    {
        _dirty = true; _saveStatus = "Unsaved"; _saveError = null; _editVersion++;
        _saveDelay?.Cancel(); _saveDelay?.Dispose(); _saveDelay = new();
        _ = DelayedSaveAsync(_saveDelay.Token);
    }

    private async Task DelayedSaveAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(800, token);
            await InvokeAsync(async () =>
            {
                await SaveNowAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

