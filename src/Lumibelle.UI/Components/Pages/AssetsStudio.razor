    private async Task DeleteImageAsync(Guid imageId)
    {
        if (_library is null || _selectedAssetId is not { } assetId) return;
        await _saveGate.WaitAsync();
        try
        {
            if (!await SavePendingLockedAsync() || _library is null) return;
            var version = _editVersion;
            var result = await AssetStore.DeleteImageAsync(Id, assetId, imageId, _library.Revision);
            ApplyStoredMutation(result.Library, version, [new(assetId, imageId)]);
            if (_latestEditBatch is { } batch && batch.AssetId == assetId && batch.Entries.Any(e => e.IsTake && e.Reference.ImageId == imageId))
                batch.HiddenTakeIds.Add(imageId);
            if (_editSourceImageId == imageId) UseCreateMode();
            var projectId = Id; var trashId = result.TrashIds.Single();
            ClearTrashNotification();
            _trashSnackbar = Snackbar.Add("Image moved to Trash for 30 days.", Severity.Normal, options =>
            {
                options.Action = "Undo"; options.RequireInteraction = false; options.VisibleStateDuration = 10000;
                options.OnClick = async _ =>
                {
                    string? error;
                    if (!_disposed && Id == projectId) error = await RestoreReviewedAsync(trashId);
                    else
                    {
                        try { var current = await AssetStore.LoadAsync(projectId); await TrashStore.RestoreImagesAsync(projectId, [trashId], current.Revision); error = null; }
                        catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException) { error = e.Message; }
                    }
                    if (error is not null) Snackbar.Add(error, Severity.Error);
                };
            });
            _focusLibrary = true;
        }
        catch (WorkspaceConflictException e) { _saveError = e.Message; _conflict = true; _saveStatus = "Conflict"; }
        catch (WorkspaceStoreException e) { _saveError = e.Message; _saveStatus = "Failed"; }
        finally { _saveGate.Release(); }
    }

