@inherits ProjectAwareComponent
@using Microsoft.AspNetCore.Components.Sections
@implements IAsyncDisposable
@using lumibelle.Components.AI
@inject IProjectStore Projects
@inject IAssetStore AssetStore
@inject IImageTrashStore TrashStore
@inject IScriptStore Scripts
@inject IReferenceImageGenerator ImageGenerator
@inject IReferenceImageEditor ImageEditor
@inject IAiSettingsStore SettingsStore
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<NavigationLock ConfirmExternalNavigation="@(_dirty || _reviewDraftDirty || _imageDetailsDirty || _deletingAllAssets)" />
<EditSessionRegistration Save="SaveForCloseAsync" />
<PageTitle>Assets · @(_project?.Name ?? "Lumibelle")</PageTitle>
@if (_loadError is not null)
{
    <LoadFailure Title="Couldn’t open the asset library" Error="_loadError" Retry="LoadAsync" />
}
else if (!_loading && (_project is null || _library is null))
{
    <h1>Project not found</h1><p>This project may have moved or is no longer in your library.</p><MudButton Href="/">Back to your projects</MudButton>
}
else
{
    @if (_project is not null) { <ProjectNavigation Project="_project" CurrentStudio="assets" /> }
    <StudioPageHeader Title="Assets studio">
        <div class="assets-header-actions"><span class="save-status @(_saveError is null ? "" : "failed")" role="status">@(_loading ? "Loading…" : _saveStatus)</span><MudButton OnClick="SaveNowAsync" Disabled="@(_loading || !_dirty || _saving)" Variant="Variant.Outlined">Save</MudButton></div>
    </StudioPageHeader>
    @if (_saveError is not null) { <div class="writing-error"><p>@_saveError</p><MudButton OnClick="SaveNowAsync" Size="Size.Small">Retry</MudButton></div> }
    @if (_imageNavigationError is not null) { <p class="writing-error" role="alert">@_imageNavigationError</p> }
    @if (_conflict)
    {
        <div class="writing-notice"><p>Another tab saved newer asset changes. Your local edits are still here.</p><MudButton OnClick="ReloadAsync" Variant="Variant.Outlined" Size="Size.Small">Reload saved version</MudButton></div>
    }
    <StudioWorkspace @ref="_workspace" Studio="Assets" ProjectId="Id" LeftLabel="Library" RightLabel="Asset tools" SelectionKey="@_selectedAssetId.ToString()" Busy="_loading">
        <Status>@if (ImageQueueStatus is { } queueStatus) { <span>@queueStatus</span> } else if (_generating) { <span>Preparing request…</span> } else if (_enhancing) { <span>Enhancing prompt…</span> } else if (_generationError is not null && !ImageErrorIsHistory) { <span>@_generationError</span> }</Status>
        <Left>@if (_loading) {
            <StudioPane Class="asset-library" Label="Asset library"><Header><div class="asset-library-heading"><h2>Assets</h2></div></Header><ChildContent></ChildContent></StudioPane>
        } else if (_library is not null) {
        <StudioPane Class="asset-library" Label="Asset library"><Header>
            <div class="asset-library-heading"><h2>Assets <small>@_library.Assets.Count</small></h2><div class="asset-library-actions"><button @onclick="() => _createOpen = true" aria-label="Create asset" title="Create asset">+</button><MudMenu Icon="@Icons.Material.Outlined.MoreHoriz" AriaLabel="Asset library options" Size="Size.Small" Dense="true"><MudMenuItem role="menuitem" OnClick="OpenAllAssetDeletionAsync" Disabled="@(_library.Assets.Count == 0 || _saving || _deletingAllAssets)" Class="danger-link">Delete all assets…</MudMenuItem></MudMenu></div></div>
            <div class="asset-library-extraction" @ref="_extractionOriginElement"><TextAssistance @ref="_extractionAssist" ProjectId="Id" Studio="TextAssistantStudio.AssetExtraction" Request="ExtractionPresentation" Preparing="_extractionSubmitting" HasError="@(_pendingExtraction is not null)" ReviewRequested="InspectExtraction" CancelRequested="CancelExtraction" Label="Extract from script" Title="Extract assets from script" Notice="@ExtractionCoverageNotice" Disabled="@(_saving || _finishingReview || _deletingAllAssets)" ModelLocked="_extracting" Opened="PrepareExtractionComposerAsync" SelectionChanged="ExtractionModelChanged">
<ChildContent><ExtractionCoverageStatus Summary="@CoverageSummary" Ignored="_ignoreExtractionReminders" IgnoredChanged="IgnoreExtractionRemindersChanged" />@if (_approvedScript is null) { <p>Write a scene in Script before extracting assets.</p> } else { <ScriptCoveragePicker Source="_approvedScript" Reviews="_library!.ExtractionReviews" Selected="_selectedScenes" SelectedChanged="value => _selectedScenes = value" Disabled="_extracting" /> }<p class="context-estimate">Approximate input: ≈@ExtractionTokens.ToString("N0") tokens</p>@if (_extractionError is not null) { <p role="alert">@_extractionError</p> }</ChildContent>
<Actions><MudButton Class="ai-assist-action" OnClick="ExtractAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_extracting || _pendingExtraction is not null || !_extractionReady || _approvedScript is null || _selectedScenes.Count == 0)"><AiAssistIcon />Find assets</MudButton>@if (_pendingExtraction is not null) { <button @onclick="RetryExtractionEnqueueAsync">Retry saving request</button> }</Actions>
</TextAssistance></div>
            <div class="asset-library-search" data-workspace-menu-open="@(_assetCategoryMenuOpen ? "true" : "false")" @onkeydown="AssetCategoryMenuKeyDown">
                <label class="sr-only" for="asset-search">Search assets</label><input id="asset-search" type="search" placeholder="Search assets…" @bind="_search" @bind:event="oninput" @bind:after="RememberAssetPosition" />
                <MudMenu @ref="_assetCategoryMenu" @bind-Open="_assetCategoryMenuOpen" Icon="@(_categoryFilter is null ? Icons.Material.Outlined.FilterAlt : Icons.Material.Filled.FilterAlt)" AriaLabel="@AssetCategoryFilterLabel" title="@AssetCategoryFilterLabel" Class="@($"asset-category-filter {(_categoryFilter is null ? "" : "active")}")" PopoverClass="asset-category-menu" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <div role="menu" aria-label="Asset categories" @onkeydown="AssetCategoryMenuKeyDown">
                    <MudMenuItem role="menuitemradio" aria-checked="@(_categoryFilter is null ? "true" : "false")" AutoClose="false" OnClick="() => SetAssetCategory(null)"><span class="asset-category-option"><span>All assets</span><span class="asset-category-count">@_library.Assets.Count</span><span aria-hidden="true">@(_categoryFilter is null ? "✓" : "")</span></span></MudMenuItem>
                    @foreach (var category in Enum.GetValues<AssetCategory>())
                    {
                        <MudMenuItem role="menuitemradio" aria-checked="@(_categoryFilter == category ? "true" : "false")" AutoClose="false" OnClick="() => SetAssetCategory(category)"><span class="asset-category-option"><span>@CategoryName(category)</span><span class="asset-category-count">@_library.Assets.Count(asset => asset.Category == category)</span><span aria-hidden="true">@(_categoryFilter == category ? "✓" : "")</span></span></MudMenuItem>
                    }
                    </div>
                </MudMenu>
            </div>
</Header><ChildContent>            <AssetLibraryList ProjectId="Id" Items="FilteredAssets" SelectedId="_selectedAssetId" Selected="SelectAssetAsync" Rename="RenameAsset" Delete="id => _deleteAsset = id" MoveRequested="OpenAssetMove" Moved="MoveAsset" ReviewReady="EnhancementReviewAssets" ReviewRequested="ReviewEnhancement" Disabled="@(_saving || _ordering || _deletingAllAssets)" />
            @if (!FilteredAssets.Any()) { <p class="rail-hint">@(_library.Assets.Count == 0 ? "Create an asset or extract ideas from your story." : "No assets match this view.")</p> }
            @if (_orderUndo is not null) { <p role="status" class="rail-hint">Asset moved. <button @onclick="UndoAssetMove" disabled="@_ordering">Undo</button></p> }
</ChildContent></StudioPane>
        }</Left>
        <Center><StudioPane Class="asset-workspace" Label="Asset editor"><Header>
            @if (_loading) { <strong>References</strong> }
            else if (SelectedAsset is { } headerAsset) {
                <div class="asset-identity">
                    <div class="asset-identity-cover">@if ((headerAsset.Images.FirstOrDefault(i => i.IsCover) ?? headerAsset.Images.FirstOrDefault()) is { } cover) { <img src="@ImageUrl(headerAsset.Id, cover.Id)" alt="" /> } else { <MudIcon Icon="@Icons.Material.Outlined.Collections" /> }</div>
                    <div class="asset-identity-copy"><div class="asset-heading">
                    <label class="sr-only" for="asset-name">Name</label><input id="asset-name" class="asset-name" @bind:get="headerAsset.Name" @bind:set="value => NameChanged(new ChangeEventArgs { Value = value })" @bind:event="oninput" />
                    <span class="asset-category-badge">@headerAsset.Category</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(headerAsset.Description)) { <p class="asset-description-preview" title="@headerAsset.Description">@headerAsset.Description</p> }
                    <div class="asset-media-counts"><span>@MediaCount(headerAsset.Images.Count, "image")</span>@if (ReferenceReels.Supports(headerAsset.Category)) { <span>@MediaCount(_library!.Reels.Count(r => r.AssetId == headerAsset.Id), "reel")</span> }@if (headerAsset.Category == AssetCategory.Character) { <span>@MediaCount(headerAsset.Looks.Count(l => !l.Archived), "look")</span><span>@MediaCount(_library!.Voices.Count(v => v.AssetId == headerAsset.Id), "voice")</span> }</div>
                    </div>
                </div>
                <div class="asset-reference-heading"><h2>References <small>@AllGalleryItems.Count()</small></h2><div class="asset-gallery-actions">@if (headerAsset.Category == AssetCategory.Character) { <button class="asset-group-toggle" aria-pressed="@(GalleryGrouped ? "true" : "false")" @onclick="ToggleGalleryGrouping">Group by look</button> }<MudButton OnClick="OpenAssetDetails" Size="Size.Small" aria-label="Edit asset details">Edit details</MudButton>
                </div></div>
                <div class="asset-gallery-toolbar">
                    <label>Show<select aria-label="Filter media" @bind="_presentation.Filter" @bind:after="RememberAssetPosition"><option>All</option><option>Images</option>@if (ReferenceReels.Supports(headerAsset.Category)) { <option>Reels</option> }@if (headerAsset.Category == AssetCategory.Character) { <option>Voices</option> }</select></label>
                    <input type="search" aria-label="Search references" placeholder="Search references…" @bind="_presentation.Search" @bind:event="oninput" @bind:after="RememberAssetPosition" />
                    @if (headerAsset.Category == AssetCategory.Character) { <label>Look<select @ref="_galleryLookFilter" aria-label="Gallery look" @bind="_lookFilter" @bind:after="RememberAssetPosition"><option value="all">All looks</option><option value="general">General / unassigned</option>@foreach (var look in headerAsset.Looks) { <option value="@look.Id">@look.Name @(look.Archived ? "· Archived" : "")</option> }</select></label> }
                    <details class="asset-import-menu"><summary>Import…</summary><div><label class="import-button">Import image<InputFile OnChange="ImportAsync" accept="image/png,image/jpeg,image/webp" /></label>@if (ReferenceReels.Supports(headerAsset.Category)) { <button @onclick="ImportReel">Import reel</button> }@if (headerAsset.Category == AssetCategory.Character) { <button @onclick="ImportVoice">Import voice</button> }</div></details>
                    <button class="bulk-mode" aria-pressed="@(_presentation.Multiple ? "true" : "false")" @onclick="ToggleMultiple">@(_presentation.Multiple ? "Done selecting" : "Select multiple")</button>
                </div>
            }
        </Header><ChildContent>
            @if (_loading) { <p class="field-hint" role="status">Loading assets…</p> }
            else if (SelectedAsset is not { } asset) { <section class="asset-empty"><h2>Build a visual vocabulary.</h2><p>Create a character, environment, or prop, then collect the views that define it.</p><MudButton OnClick="() => _createOpen = true">Create your first asset</MudButton></section> }
            else {
                @if (_presentation.Multiple && _lookImageSelection.Count > 0) {
                            <div class="look-bulk" role="group" aria-label="Assign selected images"><span>@_lookImageSelection.Count selected</span>
                                <button disabled="@_composerLocked" @onclick="() => OpenImageMove(_lookImageSelection)">Move selected to asset…</button>
                                @if (asset.Category == AssetCategory.Character) { <label>Move selected to look<select aria-label="Move selected to look" @bind="_bulkLook"><option value="">General / unassigned</option>@foreach (var look in asset.Looks.Where(l => !l.Archived)) { <option value="@look.Id">@look.Name</option> }</select></label><button disabled="@(_generating || _enhancing)" @onclick="AssignSelectedLooks">Assign selected</button> }
                                <button disabled="@(_saving || !CanTrashSelection)" title="Only unapproved generated images can be discarded together." @onclick="TrashSelectedImages">Move selected to Trash</button><button @onclick="() => _lookImageSelection.Clear()">Clear selection</button></div>
                }
                <span class="sr-only" role="status">@_lookNotice</span>
                <div class="asset-gallery-groups" aria-label="Asset references">
                @foreach (var group in GalleryGroups) {
                <details class="asset-gallery-group @(GalleryGrouped ? "grouped" : "flat")" open @key="group.Key">
                    <summary hidden="@(!GalleryGrouped)"><span class="asset-look-heading"><strong>@group.Name <small>@group.Items.Count</small></strong>@if (group.Archived) { <span class="asset-look-archived">Archived</span> }@if (!string.IsNullOrWhiteSpace(group.Description)) { <span class="asset-look-description" title="@group.Description">@group.Description</span> }</span></summary>
                <div class="reference-grid asset-media-gallery" data-scroll-region="@($"gallery:{group.Key}")">
                @foreach (var item in group.Items) {
                    var selected = _presentation.Selection == item.Key;
                    var mediaLabel = item.Reel is { } r ? $"Reel · {r.Media.Duration:0.###} s" : item.Voice is { } v ? $"Voice · {v.ExcerptDuration:0.##} s excerpt" : "Image";
                    var mediaLabelId = $"asset-media-type-{item.Key.Kind}-{item.Key.Id}";
                    var lookLabel = asset.Category == AssetCategory.Character && item.Key.Kind != AssetMediaKind.Voice
                        ? asset.Looks.FirstOrDefault(l => l.Id == item.LookId)?.Name ?? "General" : null;
                    var mediaDescriptionIds = lookLabel is null ? mediaLabelId : $"{mediaLabelId} {mediaLabelId}-look";
                    if (item.Reel is not null) mediaDescriptionIds += $" {mediaLabelId}-resolution";
                    <article @key="item.Key" data-media-id="@item.Key.Id" data-media-kind="@item.Key.Kind" class="reference-card asset-media-card @(selected ? "selected" : "") @(item.Image?.IsReference == true ? "approved" : "")">
                        <button class="reference-image media-preview" aria-label="Preview @(item.Image is not null ? "image" : item.Key.Kind.ToString()) @item.Name" aria-describedby="@mediaDescriptionIds" @onclick="() => PreviewMedia(item)">
                            @if (item.Image is { } thumbnail) { <img src="@ImageUrl(asset.Id, thumbnail.Id)" alt="@ImageAlt(asset, thumbnail)" loading="lazy" />@if (thumbnail.IsReference) { <span class="reference-badge">APPROVED</span> } }
                            else if (item.Reel is { } clip) { <ReferenceVideoThumbnail ProjectId="Id" MediaId="clip.Media.Id" /> }
                            else { <span class="voice-card-icon" aria-hidden="true">♫</span> }
                            @if (item.Voice is { } defaultVoice && asset.DefaultVoiceId == defaultVoice.Id) { <span class="media-look-badge">Default voice</span> }
                            @if (lookLabel is not null) { <span id="@(mediaLabelId + "-look")" class="media-look-badge" title="@lookLabel" aria-label="Look: @lookLabel">@lookLabel</span> }
                            @if (item.Reel is { } resolutionReel) {
                                <span id="@(mediaLabelId + "-resolution")" class="media-resolution-badge" title="@VideoResolutions.Dimensions(resolutionReel)"><span class="sr-only">Resolution: </span>@VideoResolutions.Badge(resolutionReel)<span class="sr-only"> · @VideoResolutions.Dimensions(resolutionReel)</span></span>
                            }
                            <span class="media-type-badge" title="@mediaLabel">
                                <MudIcon Icon="@(item.Key.Kind == AssetMediaKind.Reel ? Icons.Material.Outlined.Videocam : item.Key.Kind == AssetMediaKind.Voice ? Icons.Material.Outlined.GraphicEq : Icons.Material.Outlined.Image)" Size="Size.Small" aria-hidden="true" />
                                @if (item.Reel is { } badgeReel) { <span aria-hidden="true">@badgeReel.Media.Duration.ToString("0.###") s</span> }
                                else if (item.Voice is { } badgeVoice) { <span aria-hidden="true">@badgeVoice.ExcerptDuration.ToString("0.##") s</span> }
                                <span id="@mediaLabelId" class="sr-only">@mediaLabel</span>
                            </span>
                        </button>
                        <div class="reference-card-body">
                            <button class="media-select" aria-pressed="@(selected ? "true" : "false")" aria-label="Select @item.Key.Kind @item.Name" title="@item.Name" @onclick="() => SelectMedia(item.Key)"></button>
                            <div class="media-card-heading">
                                <strong class="media-name">@item.Name</strong>
                                <div class="reference-actions">
                                @if (item.Image is { } image) {
                                    @if (_presentation.Multiple) { <input type="checkbox" aria-label="Select image" checked="@_lookImageSelection.Contains(image.Id)" @onchange="e => SelectLookImage(image.Id, e)" /> }
                                    <ReferenceImageMenu Image="image" Rename="() => RenameMedia(item.Key)" EditDetails="() => OpenDetails(image.Id)" Crop="() => OpenImageCopy(image)" Move="() => OpenImageMove([image.Id])"
                                        CreateSimilar="() => CreateSimilarFromGallery(image.Id)" CreateSimilarDisabled="@(!CanCreateSimilar(image))"
                                        ChangeLook="@(asset.Category == AssetCategory.Character ? EventCallback.Factory.Create(this, () => OpenGalleryLook(asset.Id, item)) : default(EventCallback))" ChangeLookDisabled="@(_saving || _selectionChanging || _imageDetailsDirty)"
                                        ToggleReference="() => ToggleReference(image.Id)" MakeCover="() => MakeCover(image.Id)" Trash="() => DeleteImageAsync(image.Id)"
                                        CropDisabled="@(_generating || _enhancing)" MoveDisabled="_composerLocked" DeleteDisabled="_saving" />
                                } else {
                                    <MudMenu Icon="@Icons.Material.Outlined.MoreHoriz" AriaLabel="@($"Actions for {item.Name}")" Size="Size.Small" Dense="true">
                                        <MudMenuItem role="menuitem" OnClick="() => RenameMedia(item.Key)" Disabled="@(_saving || _selectionChanging || _imageDetailsDirty)">Rename</MudMenuItem>
                                        <MudMenuItem role="menuitem" OnClick="() => OpenMediaDetails(item.Key)">Edit details</MudMenuItem>
                                        @if (item.Reel is { } keyframeReel) { <MudMenuItem role="menuitem" OnClick="() => _reels!.ManageKeyframes(keyframeReel)">Manage keyframes…</MudMenuItem> }
                                        <MudMenuItem role="menuitem" OnClick="() => OpenMediaMove(item.Key)" Disabled="@(_saving || _selectionChanging)">Move to asset…</MudMenuItem>
                                        @if (asset.Category == AssetCategory.Character && item.Reel is not null) { <MudMenuItem role="menuitem" OnClick="() => OpenGalleryLook(asset.Id, item)" Disabled="@(_saving || _selectionChanging || _imageDetailsDirty)">Change look…</MudMenuItem> }
                                        @if (asset.Category == AssetCategory.Character && item.Reel is { Media.HasAudio: true } audioReel) { <MudMenuItem role="menuitem" OnClick="() => SaveReelVoice(audioReel)">Save voice…</MudMenuItem> }
                                        @if (item.Voice is { } voiceItem) { <MudMenuItem role="menuitem" OnClick="() => _voices!.ToggleDefault(voiceItem)">@(asset.DefaultVoiceId == voiceItem.Id ? "Clear default voice" : "Make default voice")</MudMenuItem> }
                                        @if (item.Reel is { Generation: not null } reel) { <MudMenuItem role="menuitem" Disabled="@(_reels?.CanVary(reel) != true)" OnClick="() => VaryReel(reel)">Create similar</MudMenuItem><MudMenuItem role="menuitem" OnClick="() => _reels!.Regenerate(reel)">Regenerate…</MudMenuItem> }
                                        @if (item.Reel is { } replacing && _reels?.CanReplace(replacing) == true) { <MudMenuItem role="menuitem" OnClick="() => _reels!.ReplaceInShots(replacing)">Replace in shots…</MudMenuItem> }
                                        <MudDivider />
                                        <MudMenuItem role="menuitem" Class="danger-link" OnClick="() => TrashMedia(item)">Move to Trash</MudMenuItem>
                                    </MudMenu>
                                }
                                </div>
                            </div>
                        </div>
                    </article>
                }
                </div></details>
                }
                </div>
                @if (!GalleryItems.Any()) {
                    <div class="reference-empty">@if (AllGalleryItems.Any()) { <strong>No references match this view.</strong><p>Try another search or look.</p><button @onclick="ResetGalleryFilters">Clear filters</button> } else { <strong>No references yet.</strong><p>Import media or create the first reference for @asset.Name.</p><button @onclick="EnterCreate">Create reference</button> }</div>
                }
                @if (ReferenceReels.Supports(asset.Category)) { <ReferenceReelsPanel RegisterPanel="RegisterReelPanel" ClearCreationAvailabilityChanged="_ => StateHasChanged()" SaveVoiceRequested="SaveReelVoice" Embedded="true" RegisterFlush="RegisterReelFlush" ToolsSection="_reelToolsSection" DetailsSection="_reelDetailsSection" SelectedReelId="@(_presentation.Selection is { Kind: AssetMediaKind.Reel } reelSelection ? reelSelection.Id : null)" RevealTools="RevealReelTools" RevealPrompts="RevealReelPrompts" @key="(asset.Id, AssetMediaKind.Reel)" ProjectId="Id" AssetId="asset.Id" Library="_library" Mutate="MutateVoiceAsync" RequestedJobId="RequestedJobId" /> }
                @if (asset.Category == AssetCategory.Character) { <VoiceReferencesPanel RegisterPanel="RegisterVoicePanel" Embedded="true" ToolsSection="_voiceToolsSection" SelectedVoiceId="@(_presentation.Selection is { Kind: AssetMediaKind.Voice } voiceSelection ? voiceSelection.Id : null)" @key="(asset.Id, AssetMediaKind.Voice)" ProjectId="Id" AssetId="asset.Id" Library="_library" Mutate="MutateVoiceAsync" /> }
            }
        </ChildContent><Footer>@if (!_loading && _library is not null && AssetStore is IAssetReuseStore) {
            <AssetReuseTools @key="Id" Library="_library" AssetId="_selectedAssetId" MediaId="@(_presentation.Selection?.Id)" MediaKind="@(_presentation.Selection?.Kind.ToString())"
                Disabled="@(_saving || _deletingAllAssets || _finishingReview || _selectionChanging)" ClipboardDirty="@(_dirty || _imageDetailsDirty)"
                Prepare="PrepareAssetReuseAsync" Changed="AssetReuseChangedAsync" />
        }</Footer></StudioPane></Center>
        <Right><div class="asset-tool-shell">
        @if (_loading) { <header class="asset-tools-header"><strong>Asset tools</strong></header> }
        else {
        <header class="asset-tools-header @(_presentation.Selection is null ? "compact-creation-header" : "")">
            <div class="asset-tool-heading"><h2 id="assets-tool-heading">@ToolOperation</h2>@if (_presentation.Selection is not null) { <button type="button" disabled="@(_selectionChanging || _clearingCreation)" @onclick="ClearMediaSelection" aria-label="Clear selection" title="Deselect and return to Create"><span aria-hidden="true">×</span></button> } else if (SelectedAsset is not null) { <button type="button" disabled="@(!CanClearCreation)" @onclick="ClearCreationFields" aria-label="Clear creation fields" title="Clear draft content"><span aria-hidden="true">×</span></button> }</div>
            @if (_creationClearError is not null) { <p class="field-error" role="alert">@_creationClearError</p> }
            @if (_presentation.Selection is { } selection) {
                @* One compact context for the selection: its name, then its asset (unless named the same) and look. *@
                <div class="asset-tool-context selection-context"><strong>@SelectedMediaName</strong><span>@(SelectedAsset is { } owner && owner.Name != SelectedMediaName ? $"{owner.Name} · {SelectedMediaLook}" : SelectedMediaLook)</span></div>
                @if (!GalleryItems.Any(i => i.Key == selection)) { <button class="reveal-selection" @onclick="RevealSelectedMedia">Reveal in gallery</button> }
            }
            else {
                @if (SelectedAsset is { Category: AssetCategory.Character } && _presentation.Creation == AssetCreationKind.Image) { <div class="asset-tool-context"><span>Look · @(TargetLook?.Name ?? "General")</span></div> }
                <label>Create<select aria-label="Create media type" disabled="@_clearingCreation" value="@_presentation.Creation" @onchange="ChangeCreation"><option value="@AssetCreationKind.Image">Image</option>@if (SelectedAsset is { } selectedAsset && ReferenceReels.Supports(selectedAsset.Category)) { <option value="@AssetCreationKind.Reel">Reference reel</option> }</select></label>
            }
        </header><fieldset disabled="@(_selectionChanging || _clearingCreation)" id="assets-tools-content" aria-labelledby="assets-tool-heading" class="asset-tool-content">
        <div class="asset-tool-mode" hidden="@(!ShowImageTools)"><StudioPane Class="generation-panel" Label="Reference image creation and editing">

            <ChildContent>
                @if (SelectedAsset is null) { <p class="field-hint">Choose or create an asset before generating.</p> }
                else
                {
                    @if (_targetLookId is not null) { <p class="field-hint image-destination">Saved draft destination: @(TargetLook?.Name ?? "Unavailable look") <button @onclick="() => _targetLookId = null">Use unassigned</button></p> }
                    <section class="image-prompt-fields">                <label for="asset-image-workflow">Image workflow</label>
                <div class="image-workflow-select">
                <span class="connection-indicator @(_checkingImages ? "checking" : CurrentImageConfigurationReady ? "ready" : "")" title="@CurrentImageConfigurationLabel" aria-hidden="true"></span>
                <select id="asset-image-workflow" aria-describedby="image-workflow-status" @bind="_imageWorkflow" @bind:after="ImageWorkflowChanged" disabled="@(_generating || _checkingImages || _refreshingLoras)">
                    @foreach (var workflow in Enum.GetValues<ImageWorkflow>()) { <option value="@workflow">@workflow.Label()</option> }
                </select>
                <span id="image-workflow-status" class="visually-hidden" role="status">@CurrentImageConfigurationLabel</span>
                </div>
                @if (!_checkingImages && !CurrentImageConfigurationReady) { <p class="field-hint image-workflow-issue">@CurrentImageConfigurationMessage <a href="@(AiSettingsNavigation.Link(Navigation, projectId: Id, returnTo: "assets"))">AI settings</a></p> }
                <label for="image-prompt">@(_presentation.Edit ? "Edit instruction" : "Image prompt")</label><textarea id="image-prompt" disabled="@_generating" rows="8" @bind="_imagePrompt" @bind:event="oninput" placeholder="@(IsEditMode ? "Describe what should change while preserving the source…" : "Describe one clear reference view…")"></textarea>
                <PromptEnhancementPanel @key="SelectedAsset.Id" RequestedJobId="RequestedEnhancementJobId" RequestedJobHandled="HandleEnhancementNavigation" Restore="RestoreEnhancementSetup" Context="EnhancementContext()" Disabled="@(_generating || _checkingImages)"
                    BusyChanged="value => { if (!_disposed) _enhancing = value; }" Apply="ApplyEnhancedPrompt" FindImage="FindImage" />
</section>
                    <section class="image-reference-fields">
                    @if (IsEditMode) {
                        <button class="manage-image-inputs" @onclick="OpenImageInputs" disabled="@_composerLocked">Manage references</button>
                        @foreach (var input in CurrentImageInputs) { var number = CurrentImageInputs.ToList().IndexOf(input) + 1; var picture = FindImage(input);
                            <button class="compact-image-input" @onclick="OpenImageInputs" disabled="@_composerLocked"><CropThumbnail Url="@ImageUrl(input.AssetId, input.ImageId)" Width="@(picture?.Width ?? 1)" Height="@(picture?.Height ?? 1)" Crop="@(input == BaseReference ? SourceCrop : ReferenceCrop(input))" Label="@($"Image {number}")" /><span><strong>Image @number · @(number == 1 ? "Source" : "Reference")</strong><small>@ReferenceLabel(input) · @((input == BaseReference ? SourceCrop : ReferenceCrop(input)) is null ? "Full image" : "Cropped")@(_regions.TryGetValue(input, out var region) ? $" · {region.Mode} active" : "")</small></span></button>
                        }
                        @if (ReferenceInputError is { } issue) { <p role="alert">@issue</p> }
                    }
                @if (!IsCodex && _settings is not null)
                {
                    <button type="button" class="image-loras-button" @onclick="RevealImageLoras" disabled="@(_composerLocked || _checkingImages || !_visibilityReady)" aria-label="@($"LoRAs, {ActiveImageLoras} active")">LoRAs <span class="image-loras-count" aria-hidden="true">@ActiveImageLoras</span></button>
                }
</section>
                <details class="image-generation-settings">
                    <summary>Image settings</summary>
                    <div class="image-settings-fields">
                    @if (IsQwen) {
                        <fieldset class="qwen-image-options" disabled="@_composerLocked" aria-label="Qwen image settings">
                            <label for="qwen-image-steps">Steps</label>
                            <input id="qwen-image-steps" type="number" min="1" max="100" value="@_qwenOptions.Steps" @onchange="ChangeQwenSteps" />
                        </fieldset>
                    }
                    @if (!IsCodex)
                    {
                        <div class="generation-advanced">
                            <label for="fixed-seed">Seed <span>(blank for fresh)</span></label>
                            <input id="fixed-seed" disabled="@_composerLocked" inputmode="numeric" @bind="_fixedSeed" @bind:event="oninput" />
                            @if (IsEditMode && !IsKlein && !IsQwen)
                            {
                                @if (_additionalReferences.Count > 0)
                                {
                                    <label for="base-reference-boost">Base fidelity <span>(0–10)</span></label>
                                    <input id="base-reference-boost" disabled="@_composerLocked" type="number" min="0" max="10" step="0.25" @bind="_baseReferenceBoost" />
                                }
                                <label for="reference-boost">@(_additionalReferences.Count > 0 ? "Second-reference fidelity" : "Reference fidelity") <span>(0–10)</span></label>
                                <input id="reference-boost" disabled="@_composerLocked" type="number" min="0" max="10" step="0.25" @bind="_referenceBoost" />
                                <label for="grounding-pixels">Grounding resolution</label>
                                <select id="grounding-pixels" disabled="@_composerLocked" @bind="_groundingPixels">
                                    @foreach (var pixels in GroundingSizes) { <option value="@pixels">@pixels px</option> }
                                </select>
                            }
                        </div>
                    }
                        <div class="generation-tags">
                            <label for="image-tags">Tags for these takes</label><input id="image-tags" disabled="@_composerLocked" @bind="_imageTags" @bind:event="oninput" placeholder="face, neutral expression" />
                            <div class="tag-shortcuts">@foreach (var tag in SuggestedTags(SelectedAsset!.Category)) { <button disabled="@_composerLocked" @onclick="() => AddGenerationTag(tag)">+ @tag</button> }</div>
                        </div>
                        @if (IsQwen) {
                            <details class="image-workflow-help"><summary>Workflow notes</summary>
                                @if (IsEditMode) { <p class="field-hint">From Image 1 follows its crop. An explicit aspect changes the output canvas. Use &lt;image1&gt; for the source and &lt;image2&gt; … &lt;image10&gt; for references. Edit/Protect keeps fixed placement and restores protected pixels when you save the reviewed result.</p> }
                                <p class="field-hint">Larger resolutions and more references use more memory. Original input sizes are rounded to 32 pixels. The default is 25 steps.</p>
                            </details>
                        }
                    </div>
                </details>
                }
            </ChildContent>
            <Footer><div @ref="_imageOriginElement">@if (SelectedAsset is not null) {
                <div class="asset-output-options" role="group" aria-label="Image output options">
                    <div class="generation-options">
                        <label for="aspect">Aspect
                                <select id="aspect" disabled="@_composerLocked" @bind="ImageAspect">
                                    <option value="@ImageAspectPolicy.FromImage1" disabled="@(!IsEditMode)">From Image 1</option>
                                    @foreach (var ratio in AspectRatios) { <option>@ratio</option> }
                                </select>
                        </label>
                        <label for="candidate-count">Takes
                            <select id="candidate-count" disabled="@_composerLocked" @bind="_candidateCount">
                                @for (var i = 1; i <= 4; i++) { <option value="@i">@i</option> }
                            </select>
                        </label>
                    </div>
                    @if (!IsCodex) {
                        <div class="image-resolution-options">
                            <label for="image-resolution">Resolution</label>
                            <select id="image-resolution" disabled="@_composerLocked" value="@ImageResolution" @onchange="ChangeImageResolution">
                                <option value="1024">1K · ~1 MP</option>
                                <option value="1440">1440 · ~2 MP</option>
                                <option value="2048">2K · ~4 MP</option>
                                @if (IsQwen && IsEditMode) { <option value="0">Original input sizes</option> }
                            </select>
                            <span class="field-hint image-output-size">@ImageOutputLabel</span>
                        </div>
                    }
                </div>
                @if (QwenOptionsIssue is { } qwenIssue) { <p class="field-error" role="alert">@qwenIssue <button data-workspace-focus="#image-resolution">Review settings</button></p> }
                @if (SelectedRecipeImage is { } recipeImage) {
                    <button type="button" class="create-similar" @onclick="CreateSimilarImage" disabled="@(!CanCreateSimilarImage)" title="@(recipeImage.Generation is null ? "No saved creation recipe is available for this image." : "Load the saved prompt, inputs and settings into Create.")">Create similar</button>
                }
                @if (IsEditMode && ReferenceInputError is { } inputIssue) { <p role="alert">@inputIssue <button @onclick="OpenImageInputs">Review inputs</button></p> }
                <MudButton OnClick="GenerateAsync" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Disabled="@(!CanRunImageOperation)">@(_generating ? "Preparing request…" : _presentation.Edit ? "Generate edited images" : "Generate images")</MudButton>
                @if (ImageQueueFull && !_generating) { <p class="field-hint" role="status">@AiJobLocks.ImageLimitMessage</p> }
                @if (LoraError is { } loraError) { <p class="generation-error" role="alert">@loraError <button @onclick="RevealImageLoras">Review LoRAs</button></p> }
                @if (!IsCodex && _visibilityError is not null)
                { <p class="generation-error" role="alert">Project LoRA visibility couldn’t be loaded: @_visibilityError</p><MudButton OnClick="CheckImageWorkflowAsync" Disabled="@(_generating || _checkingImages)">Retry project visibility</MudButton> }
                @if (_latestEditBatch is { } latest && latest.AssetId == _selectedAssetId && latest.CompletedCandidates.Count > 0)
                { <div class="image-history-summary"><MudButton OnClick="ReviewLatestEdit" Size="Size.Small">@ReviewImagesLabel</MudButton><span>@LatestImageBatchSummary</span></div> }
                @if (ActiveImageJobs is { Length: > 0 } imageJobs) {
                    @* With several requests, queued ones stay one line so the composer keeps its room; working ones show their progress. *@
                    <section class="asset-image-requests" aria-label="Image requests for this asset">
                        @if (imageJobs.Length > 1 && imageJobs.Count(j => j.State == AiJobState.Waiting) is > 0 and var queued) {
                            <p class="field-hint asset-image-requests-summary" role="status">@queued queued@(imageJobs.Any(j => j.State == AiJobState.Waiting && AiJobs.View.Paused.Contains(j.Backend)) ? " · This provider queue is paused." : "")</p>
                        }
                        @foreach (var imageJob in imageJobs) {
                            var compact = imageJobs.Length > 1 && imageJob.State == AiJobState.Waiting;
                            var position = ImageQueuePosition(imageJob);
                            <div class="asset-image-request @(compact ? "is-compact" : "")" @key="imageJob.Id" data-job-id="@imageJob.Id">
                                @if (compact) {
                                    <p class="asset-image-request-prompt" title="@($"Queued · position {position} · {ImageRequestPrompt(imageJob)}")"><span class="asset-image-request-hidden">Queued, position @position: </span><span aria-hidden="true">@($"#{position} ")</span>@ImageRequestPrompt(imageJob)</p>
                                    <div class="asset-image-request-actions"><MudButton OnClick="() => ViewImageRequestAsync(imageJob)" Size="Size.Small" aria-label="View request">View</MudButton>@if (!imageJob.CancelRequested) { <MudButton OnClick="() => CancelGeneration(imageJob)" Size="Size.Small">Cancel</MudButton> }</div>
                                } else {
                                    <p class="asset-image-request-prompt" title="@ImageRequestPrompt(imageJob)">@ImageRequestPrompt(imageJob)</p>
                                    <AiJobProgressView Job="imageJob" Queue="AiJobs.View" Progress="@AiJobs.Progress(imageJob.Id)" />
                                    <div class="asset-image-request-actions"><MudButton OnClick="() => ViewImageRequestAsync(imageJob)" Size="Size.Small">View request</MudButton>@if (!imageJob.CancelRequested) { <MudButton OnClick="() => CancelGeneration(imageJob)" Size="Size.Small">Cancel</MudButton> }</div>
                                }
                            </div>
                        }
                    </section>
                }
                @if (PendingImage is not null) { <p role="alert">The request could not be confirmed. Retry this exact request without creating a duplicate.</p><MudButton OnClick="RetryImageEnqueueAsync" Disabled="@_generating">Retry queueing</MudButton> }
                else if (_generationError is not null && !ImageErrorIsHistory) { <p class="generation-error" role="alert">@_generationError @if (_generationError.StartsWith("Seed must", StringComparison.Ordinal)) { <button data-workspace-focus="#fixed-seed">Edit seed</button> }</p> }
 }</div></Footer>
        </StudioPane></div>
        <div class="asset-tool-mode" hidden="@(!ShowReelTools)"><SectionOutlet SectionId="_reelToolsSection" /></div>
        <div class="asset-tool-mode" hidden="@(_presentation.Selection?.Kind != AssetMediaKind.Reel)"><SectionOutlet SectionId="_reelDetailsSection" /></div>
        <div class="asset-tool-mode" hidden="@(_presentation.Selection?.Kind != AssetMediaKind.Voice)"><SectionOutlet SectionId="_voiceToolsSection" /></div>
        </fieldset>
        }</div></Right>
    </StudioWorkspace>
}

<InlineDialog @bind-Visible="_imageLorasOpen" Class="image-loras-dialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true })"
              Title="Image LoRAs" Context="@SelectedAsset?.Name" CloseLabel="Close image LoRAs">
    <Summary>@_imageWorkflow.Label()</Summary>
    <DialogContent>
        @if (_imageLorasOpen && _settings is { } loraSettings) {
            <LoraPicker @key="(_selectedAssetId, _imageWorkflow)" Settings="loraSettings" Workflow="_imageWorkflow.LoraWorkflow()" Selections="_imageLoraDraft" Check="_loraCheck"
                Visibility="_loraVisibility" Disabled="@(_composerLocked || _checkingImages || !_visibilityReady)" Changed="selections => _imageLoraDraft = selections.ToArray()" Refresh="RefreshLorasAsync"
                InsertTrigger="StageImageLoraTrigger" TriggerButtonText="Add trigger on apply" ProjectSettingsUrl="@(ProjectLink(Id, "/settings"))"
                ValidityChanged="valid => _imageLoraDraftValid = valid" ManageUrl="@(AiSettingsNavigation.Link(Navigation, "loras", Id, "assets"))" />
            @if (_imageLoraTriggers.Count > 0) { <p class="field-hint" role="status">@_imageLoraTriggers.Count trigger(s) will be added to the prompt.</p> }
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="() => _imageLorasOpen = false">Cancel</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyImageLoras" Disabled="@(!_imageLoraDraftValid || _composerLocked || _checkingImages || !_visibilityReady)">Apply changes</MudButton></DialogActions>
</InlineDialog>

<InlineDialog Visible="_assetDetailsOpen" VisibleChanged="async v => { if (!v) await CloseAssetDetails(); }" Class="asset-details-dialog" DefaultFocus="DefaultFocus.FirstChild" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false })"
              Title="@($"{SelectedAsset?.Name} · Details")" CloseLabel="Close asset details" CloseDisabled="_saving">
    <DialogContent><div @onkeydown="AssetDetailsKeyDown">
        @if (SelectedAsset is { } detailsAsset && _library is not null) {
            <div class="asset-editor">
                    <label for="asset-details-name">Asset name</label><input id="asset-details-name" maxlength="200" @bind:get="detailsAsset.Name" @bind:set="value => NameChanged(new ChangeEventArgs { Value = value })" @bind:event="oninput" />
                    <label for="asset-description">@(detailsAsset.Category == AssetCategory.Character ? "Character identity notes" : "Visual notes")</label><textarea id="asset-description" rows="5" @bind:get="detailsAsset.Description" @bind:set="value => DescriptionChanged(new ChangeEventArgs { Value = value })" @bind:event="oninput" placeholder="Describe the asset's appearance and visual context."></textarea>
                    @if (detailsAsset.Category == AssetCategory.Character) { <label for="default-character-voice">Default voice</label><select id="default-character-voice" value="@detailsAsset.DefaultVoiceId" @onchange="DefaultVoiceChanged"><option value="">No default voice</option>@foreach (var voice in _library.Voices.Where(v => v.AssetId == detailsAsset.Id)) { <option value="@voice.Id">@voice.Name</option> }</select><p class="field-hint">Shared across looks. Used in new speaking setups and fresh reel recipes.</p> }
                    @if (ReferenceReels.Supports(detailsAsset.Category)) {
                        <ReelUsageDefaultSelect Asset="detailsAsset" Changed="value => EditSelected(asset => asset with { DefaultReelVisuals = value })" />
                    }
                    <details class="asset-preservation" open="@(RequestedAssetId == detailsAsset.Id || _linkedAssetId == detailsAsset.Id)"><summary>Keep consistent in shots</summary>
                        <div class="field-label-help"><label for="asset-preservation">@(detailsAsset.Category == AssetCategory.Character ? "Character identity" : "Asset features")</label><HelpHint Label="Keep consistent in shots" Text="@((detailsAsset.Category == AssetCategory.Character ? "Face and proportions belong to the character; clothing and styling belong to a look. Details specific to one reference belong to its image." : "Describe the recognizable layout, proportions or materials of this asset.") + " These are prompt instructions for Shots, not guaranteed constraints.")" /></div><textarea id="asset-preservation" rows="3" maxlength="12000" @bind:get="detailsAsset.PreservationGuidance" @bind:set="value => PreservationChanged(new ChangeEventArgs { Value = value })" @bind:event="oninput" placeholder="For example: preserve her face and proportions."></textarea>
                        <GuidanceSuggestion @key="detailsAsset.Id" Context="@(GuidanceContext.From(new(Id, detailsAsset.Id, detailsAsset.Category == AssetCategory.Character ? GuidanceScope.CharacterIdentity : GuidanceScope.AssetFeatures), detailsAsset))" Library="_library" Disabled="@(_generating || _enhancing)" RequestedJobId="_requestedGuidanceId" Apply="value => PreservationChanged(new ChangeEventArgs { Value = value })" />
                    </details>
                    @if (detailsAsset.SuggestedImageTags.Count > 0)
                    {
                        <div class="suggested-tags"><span>Suggested references</span>@foreach (var tag in detailsAsset.SuggestedImageTags) { <button @onclick="() => AddGenerationTag(tag)">@tag</button> }</div>
                    }
                    @if (detailsAsset.Evidence.Count > 0)
                    {
                        <details class="asset-evidence"><summary>Script evidence · @detailsAsset.Evidence.Count</summary>@foreach (var evidence in detailsAsset.Evidence) { <blockquote><strong>@evidence.Label</strong><span>@evidence.Excerpt</span><small>@EvidenceStatus(evidence)</small></blockquote> }</details>
                    }
                    @if (detailsAsset.Category == AssetCategory.Character) { <CharacterLooksPanel @key="detailsAsset.Id" Asset="detailsAsset" Library="_library" Filter="@_lookManagementFilter" FilterChanged="v => _lookManagementFilter = v" Changed="UpdateLooks" Disabled="_saving" RequestedJobId="_requestedGuidanceId" /> }
            </div>
        }
        @if (_saveError is not null) { <p role="alert" class="writing-error">@_saveError</p> }
        @if (_conflict) { <p class="writing-notice">Another tab saved newer asset changes. Your local edits are still here.</p><MudButton OnClick="ReloadAsync" Size="Size.Small">Reload saved version</MudButton> }
    </div></DialogContent>
    <DialogActions><div class="asset-details-actions" @onkeydown="AssetDetailsKeyDown">
        <span class="asset-details-save-status" role="status">@_saveStatus</span>
        @if (_saveError is not null) { <MudButton OnClick="SaveNowAsync" Disabled="_saving">Retry save</MudButton> }
        <MudButton OnClick="CloseAssetDetails" Disabled="_saving">Close</MudButton>
    </div></DialogActions>
</InlineDialog>

<InlineDialog Visible="_createOpen" VisibleChanged="v => { if (!v) CloseCreate(); }" Class="asset-dialog" DefaultFocus="DefaultFocus.FirstChild" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })"
              Title="Create an asset" CloseLabel="Close create an asset">
    <DialogContent><form id="create-asset-form" @onsubmit="CreateAssetAsync" @onsubmit:preventDefault><label for="new-asset-kind">Kind</label><select id="new-asset-kind" @bind="_newCategory">@foreach (var category in Enum.GetValues<AssetCategory>()) { <option value="@category">@CategoryName(category)</option> }</select><label for="new-asset-name">Name</label><input id="new-asset-name" @bind="_newName" @bind:event="oninput" /><label for="new-asset-description">Visual notes</label><textarea id="new-asset-description" rows="4" @bind="_newDescription" @bind:event="oninput"></textarea>@if (_createError is not null) { <p class="generation-error">@_createError</p> }</form></DialogContent>
    <Actions><MudButton OnClick="CloseCreate">Cancel</MudButton><MudButton ButtonType="ButtonType.Submit" form="create-asset-form" Color="Color.Primary" Variant="Variant.Filled">Create asset</MudButton></Actions>
</InlineDialog>
<InlineDialog Visible="@(_moveSource is not null)" VisibleChanged="v => { if (!v) CloseImageMove(); }" Class="image-move-dialog" DefaultFocus="DefaultFocus.FirstChild" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = !_movingImages })"
              Title="Move to asset" CloseLabel="Close move to asset" CloseDisabled="_movingImages">
    <DialogContent>@if (_moveSource is { } moveSource && _library is not null) {
        <ImageMovePanel @key="moveSource" Library="_library" Source="moveSource" Images="_moveImages" Save="MoveImages" Moved="r => FinishImageMove(r, false)" EditRequested="r => FinishImageMove(r, true)" Cancelled="CloseImageMove" />
    }</DialogContent>
</InlineDialog>
<InlineDialog Visible="@(_copySource is not null)" VisibleChanged="v => { if (!v) _copySource = null; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true })"
              Title="Crop image" CloseLabel="Close crop image">
    <DialogContent>
        @if (_copySource is { } copy && _library is not null)
        {
            <ImageCopyPanel @key="copy.Image.Id" ProjectId="Id" Library="_library" Parent="@(new AssetImageReference(copy.AssetId, copy.Image.Id))"
                SourceWidth="copy.Image.Width" SourceHeight="copy.Image.Height" SourceUrl="@ImageUrl(copy.AssetId, copy.Image.Id)"
                InitialName="@($"{copy.Image.Name ?? SelectedAsset?.Name} · crop")" Save="SaveImageCopy" Saved="ImageCopySaved" Cancelled="() => _copySource = null" />
        }
    </DialogContent>
</InlineDialog>
<InlineDialog Visible="_moveAssetId is not null" VisibleChanged="v => { if (!v && !_ordering) _moveAssetId = null; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })"
              Title="Move asset" CloseLabel="Close move asset" CloseDisabled="_ordering"><DialogContent>
    <label>Position<select value="@(_moveAfter ? "after" : "before")" @onchange="@(e => _moveAfter = e.Value?.ToString() == "after")"><option value="before">Before</option><option value="after">After</option></select></label><label>Asset<select aria-label="Destination asset" @bind="_moveTarget">@foreach (var target in _library?.Assets.Where(a => a.Id != _moveAssetId) ?? []) { <option value="@target.Id">@target.Name</option> }</select></label>
    @if (_orderError is not null) { <p role="alert">@_orderError</p>@if (_conflict) { <MudButton OnClick="ReloadOrder">Review latest order</MudButton> } }
</DialogContent><DialogActions><MudButton OnClick="() => _moveAssetId = null" Disabled="_ordering">Cancel</MudButton><MudButton OnClick="ConfirmAssetMove" Disabled="@(_ordering || _moveTarget == Guid.Empty)" Variant="Variant.Filled" Color="Color.Primary">Move</MudButton></DialogActions></InlineDialog>
<InlineDialog Visible="_lookChangeItem is not null" VisibleChanged="v => { if (!v && !_changingLook) _lookChangeItem = null; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })" Class="media-move-dialog"
              Title="Change look" Context="@_lookChangeItem?.Name" CloseLabel="Close change look" CloseDisabled="_changingLook"><DialogContent>
    <label>Look<select aria-label="Look" @bind="_lookChangeValue" disabled="@_changingLook"><option value="">General / unassigned</option>@foreach (var look in _library?.Assets.FirstOrDefault(a => a.Id == _lookChangeOwner)?.Looks.Where(l => !l.Archived || l.Id == _lookChangeItem?.LookId) ?? []) { <option value="@look.Id" disabled="@look.Archived">@look.Name @(look.Archived ? "· Archived" : "")</option> }</select></label>
    @if (_galleryLookError is not null) { <p class="writing-error" role="alert">@_galleryLookError</p> }
</DialogContent><DialogActions><MudButton OnClick="() => _lookChangeItem = null" Disabled="_changingLook">Cancel</MudButton><MudButton OnClick="ApplyGalleryLook" Disabled="_changingLook" Variant="Variant.Filled" Color="Color.Primary">Apply changes</MudButton></DialogActions></InlineDialog>
<InlineDialog Visible="_moveMedia is not null" VisibleChanged="v => { if (!v && !_movingMedia) _moveMedia = null; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })" Class="media-move-dialog"
              Title="@($"Move {(_moveMedia?.Key.Kind == AssetMediaKind.Voice ? "recording" : "reel")} to asset")" Context="@_moveMedia?.Name" CloseLabel="Close move to asset" CloseDisabled="_movingMedia"><DialogContent>
    <label>Destination asset<select aria-label="Destination asset" @bind="_mediaDestination" disabled="@_movingMedia"><option value="@Guid.Empty">Choose an asset…</option>@foreach (var target in MediaDestinations) { <option value="@target.Id">@target.Name</option> }</select></label>
    <p class="field-hint">@(_moveMediaCategory switch { AssetCategory.Character => "Choose another character.", AssetCategory.Prop => "Choose another prop.", _ => "Choose another environment." }) @(_moveMedia?.Key.Kind == AssetMediaKind.Reel ? "The reel will be unassigned to a look. Captured requests keep their original destination." : "Existing shot references keep the same recording and excerpt.")</p>
    @if (!MediaDestinations.Any()) { <p>Create another @(_moveMediaCategory switch { AssetCategory.Character => "character", AssetCategory.Prop => "prop", _ => "environment" }) asset first.</p> }
    @if (_mediaMoveError is not null) { <p role="alert">@_mediaMoveError</p> }
</DialogContent><DialogActions><MudButton OnClick="() => _moveMedia = null" Disabled="_movingMedia">Cancel</MudButton><MudButton OnClick="ConfirmMediaMove" Disabled="@(_movingMedia || _mediaDestination == Guid.Empty)" Variant="Variant.Filled" Color="Color.Primary">Move</MudButton></DialogActions></InlineDialog>
<InlineDialog Visible="_imageInputsOpen" VisibleChanged="v => _imageInputsOpen = v" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false })" Class="image-input-manager-dialog"
              Title="Manage references" Context="@SelectedAsset?.Name" CloseLabel="Close manage references"><DialogContent>
    @if (_imageInputsOpen && _library is not null && _selectedAssetId is { } inputAsset) { <ImageEditReferenceManager Library="_library" AssetId="inputAsset" AllowOtherSourceAssets="_imageRecipeCreation" Inputs="CurrentImageInputs.ToArray()" Crops="AllImageCrops" Regions="@(CurrentRegions ?? [])" Aspect="@ImageAspect" Resolution="CapturedImageResolution" QwenImage21="CaptureQwenOptions()" Maximum="@(Math.Min(ReferenceLimit, _editConfiguration?.MaximumReferences ?? ReferenceLimit))" RestoreTrashedImage="RestoreImageInputAsync" Applied="ApplyImageInputs" Cancelled="() => _imageInputsOpen = false" /> }
</DialogContent></InlineDialog>
<InlineDialog Visible="_deleteAsset is not null" VisibleChanged="v => { if (!v) _deleteAsset = null; }" Class="asset-delete-dialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })"
              Title="Delete this asset?" CloseLabel="Close delete asset">
    <DialogContent><p>Its images will stay in Trash for 30 days. Restoring an image can recreate this asset.</p></DialogContent>
    <Actions><MudButton OnClick="() => _deleteAsset = null">Cancel</MudButton><MudButton OnClick="DeleteAssetAsync" Color="Color.Error" Variant="Variant.Filled">Delete asset</MudButton></Actions>
</InlineDialog>
<InlineDialog Visible="_deleteAllAssetsOpen" VisibleChanged="CloseAllAssetDeletion" Options="DeleteAllAssetsOptions" Class="asset-delete-all-dialog" ContentClass="dialog-prose"
              Title="Delete all assets?" CloseLabel="Close delete all assets" CloseDisabled="_deletingAllAssets">
    <DialogContent>
        <DialogEscape Pressed="() => CloseAllAssetDeletion(false)" />
        @if (_deleteAssetsSnapshot is { } snapshot)
        {
            <p>Delete all @snapshot.Assets.Count assets in this project, including assets hidden by search or category filters.</p>
            <p>@snapshot.Assets.Sum(a => a.Images.Count) images and @snapshot.Voices.Count voice clips will stay in Trash for 30 days. Restoring media can recreate its asset. Assets with no retained media cannot be restored.</p>
            <p>Existing shot references may need restoration or replacement before generating again.</p>
            <ul class="asset-delete-list">@foreach (var asset in snapshot.Assets) { <li>@asset.Name <small>· @asset.Images.Count images</small></li> }</ul>
        }
        @if (_deletingAllAssets) { <p role="status">@_deleteAssetsProgress</p> }
        @if (AssetDeletionActivityIssue is { } activityIssue) { <p role="status">@activityIssue</p> }
        @if (_deleteAssetsError is not null) { <p class="field-error" role="alert">@_deleteAssetsError</p><MudButton OnClick="OpenAllAssetDeletionAsync" Disabled="_deletingAllAssets" Variant="Variant.Outlined" Size="Size.Small">Review latest assets</MudButton> }
