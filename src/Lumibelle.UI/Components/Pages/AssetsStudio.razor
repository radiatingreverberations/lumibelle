    private async Task OpenPreview(Guid imageId)
    {
        ClearTrashNotification();
        if (SelectedAsset is not { } asset) return;
        var reference = new AssetImageReference(asset.Id, imageId);
        if (_latestEditBatch is { } batch && batch.AssetId == asset.Id && batch.Entries.Any(e => e.Reference == reference))
        { await OpenImageBatchAsync(batch, reference); return; }
        if (asset.Images.FirstOrDefault(i => i.Id == imageId) is not { } image) return;
        if (image.Generation?.BatchId is { } root && AiJobs.View.Jobs.Any(j => j.Id == root && j.Target.ProjectId == Id && j.Target.AssetId == asset.Id))
        {
            _requestedImageRoot = root; await RefreshImageJobsAsync();
            if (_imageSessions.TryGetValue(root, out var savedBatch)) { await OpenImageBatchAsync(savedBatch, reference); return; }
        }
        var review = new ImageReviewSession(Id, asset.Id, false);
        if (image.Generation?.Edit is { } edit)
        {
            var source = new AssetImageReference(edit.SourceAssetId, edit.SourceImageId);
            review.Entries.Add(new(source, "Source", SourceCrop: edit.SourceCrop));
            var number = 2;
            foreach (var other in edit.References.Where(r => r != source && r != reference).Distinct())
                review.Entries.Add(new(other, $"Reference {number++}", SourceCrop: edit.ReferenceCrops.FirstOrDefault(c => c.Reference == other)?.Crop));
        }
        if (image.Source?.Crop is { } cropSource && cropSource.ProjectId == Id)
            review.Entries.Add(new(new(cropSource.AssetId, cropSource.ImageId), "Source", SourceCrop: cropSource.Crop));
        review.Entries.Add(new(reference, image.Origin == AssetImageOrigin.Edited ? "Take" : "Image", true));
        _review = review; _reviewInitial = reference; _reviewOpen = true;
    }
