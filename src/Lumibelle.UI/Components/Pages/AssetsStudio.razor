    private async Task<string?> DiscardReviewedAsync(IReadOnlyCollection<Guid> ids)
    {
        var review = _review;
        if (review is null || !review.IsBatch || review.ProjectId != Id || _library is null)
            return "This review is no longer available.";
        if (ids.Count == 0 || ids.Any(id => !review.Entries.Any(e => e.IsTake && e.Reference.AssetId == review.AssetId && e.Reference.ImageId == id)))
            return "Only this batch's generated takes can be discarded.";
        await _saveGate.WaitAsync();
        try
        {
            if (!await SavePendingLockedAsync() || _library is null) return _saveError ?? "Save the current asset changes before discarding.";
            var version = _editVersion;
            var result = await AssetStore.DeleteImagesAsync(Id, review.AssetId, ids, _library.Revision);
            var saved = result.Library;
            _savedLibrary = saved.Copy();
            if (version == _editVersion) _library = saved;
            else _library = _library with
            {
                Revision = saved.Revision, UpdatedUtc = saved.UpdatedUtc, Trash = saved.Trash,
                Assets = _library.Assets.Select(a => a.Id == review.AssetId ? a with { Images = a.Images.Where(i => !ids.Contains(i.Id)).ToList() } : a).ToList()
            };
            review.HiddenTakeIds.UnionWith(ids);
            if (_selectedAssetId == review.AssetId)
            {
                if (_editSourceImageId is { } source && ids.Contains(source)) UseCreateMode();
            }
            _saveStatus = _dirty ? "Unsaved" : "Saved"; _saveError = null; _conflict = false;
            await InvokeAsync(StateHasChanged);
            return null;
        }
        catch (WorkspaceConflictException e) { _conflict = true; _saveError = e.Message; _saveStatus = "Conflict"; return e.Message + " Close the review and reload the saved library before retrying."; }
        catch (WorkspaceStoreException e) { return e.Message; }
        finally { _saveGate.Release(); }
    }
