@* The heading of a page outside the studios: an optional back link and eyebrow, the title, a short lead, and page actions. *@
<header class="page-heading @Class">
    <div class="page-heading-copy">
        @if (BackHref is not null) { <a class="page-back" href="@BackHref"><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" aria-hidden="true" />@BackLabel</a> }
        @if (Eyebrow is not null) { <p class="eyebrow">@Eyebrow</p> }
        <h1>@Title</h1>
        @if (Lead is not null) { <div class="page-lead">@Lead</div> }
    </div>
    @if (Actions is not null) { <div class="page-heading-actions">@Actions</div> }
</header>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public RenderFragment? Lead { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Back";
    [Parameter] public string? Class { get; set; }
}
