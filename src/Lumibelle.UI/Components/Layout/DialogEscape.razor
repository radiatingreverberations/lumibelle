@* Marks a dialog whose close path runs on Escape. The page-wide listener in dialog-escape.js clicks this
   button for the dialog that has focus, or for the topmost dialog when focus has fallen back to the page. *@
<button hidden tabindex="-1" aria-hidden="true" @onclick="Pressed" data-dialog-escape></button>

@code {
    [Parameter] public EventCallback Pressed { get; set; }
}
