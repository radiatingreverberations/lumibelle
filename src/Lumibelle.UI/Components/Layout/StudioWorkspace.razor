@implements IAsyncDisposable
@inject IJSRuntime JS

<SectionContent SectionName="workspace-toolbar" ChildContent="_toolbarContent" />
<section class="studio-workspace" data-project="@ProjectId" data-studio="@Studio" data-has-right="@(ShowRight ? "true" : "false")" data-selection="@SelectionKey" @ref="_element" aria-label="@($"{Studio} workspace")" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <div class="workspace-columns">
        <div id="@LeftId" class="workspace-side workspace-left" aria-label="@LeftLabel">
            <header class="workspace-drawer-heading"><strong>@LeftLabel</strong><button type="button" data-close-pane aria-label="Close @LeftLabel">Close</button></header>
            @Left
        </div>
        <div class="workspace-splitter" data-resize-pane="left" role="separator" tabindex="0" aria-label="@LeftLabel" aria-orientation="vertical" aria-controls="@LeftId" aria-valuemin="160" aria-valuemax="300" aria-valuenow="200"></div>
        <div class="workspace-center">@Center</div>
        <div class="workspace-splitter" data-resize-pane="right" role="separator" tabindex="0" aria-label="@RightLabel" aria-orientation="vertical" aria-controls="@RightId" aria-valuemin="300" aria-valuemax="480" aria-valuenow="340"></div>
        <div id="@RightId" class="workspace-side workspace-right" aria-label="@RightLabel">
            <header class="workspace-drawer-heading"><strong>@RightLabel</strong><button type="button" data-close-pane aria-label="Close @RightLabel">Close</button></header>
            @Right
        </div>
    </div>
    <button type="button" class="workspace-scrim" data-close-pane aria-label="Close tools" tabindex="-1" hidden></button>
</section>

@code {
    [Parameter, EditorRequired] public string Studio { get; set; } = "";
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string LeftLabel { get; set; } = "Library";
    [Parameter] public string RightLabel { get; set; } = "Tools";
    [Parameter] public string? SelectionKey { get; set; }
    [Parameter] public RenderFragment? Left { get; set; }
    [Parameter] public RenderFragment? Center { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public bool ShowRight { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module, _workspace;
    private bool _disposed;
    private bool _pendingTools;
    private string? _pendingTab;
    private string _pendingGroup = "tools";
    private string? _pendingCenter;
    private string LeftId => $"workspace-{Studio}-left";
    private string RightId => $"workspace-{Studio}-right";
    private string ToolbarId => $"workspace-{Studio}-toolbar";
    private RenderFragment? _toolbarContent;
    protected override void OnInitialized() => _toolbarContent = @<div id="@ToolbarId" class="workspace-toolbar" data-has-right="@(ShowRight ? "true" : "false")">
        <button type="button" data-toggle-pane="left" data-pane-label="@LeftLabel" aria-controls="@LeftId" aria-expanded="true"><svg class="pane-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" /></svg><span data-toggle-label>Hide @LeftLabel</span></button>
        <div class="workspace-status" role="status">@Status</div>
        <button type="button" data-toggle-pane="right" data-pane-label="@RightLabel" aria-controls="@RightId" aria-expanded="true"><svg class="pane-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16" /></svg><span data-toggle-label>Hide @RightLabel</span></button>
        <MudMenu Label="Layout" Size="Size.Small" Dense="true" EndIcon="@Icons.Material.Outlined.ExpandMore" Class="workspace-layout-menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"><MudMenuItem role="menuitem" OnClick="ResetLayoutAsync">Reset layout</MudMenuItem></MudMenu>
    </div>;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("studio-workspace.js"));
        if (_disposed) { await _module.DisposeAsync(); return; }
        _workspace = await _module.InvokeAsync<IJSObjectReference>("attach", _element, ToolbarId);
        if (_pendingTools) { _pendingTools = false; await _workspace.InvokeVoidAsync("showTools", _pendingTab, _pendingGroup); }
        if (_pendingCenter is { } center) { _pendingCenter = null; await _workspace.InvokeVoidAsync("showCenter", center); }
    }
    public async Task ShowToolsAsync(string? tab = null, string group = "tools")
    { if (_workspace is not null) await _workspace.InvokeVoidAsync("showTools", tab, group); else { _pendingTools = true; _pendingTab = tab; _pendingGroup = group; } }
    private async Task ResetLayoutAsync()
    { if (_workspace is not null) await _workspace.InvokeVoidAsync("resetLayout"); }
    public async Task RevealCenterAsync()
    { if (_workspace is not null) await _workspace.InvokeVoidAsync("revealCenter"); }
    public async Task ShowCenterAsync(string tab)
    { if (_workspace is not null) await _workspace.InvokeVoidAsync("showCenter", tab); else _pendingCenter = tab; }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_workspace is not null) { await _workspace.InvokeVoidAsync("dispose"); await _workspace.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
