@inject TimeProvider Clock
@inject AiJobCoordinator Jobs
@implements IAsyncDisposable

<div class="text-request-action @(Primary ? "primary-request-action" : "") @(Ready ? "request-ready" : "")">
    <button type="button" class="assist-trigger request-action-button" @ref="_button" disabled="@ButtonDisabled" @onclick="Activate" @onmousedown:preventDefault="true"
            aria-label="@AccessibleLabel" aria-describedby="@(Notice is null ? null : _noticeId)" aria-haspopup="@(Primary && !Inspecting ? null : "dialog")">
        @if (Spinning) { <span aria-hidden="true" class="request-spinner"></span> }
        else if (StatusIcon is { } statusIcon) { <span aria-hidden="true" class="request-icon">@statusIcon</span> }
        else { <AiAssistIcon /> }
        <span class="request-action-copy"><span>@VisibleLabel</span>@if (Timing.Length > 0) { <small class="request-time" aria-hidden="true">@Timing</small> }</span>
        @if (Notice is not null) { <span class="request-notice-badge" aria-hidden="true" title="@Notice">!</span> }
    </button>
    <span class="sr-only" role="status" aria-live="polite">@VisibleLabel</span>
    @if (Notice is not null) { <span id="@_noticeId" class="sr-only">@Notice</span> }
</div>
@code {
    [Parameter] public string Label { get; set; } = "Assist";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Notice { get; set; }
    [Parameter] public TextRequestPresentation? Request { get; set; }
    [Parameter] public bool Preparing { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnReview { get; set; }
    private Guid? _freshFor;
    private readonly string _noticeId = $"request-notice-{Guid.NewGuid():N}";
    private ElementReference _button;
    private PeriodicTimer? _timer;
    private Task? _ticks;
    private bool _disposed;
    private bool Inspecting => !HasError && Request?.Inspectable == true && (!Primary || _freshFor != Request.Job.Id || Request.Active);
    private bool Spinning => Preparing || Inspecting && Request!.Active && Request.Job.State != AiJobState.Waiting;
    // A finished result waits for the person to look at it, so the button stands out until it is applied or dismissed.
    private bool Ready => Inspecting && !Request!.Active && Request.Job.State == AiJobState.Completed && Request.Outcome is TextRequestOutcome.Proposal or TextRequestOutcome.Response;
    private bool ButtonDisabled => Preparing || !Inspecting && !HasError && Disabled;
    private string VisibleLabel => Preparing ? "Preparing request…" : Inspecting ? Request!.Label : HasError ? "Needs attention" : Label;
    private string AccessibleLabel => Inspecting ? VisibleLabel + (Request!.Active ? " · View request" : "") : HasError || Preparing ? VisibleLabel : Title ?? Label;
    private string? StatusIcon => Inspecting && Request!.Job.State == AiJobState.Waiting ? "◷" : Inspecting && VisibleLabel == "Needs attention" || HasError ? "!" : null;
    private string Timing => Inspecting && Request is { } request ? ProgressTiming.ForJob(request.Job, Jobs.Progress(request.Job.Id)?.Progress, Clock.GetUtcNow()) : "";
    public ValueTask FocusAsync() => _button.FocusAsync();
    private async Task Activate()
    {
        if (Preparing) return;
        if (Inspecting) { await FocusAsync(); await OnReview.InvokeAsync(); }
        else await OnStart.InvokeAsync();
    }
    /// <summary>For a primary action, shows its start label again so a new request can begin while an earlier result waits.</summary>
    public void StartFresh() { if (Primary) { _freshFor = Request?.Job.Id; StateHasChanged(); } }
    protected override void OnParametersSet()
    {
        if (_freshFor != Request?.Job.Id || Preparing) _freshFor = null;
        if (Request?.Active == true && _timer is null) { _timer = new(TimeSpan.FromSeconds(1), Clock); _ticks = Tick(_timer); }
        else if (Request?.Active != true) { _timer?.Dispose(); _timer = null; }
    }
    private async Task Tick(PeriodicTimer timer) { while (await timer.WaitForNextTickAsync()) await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
    public async ValueTask DisposeAsync() { _disposed = true; _timer?.Dispose(); if (_ticks is not null) await _ticks; }
}
