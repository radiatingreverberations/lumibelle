@using lumibelle.Services.Review
@inject IAgentAccessStore Access
@inject NavigationManager Navigation

<div class="settings-card agent-access">
    <div class="settings-card-title"><span class="provider-badge">MCP</span><h2>Agent access</h2></div>
    <p>Let an AI agent you run yourself review the projects in this library over the Model Context Protocol: read shots, takes and the cut, run the continuity checks, and propose fixes as a plan. A plan changes nothing until you approve it.</p>
    @if (_settings is null) { <p role="status">@(_error ?? "Loading…")</p> }
    else
    {
        <label class="check-row"><input id="agent-access-enabled" type="checkbox" checked="@_settings.Enabled" disabled="@_busy" @onchange="e => Save((bool)e.Value!, _settings.AllowClientApproval)" />Allow agent access from this computer</label>
        @if (_settings.Enabled)
        {
            <label for="agent-access-address">Server address</label>
            <input id="agent-access-address" class="agent-access-value" readonly value="@Endpoint" aria-describedby="agent-access-hint" />
            <label for="agent-access-token">Access token</label>
            <input id="agent-access-token" class="agent-access-value" readonly value="@(_shown ? _token : "••••••••")" aria-describedby="agent-access-hint" />
            <div class="agent-access-actions">
                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => _shown = !_shown">@(_shown ? "Hide token" : "Show token")</MudButton>
                <MudButton Disabled="_busy" OnClick="() => _confirmRenew = true">Replace token…</MudButton>
            </div>
            <p id="agent-access-hint" class="field-hint">Add this address to your MCP client as a Streamable HTTP server, and send the token in an <code>Authorization: Bearer</code> header. Only programs on this computer can connect. The token opens this library to them, so treat it like a password.</p>
            <label class="check-row"><input id="agent-access-approval" type="checkbox" checked="@_settings.AllowClientApproval" disabled="@_busy" @onchange="e => Save(true, (bool)e.Value!)" />Allow approving plans in the agent’s conversation</label>
            <p class="field-hint">Off: you approve plans and pick takes in Lumibelle, on the project’s Review page. On: the agent can also do both from its own conversation, and resume paused queues and stopped requests. Lumibelle can’t see whether the client asks you first, so turn this on only for a client you trust to ask. Either way, an agent can stop plans, cancel requests and pause queues.</p>
        }
        @if (_error is not null) { <p class="field-hint" role="alert">@_error</p> }
    }
</div>
<ConfirmDialog Visible="_confirmRenew" VisibleChanged="v => { if (!v) _confirmRenew = false; }" Title="Replace the access token?" ConfirmLabel="Replace token" Busy="_busy" OnConfirm="Renew">
    Clients set up with the current token are refused until you give them the new one.
</ConfirmDialog>

@code {
    private AgentAccessSettings? _settings;
    private string? _token, _error;
    private bool _busy, _shown, _confirmRenew;
    private string Endpoint => Navigation.ToAbsoluteUri("/mcp").ToString();

    protected override async Task OnInitializedAsync()
    {
        try { await Load(); }
        catch (WorkspaceStoreException e) { _error = e.Message; }
    }

    private async Task Load() { _settings = await Access.LoadAsync(); _token = _settings.Enabled ? await Access.ReadTokenAsync() : null; }

    private Task Save(bool enabled, bool approval) => Do(() => Access.SaveAsync(enabled, approval, _settings!.Revision));
    private Task Renew() => Do(async () => { await Access.RenewTokenAsync(_settings!.Revision); _confirmRenew = false; });

    private async Task Do(Func<Task> action)
    {
        if (_busy || _settings is null) return;
        _busy = true; _error = null;
        try { await action(); }
        catch (WorkspaceConflictException) { _error = "These settings changed in another tab. They have been reloaded."; }
        catch (WorkspaceStoreException e) { _error = e.Message; }
        finally
        {
            try { await Load(); } catch (WorkspaceStoreException e) { _error = e.Message; }
            _busy = false;
        }
    }
}
