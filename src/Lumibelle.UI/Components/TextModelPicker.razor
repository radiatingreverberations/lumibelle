@inject IAiSettingsStore SettingsStore
@inject IProjectAiPreferencesStore Preferences
@inject IAiProviderRegistry Providers
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="text-model-picker" aria-label="Current AI configuration">
    @if (!HideTrigger) {
    <button type="button" class="model-chip" @onclick="OpenAsync" disabled="@Disabled" aria-label="Text model options" aria-haspopup="dialog" title="@FullLabel" aria-describedby="@(Notice is null ? null : _inputId + "-notice")">@ShortLabel <span class="model-source">@SourceLabel</span>@if (Notice is { } issue) { <span class="request-notice-badge" aria-hidden="true" title="@issue">!</span> } ▾</button>
    @if (Notice is { } notice) { <span id="@(_inputId + "-notice")" class="sr-only">@notice</span> }
    }
    @if (_error is not null && !_open) { <span class="model-notice" role="status">@_error</span> }
</div>
<AiAssistDialog Visible="_open" VisibleChanged="value => _open = value" Title="@(DefaultEditor ? "Project text model" : "Text model")">
    <ChildContent>
        <p class="field-hint">@(DefaultEditor ? "The default for every text assistant in this project." : "Choose a model for this request. Your project default stays in place unless you explicitly change it.")</p>
        <label for="@_inputId">Text model</label>
        <select id="@_inputId" value="@SelectedKey" @onchange="SelectAsync" disabled="@(Disabled || _busy || _session is null)">
            <option value="default">Use project default · @BaseLabel</option>
            @foreach (var model in Choices) { <option value="@TextModelProfiles.ChoiceKey(model)" disabled="@(_session?.IssueFor(model) is not null)">@Label(model)@(_session?.IssueFor(model) is { } reason ? $" · {reason}" : "")</option> }
        </select>
        <p class="field-hint">@InheritanceLabel</p>
        @if (_session?.Model is { ProfileId: not null } profile) {
            <p class="field-hint">Saved profile snapshot · @TextModelProfiles.Describe(profile). Editing a profile in AI settings does not change this selection; select its updated entry to adopt the changes.</p>
        }
        @if (_session is not null && TextModelPolicy.UsesNamedEffort(_session.Model.Backend)) {
            <details class="text-model-effort"><summary>Reasoning</summary>
                <label for="@(_inputId + "-effort")">Reasoning effort</label>
                <select id="@(_inputId + "-effort")" value="@((_session.Override ?? _session.Base).ReasoningEffort)" @onchange="EffortAsync" disabled="@(Disabled || _busy || _session.CatalogModel is null)">
                    <option value="">@(_session.Model.ProfileId is not null ? "Use model default" : $"Use settings default · {TextModelPolicy.DefaultEffort(_session.Model.Backend, _session.Settings) ?? "model default"}")</option>
                    @foreach (var effort in _session.CatalogModel?.ReasoningEfforts ?? []) { <option value="@effort">@effort</option> }
                </select>
            </details>
        }
        @if (_busy) { <p role="status">Checking model availability…</p> }
        @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
        else if (_session?.Issue is { } issue) { <p class="field-error" role="status">@issue</p> }
        <div class="assist-model-tools"><button type="button" @onclick="() => RefreshAsync(true)" disabled="@_busy">Refresh availability</button><a href="@ManageUrl">Manage models</a></div>
    </ChildContent>
    <Actions>
        @if (_session?.Preferences.TextDefault is not null || DefaultEditor) { <MudButton OnClick="() => SaveDefaultAsync(true)" Disabled="@(Disabled || _busy)">Use global default</MudButton> }
        <MudButton OnClick="() => SaveDefaultAsync(false)" Disabled="@(Disabled || _busy || _session?.Issue is not null)" Variant="Variant.Outlined">Set as project default</MudButton>
        @if (!DefaultEditor) { <MudButton OnClick="() => _open = false" Color="Color.Primary" Variant="Variant.Filled">Done</MudButton> }
    </Actions>
</AiAssistDialog>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public TextAssistantStudio Studio { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DefaultEditor { get; set; }
    [Parameter] public bool HideTrigger { get; set; }
    [Parameter] public EventCallback<TextModelSelectionState> SelectionChanged { get; set; }
    private TextModelSession? _session;
    private Guid? _loaded;
    private bool _busy, _open, _disposed, _hasLoadedSettings;
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    public string DisplayLabel => !_hasLoadedSettings ? "Loading model…" : $"{SourceLabel} · {ShortLabel}";
    // Why the selected model can't be used. The chip shows it as a (!) badge, as request actions do.
    public string? Notice => _hasLoadedSettings && !_busy ? _session?.Issue : null;
    private string? _error;
    private readonly string _inputId = $"text-model-{Guid.NewGuid():N}";
    private readonly CancellationTokenSource _lifetime = new();
    private IJSObjectReference? _module;
    private DotNetObjectReference<TextModelPicker>? _reference;
    private string SelectedKey => _session?.Override is { } model ? TextModelProfiles.ChoiceKey(model) : "default";
    private string SourceLabel => _session?.Source switch { TextModelSelectionSource.RequestOverride => "Override", TextModelSelectionSource.ProjectDefault => "Project", _ => "Global" };
    private string FullLabel => _session is null ? "Choose text model" : Label(_session.Model);
    private string ShortLabel => _session is null || !_hasLoadedSettings ? "Text model" : TextModelPolicy.DisplayName(_session.Model, _session.Settings, CatalogName(_session.Model));
    private string BaseLabel => _session is null ? "Loading…" : Label(_session.Base);
    private string InheritanceLabel => _session?.Source switch { TextModelSelectionSource.RequestOverride => "For this request only.", TextModelSelectionSource.ProjectDefault => "Using the project default.", _ => "The project follows the global default." };
    private string ManageUrl => AiSettingsNavigation.Link(Navigation, "text", ProjectId, Studio == TextAssistantStudio.Story ? "script" : Studio is TextAssistantStudio.Shots or TextAssistantStudio.Production ? "shots" : "assets");
    private IEnumerable<TextModelReference> Choices => (_session?.Choices ?? []).OrderBy(Label, StringComparer.OrdinalIgnoreCase);
    private string? CatalogName(TextModelReference model) => _session?.Checks.GetValueOrDefault(model.Backend)?.Models.FirstOrDefault(m => m.Id == model.Model)?.Name;
    private string Label(TextModelReference model) => _session is null ? model.Name : TextModelPolicy.PickerLabel(model, _session.Settings, _session.Choices, CatalogName);
    protected override async Task OnParametersSetAsync() {
        if (_loaded == ProjectId) return;
        _loaded = ProjectId; _hasLoadedSettings = false; _session = new(ProjectId, SettingsStore, Preferences, Providers);
        await RefreshAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try { _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("text-assistance.js")); _reference = DotNetObjectReference.Create(this); if (_module is not null) await _module.InvokeVoidAsync("watch", _inputId, _reference); }
        catch (JSException) { }
    }
    public async Task OpenAsync() { _open = true; await RefreshAsync(true); await InvokeAsync(StateHasChanged); }
    private async Task PublishAsync() { if (_session is not null && !_disposed) await SelectionChanged.InvokeAsync(_session.State with { Ready = !_busy && _error is null && _session.Issue is null }); }
    private async Task RefreshAsync(bool all = false) {
        if (_session is null || _disposed) return;
        var session = _session;
        try { await _refreshGate.WaitAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_disposed) { return; }
        try {
            if (_disposed || !ReferenceEquals(session, _session)) return;
            _busy = true; _error = null; await PublishAsync();
            try { await session.RefreshAsync(all, _lifetime.Token); if (ReferenceEquals(session, _session)) _hasLoadedSettings = true; }
            catch (OperationCanceledException) when (_disposed) { }
            catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException or AiGenerationException) { if (ReferenceEquals(session, _session)) _error = e.Message; }
            finally { if (ReferenceEquals(session, _session)) { _busy = false; await PublishAsync(); } }
        }
        finally { _refreshGate.Release(); }
    }
    [JSInvokable] public async Task RefreshModel() { if (Disabled || _busy || _disposed) return; await RefreshAsync(); await InvokeAsync(StateHasChanged); }
    private async Task SelectAsync(ChangeEventArgs args) {
        if (Disabled || _busy || _session is null) return;
        var key = args.Value?.ToString(); var choice = key == "default" ? null : Choices.FirstOrDefault(m => TextModelProfiles.ChoiceKey(m) == key);
        if (key != "default" && (choice is null || _session.IssueFor(choice) is not null)) return;
        _session.Select(choice); _error = null; await PublishAsync();
    }
    private async Task EffortAsync(ChangeEventArgs args) {
        if (Disabled || _busy || _session is null) return;
        var effort = args.Value?.ToString();
        if (!string.IsNullOrEmpty(effort) && _session.CatalogModel?.ReasoningEfforts?.Contains(effort) != true) return;
        _session.SetEffort(effort); _error = null; await PublishAsync();
    }
    private async Task SaveDefaultAsync(bool global) {
        if (Disabled || _busy || _session is null) return;
        _busy = true; _error = null;
        try { await _session.SetDefaultAsync(global, _lifetime.Token); _open = false; }
        catch (WorkspaceConflictException) { await _session.RefreshAsync(ct: _lifetime.Token); _error = "The project default changed in another tab. Review the current choice and try again."; }
        catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException) { _error = e.Message; }
        finally { _busy = false; await PublishAsync(); }
    }
    public async Task<bool> PrepareSubmitAsync() {
        if (_busy || _session is null) return false;
        var shown = _session.State; await RefreshAsync();
        if (_error is not null) return false;
        if (!TextModelSession.SameChoice(shown, _session.State)) { _error = "The project model changed. Review the updated model and submit again."; _open = true; await InvokeAsync(StateHasChanged); return false; }
        if (_session.Issue is not null) { _error = _session.Issue; _open = true; await InvokeAsync(StateHasChanged); return false; }
        return true;
    }
    public async Task SubmittedAsync() {
        if (_session is null) return;
        _session.Select(null); await RefreshAsync(); await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync() {
        _disposed = true; _lifetime.Cancel();
        try { if (_module is not null) { await _module.InvokeVoidAsync("unwatch", _inputId); await _module.DisposeAsync(); } } catch (JSDisconnectedException) { }
        _reference?.Dispose(); _lifetime.Dispose();
    }
}
