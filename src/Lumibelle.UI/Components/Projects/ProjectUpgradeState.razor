@using lumibelle.Services.Projects
@using lumibelle.Services.Storage
@implements IDisposable
@inject IProjectUpgrades Upgrades
@inject AiJobCoordinator Jobs

<EmptyState Icon="@Icons.Material.Outlined.Upgrade" Title="This project needs upgrading" HeadingLevel="1">
    <ChildContent>
        <p>“@Name” was saved by an earlier version of Lumibelle. Upgrade it to open it here. Earlier versions won’t open the upgraded database.</p>
        <ul>@foreach (var step in _status.Steps) { <li>@step</li> }</ul>
        @if (_status.BackupBytes > 0)
        {
            <p>A copy of the project database (@Size(_status.BackupBytes)) will be kept in the project’s <code>legacy-json</code> folder. Compact project can remove it later.</p>
        }
        else { <p>Existing upgrade backups and original JSON files are kept in the project’s <code>legacy-json</code> folder.</p> }
        @if (_status.Busy is { } busy) { <p class="field-error" role="alert">@busy</p> }
        @if (_progress is { } progress) { <p role="status">@progress</p> }
        @if (_error is { } error) { <p class="field-error" role="alert">@error</p> }
    </ChildContent>
    <Actions>
        <MudButton OnClick="UpgradeAsync" Disabled="@(_working || _status.Busy is not null)" Variant="Variant.Filled" Color="Color.Primary">@(_working ? "Upgrading…" : "Upgrade project")</MudButton>
        <MudButton Href="/" Variant="Variant.Outlined" Disabled="_working">Back to projects</MudButton>
    </Actions>
</EmptyState>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public ProjectUpgradeStatus Status { get; set; } = null!;
    [Parameter] public EventCallback OnUpgraded { get; set; }
    private ProjectUpgradeStatus _status = null!;
    private readonly CancellationTokenSource _lifetime = new();
    private bool _working, _disposed;
    private string? _progress, _error;

    protected override void OnInitialized() => Jobs.Changed += ActivityChanged;
    protected override void OnParametersSet() => _status = Status;
    private static string Size(long bytes) => $"{bytes / 1024d / 1024d:N1} MB";
    private void ActivityChanged() => _ = InvokeAsync(RefreshAsync);
    private async Task RefreshAsync()
    {
        if (_disposed || _working) return;
        try { _status = await Upgrades.StatusAsync(ProjectId, _lifetime.Token); if (!_disposed) StateHasChanged(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException) { _error = e.Message; if (!_disposed) StateHasChanged(); }
    }
    private async Task UpgradeAsync()
    {
        if (_working) return;
        _working = true; _error = null;
        try
        {
            var progress = new Progress<string>(message => { if (!_disposed) _ = InvokeAsync(() => { _progress = message; StateHasChanged(); }); });
            await Upgrades.UpgradeAsync(ProjectId, progress, _lifetime.Token);
            if (!_disposed) await OnUpgraded.InvokeAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception e) when (e is WorkspaceStoreException or ProjectStoreException) { _error = e.Message; }
        finally { _working = false; _progress = null; }
        if (!_disposed) await RefreshAsync();
    }
    public void Dispose() { _disposed = true; Jobs.Changed -= ActivityChanged; _lifetime.Cancel(); _lifetime.Dispose(); }
}
