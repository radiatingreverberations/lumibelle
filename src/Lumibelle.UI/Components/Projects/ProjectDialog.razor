<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <TitleContent>
        <DialogHeader Title="@(Dialog.Title ?? "Project")" Close="Cancel" CloseDisabled="_saving" CloseLabel="@(Project is null ? "Close new project" : "Close edit project")">
            <Summary>@(Project is null ? "Choose a name, an optional description and a visual style." : "Update the name and description of your project.")</Summary>
        </DialogHeader>
    </TitleContent>
    <DialogContent><ProjectForm Project="Project" ActionsSection="_actions" SavingChanged="SavingChangedAsync" OnSaved="Saved" OnCancel="Cancel" /></DialogContent>
    <DialogActions><SectionOutlet SectionId="_actions" /></DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public ProjectInfo? Project { get; set; }
    private readonly object _actions = new();
    private bool _saving;
    private void Saved(ProjectInfo project) => Dialog.Close(DialogResult.Ok(project));
    private void Cancel() { if (!_saving) Dialog.Cancel(); }
    // Escape follows the close button: it cannot dismiss the dialog while the project is being saved.
    private async Task SavingChangedAsync(bool saving)
    {
        _saving = saving;
        if (Dialog.Options is { } options) await Dialog.SetOptionsAsync(options with { CloseOnEscapeKey = !saving });
    }
}
