@using lumibelle.Services.Projects
@inherits ProjectAwareComponent
@implements IDisposable
@inject IProjectFolders Folders
@inject IProjectCompaction Compaction
@inject NavigationManager Navigation

<section class="settings-card project-storage" aria-labelledby="project-storage-heading" aria-busy="@_busy">
    <h2 id="project-storage-heading">Storage</h2>
    @if (_loading) { <p role="status">Checking where this project is saved…</p> }
    else if (_location is { } location)
    {
        <p>This project is saved in a folder outside the library. Every change is saved there.</p>
        <p class="project-storage-path"><MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" /><code>@location.Path</code></p>
        <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => { _error = null; _confirmRemove = true; }">Remove from library…</MudButton>
    }
    else
    {
        <p>This project is saved in the library folder. Move it to a folder of your choice, such as a synced or external drive, and keep editing it there.</p>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DriveFileMove" Disabled="_busy" OnClick="OpenMove">Move to folder…</MudButton>
    }
    <p>Compacting removes data this project can do without, such as lossless frame archives and discarded media, to make it smaller to keep or share.</p>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Compress" Disabled="_busy" OnClick="OpenCompactAsync">Compact project…</MudButton>
    @if (_notice is not null) { <p role="status">@_notice</p> }
    @if (_error is not null && !_moveOpen && !_confirmRemove && !_compactOpen) { <p class="field-error" role="alert">@_error</p> }
</section>

<InlineDialog Visible="_compactOpen" VisibleChanged="value => { if (!_busy) _compactOpen = value; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })"
              Class="project-compact-dialog" Title="Compact project" Context="@Project.Name" CloseLabel="Close compact project" CloseDisabled="_busy">
    <DialogContent>
        @if (_plan?.Usage is { Total: > 0 } usage)
        {
            @* What takes up space, so the choice below, or what to keep out of version control, is informed. *@
            <section class="project-storage-usage" aria-label="What takes up space">
                <p><strong>This project uses @StorageSize.Format(usage.Total)</strong></p>
                <ul>
                    @foreach (var category in usage.Categories.Where(c => c.Bytes > 0))
                    {
                        <li><span>@ProjectStorageUsage.Label(category.Kind) <small>· @category.Files @(category.Files == 1 ? "file" : "files")</small></span>
                            <span class="usage-bar" aria-hidden="true"><i style="@FormattableString.Invariant($"width:{Math.Max(1, 100d * category.Bytes / usage.Total):0.#}%")"></i></span>
                            <span class="usage-size">@StorageSize.Format(category.Bytes)</span></li>
                    }
                </ul>
                <details><summary>Largest files</summary>
                    <ul class="usage-largest">@foreach (var file in usage.Largest) { <li><code>@file.Path</code> · @StorageSize.Format(file.Bytes)@if (file.Bytes > ProjectStorageUsage.LargeFileBytes) { <strong class="usage-large"> · over 100 MB, which GitHub rejects without Git LFS</strong> }</li> }</ul>
                </details>
            </section>
        }
        @if (_plan is null) { if (_error is null) { <p role="status">Measuring what can be removed…</p> } }
        else if (!Parts.Any(p => _plan.Count(p) > 0)) { <p>There is nothing to remove. This project has no lossless archives, discarded media or leftover files.</p> }
        else
        {
            <p>Choose what to remove. Removed data cannot be recovered. Close this project in other windows first.</p>
            @foreach (var part in Parts.Where(p => _plan.Count(p) > 0))
            {
                var current = part;
                <label class="check-row"><input type="checkbox" data-part="@current" checked="@_parts.Contains(current)" disabled="@_busy" @onchange="e => Toggle(current, e.Value is true)" />@Label(current) · @StorageSize.Format(_plan.Bytes(current))</label>
                <p class="field-hint">@Hint(current)</p>
            }
            <p><strong>Frees about @StorageSize.Format(_parts.Sum(p => _plan.Bytes(p)))</strong></p>
        }
        @if (_progress is { } progress && _compactOpen) { <p role="status">@progress.Message</p> }
        @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
    </DialogContent>
    <DialogActions>
        @if (_busy) { <MudButton OnClick="() => _operation?.Cancel()">Stop</MudButton> }
        else { <MudButton OnClick="() => _compactOpen = false">Cancel</MudButton> }
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(_busy || _plan is null || _parts.Count == 0)" OnClick="CompactAsync">@(_busy ? "Compacting…" : "Remove permanently")</MudButton>
    </DialogActions>
</InlineDialog>

<InlineDialog Visible="_moveOpen" VisibleChanged="value => { if (!_busy) _moveOpen = value; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })"
              Class="project-folder-dialog" Title="Move to folder" Context="@Project.Name" CloseLabel="Close move to folder" CloseDisabled="_busy">
    <DialogContent>
        <ProjectFolderField Id="project-move-folder" Label="Destination folder" @bind-Value="_destination" Disabled="_busy">
            <Hint>Lumibelle creates the folder “@ProjectFolders.FolderName(Project.Name)” inside it and moves the project there. The project stays in your projects.</Hint>
        </ProjectFolderField>
        <p class="field-hint">Close this project in other windows first. A project with queued or working AI requests can’t be moved. Moving to another drive copies every file, which can take a while.</p>
        @if (_progress is { } progress) { <p role="status">@progress.Message @(progress.Bytes > 0 ? $" · {progress.Files} files · {Bytes(progress.Bytes)}" : "")</p> }
        @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
    </DialogContent>
    <DialogActions>
        @if (_busy) { <MudButton OnClick="() => _operation?.Cancel()">Cancel move</MudButton> }
        else { <MudButton OnClick="() => _moveOpen = false">Cancel</MudButton> }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_destination))" OnClick="MoveAsync">@(_busy ? "Moving…" : "Move project")</MudButton>
    </DialogActions>
</InlineDialog>

<InlineDialog Visible="_confirmRemove" VisibleChanged="value => { if (!_busy) _confirmRemove = value; }" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })"
              Title="Remove from library?" Context="@Project.Name" CloseLabel="Close remove from library" CloseDisabled="_busy">
    <DialogContent>
        <p>The folder and all its files stay where they are. You can add it again with <strong>Open project folder</strong> on Your projects.</p>
        @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_busy" OnClick="() => _confirmRemove = false">Keep in library</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RemoveAsync">Remove from library</MudButton>
    </DialogActions>
</InlineDialog>

@code {
    [Parameter, EditorRequired] public ProjectInfo Project { get; set; } = null!;
    private ProjectLocation? _location;
    private bool _loading = true, _busy, _moveOpen, _confirmRemove, _compactOpen, _disposed;
    private ProjectCompactionPlan? _plan;
    private readonly HashSet<CompactionPart> _parts = [];
    private static readonly CompactionPart[] Parts = Enum.GetValues<CompactionPart>();
    private string _destination = "";
    private string? _error, _notice;
    private ProjectPackageProgress? _progress;
    private CancellationTokenSource? _operation;
    private readonly CancellationTokenSource _lifetime = new();
    private static string Bytes(long bytes) => bytes >= 1024L * 1024 * 1024 ? $"{bytes / (1024d * 1024 * 1024):0.00} GiB" : $"{bytes / (1024d * 1024):0.0} MiB";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try { _location = await Folders.LocationAsync(Project.Id); }
        catch (WorkspaceStoreException e) { _error = e.Message; }
        finally { _loading = false; }
    }

    private void OpenMove() { _destination = ""; _error = null; _progress = null; _moveOpen = true; }

    private async Task MoveAsync()
    {
        if (_busy) return;
        _busy = true; _error = null; _notice = null;
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token); _operation = operation;
        var progress = new Progress<ProjectPackageProgress>(p => { if (!_disposed) _ = InvokeAsync(() => { _progress = p; StateHasChanged(); }); });
        try
        {
            _location = await Folders.MoveOutAsync(Project.Id, _destination, progress, operation.Token);
            _moveOpen = false; _notice = "Moved. Every change is now saved in the new folder.";
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested) { if (!_disposed) _error = "Move cancelled. The project is still in the library folder."; }
        catch (Exception e) when (e is ProjectStoreException or WorkspaceStoreException) { _error = e.Message; }
        finally { _operation = null; _busy = false; _progress = null; }
    }

    private async Task OpenCompactAsync()
    {
        _plan = null; _parts.Clear(); _error = null; _notice = null; _progress = null; _compactOpen = true;
        try
        {
            _plan = await Compaction.InspectAsync(Project.Id, _lifetime.Token);
            _parts.UnionWith(Parts.Where(p => _plan.Count(p) > 0));
        }
        catch (Exception e) when (e is ProjectStoreException or WorkspaceStoreException) { _error = e.Message; }
    }
    private void Toggle(CompactionPart part, bool selected) { if (selected) _parts.Add(part); else _parts.Remove(part); }
    private string Label(CompactionPart part) => part switch {
        CompactionPart.Trash => $"Empty this project's Trash ({Items(_plan!.Count(part), "item")})",
        CompactionPart.TakeArchives => $"Lossless take archives ({Items(_plan!.Count(part), "take")})",
        CompactionPart.ReelArchives => $"Lossless reel archives ({Items(_plan!.Count(part), "reel video")})",
        CompactionPart.ReelCandidates => $"Copies left by saved reels ({Items(_plan!.Count(part), "reel")})",
        CompactionPart.Backups => $"Migration backups ({Items(_plan!.Count(part), "file")})",
        _ => "Package manifest" };
    private static string Items(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";
    private static string Hint(CompactionPart part) => part switch {
        CompactionPart.Trash => "Deletes this project's discarded images, recordings, takes and reels permanently, as Empty Trash does. A reel's video stays while something still uses it.",
        CompactionPart.TakeArchives => "Takes keep their MP4 and play as before. Paused frames and new stills are then decoded from the MP4.",
        CompactionPart.ReelArchives => "Reels keep their MP4 and every keyframe already chosen, saved as a picture. New keyframes are then chosen from frames decoded from the MP4.",
        CompactionPart.ReelCandidates => "Each generated reel's video and lossless frames, left in its generation folder after the reel was saved to Assets. The saved reels keep their own.",
        CompactionPart.Backups => "Copies of production.json saved before an automatic upgrade. Lumibelle doesn't read them.",
        _ => "The manifest.json beside this folder describes the original project package and no longer matches it. The folder still opens without it." };

    private async Task CompactAsync()
    {
        if (_busy || _plan is null) return;
        _busy = true; _error = null; _notice = null;
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token); _operation = operation;
        var progress = new Progress<ProjectPackageProgress>(p => { if (!_disposed) _ = InvokeAsync(() => { _progress = p; StateHasChanged(); }); });
        try
        {
            var result = await Compaction.CompactAsync(_plan, _parts.ToHashSet(), progress, operation.Token);
            _notice = $"Compacted. Freed {StorageSize.Format(result.ReclaimedBytes)}.";
            if (result.Issues.Count > 0) _error = "Some items were kept: " + string.Join(" ", result.Issues.Distinct());
            _compactOpen = false;
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested) { if (!_disposed) _error = "Compaction stopped. What was already removed stays removed; nothing else changed."; }
        catch (Exception e) when (e is ProjectStoreException or WorkspaceStoreException) { _error = e.Message; }
        finally { _operation = null; _busy = false; _progress = null; }
    }

    private async Task RemoveAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            await Folders.RemoveAsync(Project.Id);
            if (ProjectRoutes is not null) await ProjectRoutes.RefreshAsync();
            Navigation.NavigateTo("/");
        }
        catch (Exception e) when (e is ProjectStoreException or WorkspaceStoreException) { _error = e.Message; }
        finally { _busy = false; }
    }

    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
