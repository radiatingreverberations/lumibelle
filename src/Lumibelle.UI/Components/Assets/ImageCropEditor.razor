@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="image-copy-crop">
    <p class="field-hint">@Hint</p>
    <div class="crop-stage" inert="@Disabled" data-max-zoom="@MaxZoom" data-free="@(Free ? "true" : "false")" style="@FormattableString.Invariant($"aspect-ratio:{Width}/{Height};--source-ratio:{Width / (double)Height}")" @ref="_stage">
        <img src="@Url" alt="@($"Source image for {SelectionLabel.ToLowerInvariant()}")" />
        <span class="crop-selection" style="@Style" data-x="@N(Region.X)" data-y="@N(Region.Y)" data-width="@N(Region.Width)" data-height="@N(Region.Height)" data-zoom="@N(_zoom)" aria-hidden="true">
            <i class="crop-handle top" data-crop-handle="top"></i><i class="crop-handle right" data-crop-handle="right"></i><i class="crop-handle bottom" data-crop-handle="bottom"></i><i class="crop-handle left" data-crop-handle="left"></i>
            @* Only a free shape can move two edges at once; a fixed shape resizes around its proportions. *@
            @if (Free) { <i class="crop-handle corner top-left" data-crop-handle="top-left"></i><i class="crop-handle corner top-right" data-crop-handle="top-right"></i><i class="crop-handle corner bottom-right" data-crop-handle="bottom-right"></i><i class="crop-handle corner bottom-left" data-crop-handle="bottom-left"></i> }
        </span>
    </div>
    <label>@SelectionLabel shape<select disabled="@Disabled" value="@_aspect" @onchange="ChangeShape">@foreach (var shape in Shapes) { <option>@shape</option> }</select></label>
    <details><summary>Precise @SelectionLabel.ToLowerInvariant() controls</summary><div class="crop-controls">
        @if (Free)
        {
            var pixels = Pixels;
            <label>Left<input disabled="@Disabled" aria-label="@($"{SelectionLabel} left")" type="number" min="0" max="@(Width - 1)" step="1" value="@pixels.X" @onchange="e => SetPixels(e, pixels, (p, v) => p with { X = v })" /></label>
            <label>Top<input disabled="@Disabled" aria-label="@($"{SelectionLabel} top")" type="number" min="0" max="@(Height - 1)" step="1" value="@pixels.Y" @onchange="e => SetPixels(e, pixels, (p, v) => p with { Y = v })" /></label>
            <label>Width<input disabled="@Disabled" aria-label="@($"{SelectionLabel} width")" type="number" min="1" max="@Width" step="1" value="@pixels.Width" @onchange="e => SetPixels(e, pixels, (p, v) => p with { Width = v })" /></label>
            <label>Height<input disabled="@Disabled" aria-label="@($"{SelectionLabel} height")" type="number" min="1" max="@Height" step="1" value="@pixels.Height" @onchange="e => SetPixels(e, pixels, (p, v) => p with { Height = v })" /></label>
        }
        else
        {
            <label>Zoom<input disabled="@Disabled" aria-label="@($"{SelectionLabel} zoom")" type="range" min="1" max="@MaxZoom" step="0.01" @bind="_zoom" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
            <label>Horizontal position<input disabled="@Disabled" aria-label="@($"{SelectionLabel} horizontal position")" type="range" min="0" max="100" step="1" @bind="_x" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
            <label>Vertical position<input disabled="@Disabled" aria-label="@($"{SelectionLabel} vertical position")" type="range" min="0" max="100" step="1" @bind="_y" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
        }
    </div></details>
    <div class="crop-size"><button disabled="@Disabled" type="button" @onclick="Reset">Full image</button><span class="field-hint">@Pixels.Width × @Pixels.Height pixels</span></div>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MaxZoom { get; set; } = 4;
    [Parameter] public string SelectionLabel { get; set; } = "Crop";
    [Parameter] public string Hint { get; set; } = "Drag the selection to position it, or use the shape and precise controls. The original image stays unchanged.";
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }
    [Parameter] public EventCallback<ImageCropRegion> CropChanged { get; set; }
    [Parameter] public ImageCropRegion? InitialCrop { get; set; }

    private const string Original = "Original", FreeShape = "Free";
    private static readonly string[] Shapes = [Original, FreeShape, "1:1", "4:3", "3:4", "16:9", "9:16"];
    // Fixed shapes are a zoom and a position within the largest rectangle of that shape; a free selection is its own rectangle.
    private string _aspect = Original; private double _zoom = 1, _x = 50, _y = 50;
    private ImageCropRegion _free = Full;
    private bool Free => _aspect == FreeShape;
    private static ImageCropRegion Full => new() { X = 0, Y = 0, Width = 1, Height = 1 };
    // Each side may shrink as far as the zoom limit allows a fixed shape to.
    private double MinSide => 1d / MaxZoom;
    private double Source => Width / (double)Height;

    protected override void OnInitialized()
    {
        if (InitialCrop is not { } crop) return;
        // Reopen a crop in the shape it was made with; anything else is free.
        var ratio = Source * crop.Width / crop.Height;
        var shape = Shapes.FirstOrDefault(s => s != FreeShape && Math.Abs(Ratio(s) / ratio - 1) < 0.002 && Fits(s, crop));
        if (shape is null) { _aspect = FreeShape; _free = crop; return; }
        _aspect = shape;
        _zoom = Math.Clamp(Base(shape).Width / crop.Width, 1, MaxZoom);
        _x = Focus(crop.X, crop.Width); _y = Focus(crop.Y, crop.Height);
    }
    private bool Fits(string shape, ImageCropRegion crop) => Base(shape).Width / crop.Width is var zoom && zoom >= 0.999 && zoom <= MaxZoom * 1.001;
    private double Ratio(string shape) => shape.Split(':') is [var w, var h] ? double.Parse(w, System.Globalization.CultureInfo.InvariantCulture) / double.Parse(h, System.Globalization.CultureInfo.InvariantCulture) : Source;
    // The largest selection of a shape, as fractions of the image.
    private (double Width, double Height) Base(string shape) => Ratio(shape) is var target && target >= Source ? (1, Source / target) : (target / Source, 1);
    private static double Focus(double offset, double size) => size >= 0.999999 ? 50 : Math.Clamp(offset / (1 - size) * 100, 0, 100);

    private ElementReference _stage; private IJSObjectReference? _module; private DotNetObjectReference<ImageCropEditor>? _reference;
    private bool _disposed;
    private ImageCropRegion Region
    {
        get
        {
            if (Free) return _free;
            var (w0, h0) = Base(_aspect);
            double w = w0 / _zoom, h = h0 / _zoom;
            return new() { X = (1 - w) * _x / 100, Y = (1 - h) * _y / 100, Width = w, Height = h };
        }
    }
    private SixLabors.ImageSharp.Rectangle Pixels => ImageGeometry.CropPixels(Width, Height, Region);
    private string Style => FormattableString.Invariant($"left:{Region.X * 100}%;top:{Region.Y * 100}%;width:{Region.Width * 100}%;height:{Region.Height * 100}%");
    private static string N(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("assets-studio.js"));
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachCropGestures", _stage, _reference);
    }
    private Task Changed() => CropChanged.InvokeAsync(Region);

    // Changing shape keeps the selection where it was: a free selection starts from the current one,
    // and a fixed shape is the largest of its kind inside the free selection, around the same centre.
    private Task ChangeShape(ChangeEventArgs e)
    {
        var shape = e.Value?.ToString() ?? Original;
        if (shape == _aspect) return Task.CompletedTask;
        var before = Region;
        _aspect = shape;
        if (Free) _free = before;
        else
        {
            var (w0, h0) = Base(shape);
            _zoom = Math.Clamp(Math.Max(w0 / before.Width, h0 / before.Height), 1, MaxZoom);
            double w = w0 / _zoom, h = h0 / _zoom;
            _x = Focus(Math.Clamp(before.X + before.Width / 2 - w / 2, 0, 1 - w), w);
            _y = Focus(Math.Clamp(before.Y + before.Height / 2 - h / 2, 0, 1 - h), h);
        }
        return Changed();
    }
    private Task SetPixels(ChangeEventArgs e, SixLabors.ImageSharp.Rectangle pixels, Func<SixLabors.ImageSharp.Rectangle, int, SixLabors.ImageSharp.Rectangle> set)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value)) return Task.CompletedTask;
        var next = set(pixels, value);
        int minWidth = (int)Math.Ceiling(Width * MinSide), minHeight = (int)Math.Ceiling(Height * MinSide);
        var width = Math.Clamp(next.Width, Math.Min(minWidth, Width), Width);
        var height = Math.Clamp(next.Height, Math.Min(minHeight, Height), Height);
        var left = Math.Clamp(next.X, 0, Width - width);
        var top = Math.Clamp(next.Y, 0, Height - height);
        // Inset by a hair so the outward-rounded pixel rectangle is exactly the one entered.
        const double hair = 0.001;
        _free = new()
        {
            X = (left + hair) / Width, Y = (top + hair) / Height,
            Width = (width - 2 * hair) / Width, Height = (height - 2 * hair) / Height
        };
        return Changed();
    }
    private Task Reset()
    {
        if (Free) _free = Full; else _aspect = Original;
        _zoom = 1; _x = _y = 50;
        return Changed();
    }
    [JSInvokable] public async Task ApplyCropGesture(double zoom, double x, double y)
    { if (_disposed || Disabled || Free) return; _zoom = Math.Clamp(zoom, 1, MaxZoom); _x = Math.Clamp(x, 0, 100); _y = Math.Clamp(y, 0, 100); await Changed(); await InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task ApplyFreeCrop(double x, double y, double width, double height)
    {
        if (_disposed || Disabled || !Free || !double.IsFinite(x + y + width + height)) return;
        width = Math.Clamp(width, Math.Min(MinSide, 1), 1); height = Math.Clamp(height, Math.Min(MinSide, 1), 1);
        _free = new() { X = Math.Clamp(x, 0, 1 - width), Y = Math.Clamp(y, 0, 1 - height), Width = width, Height = height };
        await Changed(); await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_module is not null) { await _module.InvokeVoidAsync("detachCropGestures", _stage); await _module.DisposeAsync(); } } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
