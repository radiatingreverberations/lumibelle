@inject IJSRuntime JS
<div class="crop-thumbnail" style="@BoxStyle">
    @if (Width > 0 && Height > 0)
    {
        <div class="crop-thumbnail-region" style="@RegionStyle">
            <img @ref="_image" src="@Url" alt="@Label" style="@ImageStyle" @onload="Measure" @onerror="Failed" />
        </div>
    }
    else
    {
        <span role="img" aria-label="@($"{Label} · unavailable")">Unavailable</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }
    [Parameter] public ImageCropRegion? Crop { get; set; }
    [Parameter] public bool MeasureImage { get; set; }
    [Parameter] public EventCallback Failed { get; set; }
    private ElementReference _image;
    private int[]? _size;
    private async Task Measure()
    {
        if (!MeasureImage) return;
        try {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Lumibelle.UI/reel-keyframes.js");
            _size = await module.InvokeAsync<int[]?>("imageSize", _image) ?? _size;
        }
        // A thumbnail removed while measuring keeps its stored size; it must not end the whole session.
        catch (Exception e) when (e is JSDisconnectedException or JSException or TaskCanceledException) { }
    }
    private int ActualWidth => _size is [> 0, > 0] ? _size[0] : Width;
    private int ActualHeight => _size is [> 0, > 0] ? _size[1] : Height;
    [Parameter] public int ThumbnailWidth { get; set; } = 58;
    [Parameter] public int ThumbnailHeight { get; set; } = 58;

    // Dimensions are already EXIF-oriented, just as they are for generation inputs.
    private SixLabors.ImageSharp.Rectangle Pixels => ImageGeometry.CropPixels(ActualWidth, ActualHeight, Crop ?? new());
    private string BoxStyle => FormattableString.Invariant($"width:{ThumbnailWidth}px;height:{ThumbnailHeight}px");
    private string RegionStyle
    {
        get
        {
            var pixels = Pixels;
            var scale = Math.Min(ThumbnailWidth / (double)pixels.Width, ThumbnailHeight / (double)pixels.Height);
            return FormattableString.Invariant($"width:{pixels.Width * scale:0.######}px;height:{pixels.Height * scale:0.######}px");
        }
    }
    private string ImageStyle
    {
        get
        {
            var pixels = Pixels;
            return FormattableString.Invariant($"left:{-pixels.X * 100d / pixels.Width:0.######}%;top:{-pixels.Y * 100d / pixels.Height:0.######}%;width:{100d * ActualWidth / pixels.Width:0.######}%;height:{100d * ActualHeight / pixels.Height:0.######}%");
        }
    }
}
