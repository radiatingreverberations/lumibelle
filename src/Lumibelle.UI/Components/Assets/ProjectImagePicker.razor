<section @ref="_picker" class="project-image-picker" aria-label="@(IncludeReels ? "Project reference picker" : "Project image picker")" tabindex="-1">
    <label>@(IncludeReels ? "Search references" : "Search images")<input type="search" @bind="_search" @bind:event="oninput" placeholder="Name, asset, tags…" /></label>
    <div class="picker-filters">
        @if (IncludeReels) {
            <label>Type<select aria-label="Reference type" @bind:get="EffectiveKind" @bind:set="ChangeKind" disabled="@(OnlyKind is not null)">
                <option>All</option><option>Images</option><option>Reels</option>
            </select></label>
        }
        <label>Asset<select aria-label="Asset" value="@_asset" @onchange="ChangeAsset"><option value="">All assets</option>@foreach (var asset in Library.Assets) { <option value="@asset.Id">@asset.Name</option> }</select></label>
        <label>Look<select aria-label="Look" @bind="_look"><option value="all">All looks</option><option value="general">General / unassigned</option>@foreach (var look in Library.Assets.Where(a => a.Id == _asset).SelectMany(a => a.Looks).Where(l => !l.Archived)) { <option value="@look.Id">@look.Name</option> }</select></label>
        @if (!IncludeReels || EffectiveKind == "Images") { <label>Origin<select aria-label="Origin" @bind="_origin"><option value="all">All images</option><option value="VideoFrame">Video frames</option><option value="Cropped">Cropped copies</option></select></label> }
    </div>
    @if (!BrowseOnly && _selected.Count > 0)
    {
        <ol class="picker-selection" aria-label="Selected reference order">@foreach (var reference in _selected) { <li><span>@Label(reference)</span><button aria-label="Remove @Label(reference) from selection" @onclick="() => Toggle(reference)">×</button></li> }</ol>
    }
    <div class="picker-grid">
        @foreach (var choice in Gallery.Take(_limit))
        {
            @if (choice is AssetReferenceChoice.Image imageChoice) {
            var item = (Asset: imageChoice.Asset, Image: imageChoice.Media);
            var reference = new AssetImageReference(item.Asset.Id, item.Image.Id); var selected = _selected.IndexOf(reference);
            <button @key="reference" class="picker-image @(Excluded.Contains(reference) ? "is-assigned" : "")" data-reference="@($"{reference.AssetId}/{reference.ImageId}")" title="@($"{ImageLabel(item.Asset, item.Image)} · {item.Image.Width} × {item.Image.Height}")" aria-pressed="@(selected >= 0 ? "true" : "false")" disabled="@(Excluded.Contains(reference) || selected < 0 && _selected.Count >= Maximum)" @onclick="() => Toggle(reference)">
                <span class="picker-image-preview">
                    <img src="@($"/media/projects/{Library.ProjectId}/assets/{item.Asset.Id}/images/{item.Image.Id}")" alt="" loading="lazy" />
                    @if (Excluded.Contains(reference)) { <span class="picker-image-badge">✓ Added</span> }
                    else if (selected >= 0) { <span class="picker-image-badge">✓ @(selected + 1)</span> }
                    else if (item.Image.IsReference) { <span class="picker-image-badge picker-approved">Reference</span> }
                </span>
                <span class="picker-image-caption">
                    <strong>@(!string.IsNullOrWhiteSpace(item.Image.Name) ? item.Image.Name : item.Image.Tags.Count > 0 ? string.Join(", ", item.Image.Tags) : item.Asset.Name)</strong>
                    <small>@(item.Asset.Looks.FirstOrDefault(l => l.Id == item.Image.LookId)?.Name ?? "General") · @item.Asset.Name</small>
                </span>
                @if (BrowseOnly) { <span class="picker-image-action">@(Excluded.Contains(reference) ? "Added" : Maximum <= 0 ? "Picture limit reached" : ImageAction ?? "Add image")</span> }
            </button>
            } else if (choice is AssetReferenceChoice.Reel reelChoice) {
                var reel = reelChoice.Media;
                var assigned = ExcludedVideoMedia.Contains(reel.Media.Id);
                var soundtrack = !reel.Media.HasAudio ? "Silent clip" : reel.Generation?.Recipe.VoiceMode == ReelVoiceMode.Silent ? "Soundtrack off by default" : "Soundtrack available";
                var look = reelChoice.Asset.Looks.FirstOrDefault(l => l.Id == reel.LookId)?.Name;
                <article class="picker-reel" @key="reel.Id" data-reel-id="@reel.Id">
                    <div class="reel-preview">
                    @if (_preview == reel.Id) { <video controls autoplay preload="metadata" poster="@ReferenceVideos.ThumbnailUrl(Library.ProjectId, reel.Media.Id)" src="@ReferenceVideos.Url(Library.ProjectId, reel.Media.Id)" aria-label="Preview @reel.Name"></video> }
                    else { <button type="button" class="reel-preview-button" aria-label="Preview @reel.Name" @onclick="() => _preview = reel.Id"><ReferenceVideoThumbnail ProjectId="Library.ProjectId" MediaId="reel.Media.Id" /><span class="reel-preview-label" aria-hidden="true">▶ Preview</span></button> }
                    <span class="reel-audio-badge" title="@soundtrack">@(!reel.Media.HasAudio ? "Silent" : reel.Generation?.Recipe.VoiceMode == ReelVoiceMode.Silent ? "Audio off" : "Audio")</span>
                    </div>
                    <div class="picker-reel-caption">
                        <strong title="@reel.Name">@reel.Name</strong>
                        <small title="@(reelChoice.Asset.Name + (look is null ? "" : " · " + look))">@reelChoice.Asset.Name@if (look is not null) { <span> · @look</span> }</small>
                        <small class="media-kind" title="@($"{reelChoice.Asset.Category} reel · {reel.Media.Duration:0.###} s · {VideoResolutions.Badge(reel)} · {VideoResolutions.Dimensions(reel)} · {soundtrack}")">Reel · @reel.Media.Duration.ToString("0.#") s · @VideoResolutions.Badge(reel.Media)</small>
                    </div>
                    <button type="button" class="add-reel" aria-label="@(ReelAction is null ? $"Add reel {reel.Name}" : $"{ReelAction} with {reel.Name}")" disabled="@(assigned || MaximumReels <= 0)" @onclick="() => PickReel(reelChoice)">@(assigned ? "Already selected" : ReelAction ?? "Add reel")</button>
                </article>
            }
        }
    </div>
    @if (!Gallery.Any()) { <p>No references match these filters.</p> }
    @if (Gallery.Count() > _limit) { <button @onclick="() => _limit += 48">Show more</button> }
    @if (!BrowseOnly) { <div class="picker-actions"><span role="status">@_selected.Count selected · @Maximum available slots</span><button @onclick="Cancelled">Cancel</button><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selected.Count == 0 || _selected.Count > Maximum)" OnClick="Confirm">Add selected images</MudButton></div> }
    @if (_error is not null) { <p role="alert">@_error</p> }
</section>
@code {
    [Parameter, EditorRequired] public AssetLibrary Library { get; set; } = default!;
    [Parameter] public IReadOnlyList<AssetImageReference> Excluded { get; set; } = [];
    [Parameter] public int Maximum { get; set; } = 9;
    [Parameter] public EventCallback<IReadOnlyList<AssetImageReference>> Selected { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    [Parameter] public bool IncludeReels { get; set; }
    [Parameter] public string? OnlyKind { get; set; }
    [Parameter] public int MaximumReels { get; set; } = 3;
    [Parameter] public string? ReelAction { get; set; }
    [Parameter] public string? ImageAction { get; set; }
    [Parameter] public IReadOnlyList<Guid> ExcludedVideoMedia { get; set; } = [];
    [Parameter] public EventCallback<AssetReferenceChoice> ReferencePicked { get; set; }
    [Parameter] public bool BrowseOnly { get; set; }
    [Parameter] public EventCallback<AssetImageReference> ImagePicked { get; set; }
    private readonly List<AssetImageReference> _selected = [];
    private string _kind = "All";
    private Guid? _preview;
    private string EffectiveKind => OnlyKind ?? _kind;
    private void ChangeKind(string? kind) { _kind = kind ?? "All"; _limit = 48; _preview = null; }
    private IEnumerable<AssetReferenceChoice> Gallery {
        get {
            IEnumerable<AssetReferenceChoice> images = Choices.Select(x => new AssetReferenceChoice.Image(x.Asset, x.Image));
            if (!IncludeReels) return images;
            if (EffectiveKind == "Reels") images = [];
            var reels = EffectiveKind == "Images" ? Enumerable.Empty<AssetReferenceChoice>() : Library.Reels
                .Select(r => (Reel: r, Asset: Library.Assets.FirstOrDefault(a => a.Id == r.AssetId)))
                .Where(x => x.Asset is not null && (x.Reel.LookId is null || x.Asset.Looks.Any(l => l.Id == x.Reel.LookId && !l.Archived)) &&
                    (_asset is null || x.Asset.Id == _asset) && (_look == "all" || _look == "general" && x.Reel.LookId is null || x.Reel.LookId?.ToString() == _look) &&
                    $"{x.Asset.Name} {x.Reel.Name} {x.Reel.UseGuidance}".Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Select(x => (AssetReferenceChoice)new AssetReferenceChoice.Reel(x.Asset!, x.Reel));
            return images.Concat(reels).OrderBy(x => x.Asset.Name, StringComparer.OrdinalIgnoreCase).ThenByDescending(x => x.CreatedUtc).ThenBy(x => x.Id);
        }
    }
    private async Task PickReel(AssetReferenceChoice.Reel choice) {
        if (MaximumReels <= 0 || ExcludedVideoMedia.Contains(choice.Media.Media.Id)) return;
        _focusAfterPick = true; await ReferencePicked.InvokeAsync(choice);
    }
    private string _search = "", _look = "all", _origin = "all";
    private string? _error;
    private Guid? _asset; private int _limit = 48;
    private ElementReference _picker;
    private bool _focusAfterPick;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Adding immediately disables that card. Keep keyboard focus inside the dialog.
        if (_focusAfterPick) { _focusAfterPick = false; await _picker.FocusAsync(preventScroll: true); }
    }
    private IEnumerable<(ReferenceAsset Asset, AssetImage Image)> Available => Library.Assets.SelectMany(a => a.Images
        .Where(i => i.LookId is null || a.Looks.Any(l => l.Id == i.LookId && !l.Archived)).Select(i => (a, i)));
    private IEnumerable<(ReferenceAsset Asset, AssetImage Image)> Choices => Available
        .Where(x => (_asset is null || x.Asset.Id == _asset) && (_look == "all" || _look == "general" && x.Image.LookId is null || x.Image.LookId?.ToString() == _look) &&
            ((IncludeReels && EffectiveKind != "Images") || _origin == "all" || x.Image.Origin.ToString() == _origin) &&
            $"{x.Asset.Name} {ImageLabel(x.Asset, x.Image)} {string.Join(' ', x.Image.Tags)}".Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.Image.IsReference).ThenBy(x => x.Asset.Name).ThenByDescending(x => x.Image.CreatedUtc).ThenBy(x => x.Image.Id);
    private static string ImageLabel(ReferenceAsset asset, AssetImage image) => !string.IsNullOrWhiteSpace(image.Name) ? image.Name : image.Tags.Count > 0 ? string.Join(", ", image.Tags) : $"{asset.Name} · {image.CreatedUtc.ToLocalTime():d MMM HH:mm} · {image.Id.ToString()[..6]}";
    private string Label(AssetImageReference reference) { var item = Available.FirstOrDefault(x => x.Asset.Id == reference.AssetId && x.Image.Id == reference.ImageId); return item.Image is null ? "Unavailable image" : ImageLabel(item.Asset, item.Image); }
    private void ChangeAsset(ChangeEventArgs e) { _asset = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null; _look = "all"; _limit = 48; }
    private async Task Toggle(AssetImageReference reference)
    {
        if (BrowseOnly) {
            if (Maximum > 0 && !Excluded.Contains(reference)) {
                _focusAfterPick = true;
                if (IncludeReels && ReferencePicked.HasDelegate) { var item = Available.First(x => x.Asset.Id == reference.AssetId && x.Image.Id == reference.ImageId); await ReferencePicked.InvokeAsync(new AssetReferenceChoice.Image(item.Asset, item.Image)); }
                else await ImagePicked.InvokeAsync(reference);
            }
            return;
        }
        if (_selected.Remove(reference)) return; if (_selected.Count < Maximum && !Excluded.Contains(reference)) _selected.Add(reference);
    }
    private async Task Confirm()
    {
        if (_selected.Count == 0 || _selected.Count > Maximum || _selected.Any(r => Excluded.Contains(r) || !Available.Any(x => x.Asset.Id == r.AssetId && x.Image.Id == r.ImageId)))
        { _error = "The available images changed. Remove unavailable selections and review them before adding."; return; }
        await Selected.InvokeAsync(_selected.ToArray());
    }
}
