@inherits ProjectAwareComponent
@implements IAsyncDisposable
@inject IReferenceVideoStore MediaStore
@inject IAiSettingsStore Settings
@inject IJSRuntime JS
@inject IAssetStore AssetStore

<section class="keyframe-editor" aria-label="Reel keyframes">
    <div class="keyframe-body">
        <p class="field-hint">Save useful viewpoints as keyframes for later shots. Suggest views can choose and name them, or add frames manually.</p>
        @if (_catalog is null) { <p role="status">@(_busy ? "Reading reel frames…" : "Reel frames unavailable.")</p> }
        else {
            <div class="keyframe-columns">
                <section class="keyframe-player">
                    <header class="keyframe-section-heading"><h3>Preview</h3><span>Frame @(_index + 1) · @_catalog.Timestamps[_index].ToString("0.###") s</span></header>
                    <video @ref="_player" controls preload="metadata" src="@ReferenceVideos.Url(ProjectId, Media.Id)" aria-label="Reel keyframe playback"></video>
                    <label>Frame timeline<input type="range" min="0" max="@(_catalog.Timestamps.Count - 1)" value="@_index" @onchange="Timeline" disabled="@_busy" /></label>
                    <div class="keyframe-step-controls"><button @onclick="() => Step(-1)" disabled="@_busy">Previous frame</button><button @onclick="() => Step(1)" disabled="@_busy">Next frame</button></div>
                    <div class="keyframe-preview-actions">
                        <button class="add-frame" @onclick="AddCurrent" disabled="@(_busy || _draft.Frames.Count >= 9 && _replace is null)">@(_replace is null ? "Add current frame" : "Replace with current frame")</button>
                        <button @ref="_exportButton" @onclick="OpenExport" disabled="@_busy">Save frame to Assets…</button>
                    </div>
                    @if (_replace is { } replacing) { <div class="keyframe-replacing" role="status"><span>Choose a frame to replace @ReelViewSuggestions.Label(_draft.Frames.Single(p => p.Id == replacing), _draft.Frames.FindIndex(p => p.Id == replacing) + 1).</span><button @onclick="() => _replace = null">Cancel replacement</button></div> }
                    <details class="exact-frame-details"><summary>Exact extracted frame · @(_catalog.Lossless ? "Lossless" : "MP4")</summary>
                        <p class="field-hint">Picks use this extracted picture, independent of the playback preview.</p>
                        <img class="exact-frame" src="@ReferenceVideos.FrameUrl(ProjectId, CurrentFrame)" alt="Exact frame at @_catalog.Timestamps[_index].ToString("0.###") seconds" />
                    </details>
                </section>
                <section class="keyframe-selection">
                    <header class="keyframe-section-heading"><h3>Selected views</h3><button @onclick="Undo" disabled="@(_busy || _undo is null)">Undo picks</button></header>
                    <ReelViewAssistant ProjectId="ProjectId" Media="Media" Current="_draft" Count="ViewLimit" Disabled="_busy" RequestedJobId="RequestedJobId" Staged="StageSuggestedViews">
                        <ToolbarActions>
                            <div class="keyframe-view-limit"><label>Views<select aria-label="View limit" @bind="_viewLimit" disabled="@_busy"><option value="auto">Automatic</option>@foreach (var count in Enumerable.Range(1, 9)) { <option value="@count">Up to @count</option> }</select></label></div>
                        </ToolbarActions>
                    </ReelViewAssistant>
                    @if (_notice is not null) { <p class="keyframe-notice" role="status">@_notice</p> }
                    <ol class="keyframe-list">
                        @foreach (var pick in _draft.Frames) {
                            var position = _draft.Frames.IndexOf(pick);
                            <li @key="pick.Id">
                                <div class="keyframe-card-heading">
                                    <button class="keyframe-pick" aria-label="Inspect keyframe @(position + 1)" @onclick="() => Inspect(pick)"><CropThumbnail MeasureImage="true" Url="@ReferenceVideos.FrameUrl(ProjectId, pick.Frame)" Label="@ReelViewSuggestions.Label(pick, position + 1)" Width="Media.Width" Height="Media.Height" Crop="pick.Crop" /><span><strong>@ReelViewSuggestions.Label(pick, position + 1)</strong><small>@pick.Frame.Seconds.ToString("0.###") s</small></span></button>
                                    <div class="keyframe-order"><button disabled="@(_busy || position == 0)" aria-label="Move keyframe @(position + 1) up" @onclick="() => Move(pick, -1)">↑</button><button disabled="@(_busy || position == _draft.Frames.Count - 1)" aria-label="Move keyframe @(position + 1) down" @onclick="() => Move(pick, 1)">↓</button></div>
                                </div>
                                <div class="keyframe-fields">
                                    <label>View name (optional)<input maxlength="160" @bind="pick.Name" @bind:event="oninput" disabled="@_busy" /></label>
                                    <label>Frame notes (optional)<input maxlength="20000" @bind="pick.Notes" @bind:event="oninput" disabled="@_busy" /></label>
                                </div>
                                <div class="keyframe-card-footer">
                                    <div class="keyframe-card-actions"><button disabled="@_busy" @onclick="() => _replace = pick.Id">Replace</button><button disabled="@_busy" @onclick="() => Remove(pick)">Remove</button></div>
                                    <details><summary>Crop keyframe</summary><div class="crop-preview"><img src="@ReferenceVideos.FrameUrl(ProjectId, pick.Frame)" alt="Crop source" /><span style="@CropStyle(pick)"></span></div>
                                        @foreach (var field in new[] { "Width", "Height", "Horizontal", "Vertical" }) {
                                            <label>@field<input type="range" min="@(field is "Width" or "Height" ? "0.05" : "0")" max="@CropMax(pick, field)" step="0.01" value="@CropValue(pick, field)" @oninput="e => CropChanged(pick, field, e)" disabled="@_busy" /></label>
                                        }
                                        <button disabled="@_busy" @onclick="() => pick.Crop = null">Full image</button>
                                    </details>
                                </div>
                            </li>
                        }
                    </ol>
                    <details class="keyframe-selection-tools"><summary>More selection tools</summary>
                        <p class="field-hint">Quick picks uses sharpness and visual differences without AI. It replaces the pending picks without adding view names or notes.</p>
                        <button @onclick="AutoPick" disabled="@_busy">Quick picks</button>
                    </details>
                </section>
            </div>
        }
    </div>
    <footer class="keyframe-footer">
        @if (_error is not null) { <p role="alert">@_error</p> }
        @if (_savedImage is { } savedImage) { <p role="status">Frame saved as an image. <a href="@(ProjectLink(ProjectId, $"/assets?assetId={savedImage.AssetId}&imageId={savedImage.ImageId}"))">View in Assets</a></p> }
        <span role="status">@(_busy ? "Preparing keyframes…" : $"{_draft.Frames.Count}/9 selected frames")</span>
        <button disabled="@_saving" @onclick="Cancel">Cancel</button><button class="primary" disabled="@(_busy || _catalog is null || _draft.Frames.Count == 0)" @onclick="Save">@SaveLabel</button>
    </footer>
</section>

<InlineDialog Visible="_exportFrame is not null" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false })" Class="reel-frame-export-dialog" Title="Save reel frame to Assets"><DialogContent>
@if (_exportFrame is { } export && _exportReel is { } exportReel && _exportLibrary is { } exportLibrary) {
    <div class="reel-frame-export">
        <img src="@ReferenceVideos.FrameUrl(ProjectId, export.Frame)" alt="Frame @(export.Frame.Index + 1) from @exportReel.Name" />
        <ImageCopyPanel @key="export" ProjectId="ProjectId" Library="exportLibrary" ReelFrame="export" ShowHeading="false"
            InitialAssetId="exportReel.AssetId" InitialLookId="exportReel.LookId"
            InitialName="@(_draft.Frames.FirstOrDefault(f => f.Frame == export.Frame)?.Name is { Length: > 0 } name ? $"{exportReel.Name} · {name}" : $"{exportReel.Name} · {export.Frame.Seconds.ToString("0.###")} s")"
            InitialNotes="@(_draft.Frames.FirstOrDefault(f => f.Frame == export.Frame)?.Notes ?? "")"
            FrameDescription="@($"Frame {export.Frame.Index + 1} · {export.Frame.Seconds:0.###} s · {(_catalog!.Lossless ? "Lossless archive source" : "Compressed MP4 source")}. Saved as an independent image.")"
            Save="SaveExport" Saved="ExportSaved" Cancelled="CloseExport" />
    </div>
}
</DialogContent></InlineDialog>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? RequestedJobId { get; set; }
    [Parameter, EditorRequired] public ReferenceVideoMedia Media { get; set; } = null!;
    [Parameter] public ReelKeyframeSet? Initial { get; set; }
    [Parameter] public EventCallback<ReelKeyframeSet> Applied { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    [Parameter] public string SaveLabel { get; set; } = "Save keyframes";
    [Parameter] public Func<DerivedImageRequest, Task<SavedAssetImage>>? SaveImage { get; set; }
    [Parameter] public EventCallback<SavedAssetImage> ImageSaved { get; set; }
    private ReelFrameExport? _exportFrame;
    private AssetLibrary? _exportLibrary;
    private AssetReferenceReel? _exportReel;
    private SavedAssetImage? _savedImage;
    private ElementReference _exportButton;
    private bool _focusExport;
    private ReelKeyframeSet _draft = new(); private ReelKeyframeSet? _undo;
    private ReelFrameCatalog? _catalog; private H3Settings _settings = new();
    private string _viewLimit = "auto";
    private int ViewLimit => int.TryParse(_viewLimit, out var count) ? count : 9;
    private int _index; private bool _busy, _disposed, _saving; private Guid? _replace;
    private string? _error, _notice;
    private readonly CancellationTokenSource _lifetime = new();
    private ElementReference _player; private IJSObjectReference? _module;
    private ReelFrameIdentity CurrentFrame => new(Media.Id, _catalog!.Source, _index, _catalog.Timestamps[_index]);
    protected override async Task OnInitializedAsync()
    {
        _draft = Initial is null ? new() : ShotCopy.Of(Initial);
        await Work(async () => {
            _settings = (await Settings.LoadAsync(_lifetime.Token)).H3;
            _catalog = await MediaStore.FrameCatalogAsync(ProjectId, Media, _settings, _lifetime.Token);
            if (Initial is null) await Suggest();
        });
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_focusExport) { _focusExport = false; await _exportButton.FocusAsync(); }
        if (_catalog is not null && !string.IsNullOrEmpty(_player.Id) && _module is null && !_disposed)
        { _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("reel-keyframes.js")); await _module.InvokeVoidAsync("track", _player); }
    }
    private async Task Work(Func<Task> work)
    {
        if (_busy) return; _busy = true; _error = null;
        try { await work(); } catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception e) { _error = e.Message; } finally { _busy = false; }
    }
    private async Task Suggest()
    {
        var suggestion = await MediaStore.SuggestFramesAsync(ProjectId, Media, ViewLimit, _settings, _lifetime.Token);
        _undo = ShotCopy.Of(_draft); _draft = suggestion; _replace = null;
        _notice = $"Found {suggestion.Frames.Count} distinct usable views from sharpness and visual differences.";
    }
    private Task AutoPick() => Work(Suggest);
    private void StageSuggestedViews(ReelKeyframeSet frames) { _undo = ShotCopy.Of(_draft); _draft = ShotCopy.Of(frames); _replace = null; _notice = "Review the suggested views, then save keyframes."; }
    private void Undo() { if (_undo is null) return; (_draft, _undo) = (_undo, _draft); _replace = null; }
    private async Task Seek(int index)
    {
        if (_catalog is null) return; _index = Math.Clamp(index, 0, _catalog.Timestamps.Count - 1);
        var start = _catalog.PlaybackOrigin + _catalog.Timestamps[_index];
        var end = _index + 1 < _catalog.Timestamps.Count ? _catalog.PlaybackOrigin + _catalog.Timestamps[_index + 1] : Math.Max(start, Media.Duration);
        if (_module is not null) await _module.InvokeVoidAsync("seek", _player, start, end);
    }
    private Task Timeline(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var i) ? Seek(i) : Task.CompletedTask;
    private Task Inspect(ReelKeyframe pick) => Seek(pick.Frame.Index);
    private async Task ReadPosition()
    {
        if (_catalog is null || _module is null) return;
        var time = await _module.InvokeAsync<double>("position", _player) - _catalog.PlaybackOrigin;
        _index = Enumerable.Range(0, _catalog.Timestamps.Count).LastOrDefault(i => _catalog.Timestamps[i] <= time + .00001);
    }
    private async Task Step(int by) { await ReadPosition(); await Seek(_index + by); }
    private Task AddCurrent() => Work(async () => {
        if (_catalog is null) return;
        await ReadPosition();
        var identity = CurrentFrame;
        if (_draft.Frames.Any(f => f.Frame == identity && f.Id != _replace)) throw new WorkspaceStoreException("This frame is already selected.");
        await using var exact = await MediaStore.OpenFrameAsync(ProjectId, identity, _settings, _lifetime.Token);
        _undo = ShotCopy.Of(_draft);
        if (_replace is { } id && _draft.Frames.FindIndex(f => f.Id == id) is var at && at >= 0) _draft.Frames[at] = new() { Id = id, Frame = identity };
        else if (_draft.Frames.Count < 9) _draft.Frames.Add(new() { Frame = identity });
        _replace = null; _notice = null;
    });
    private Task OpenExport() => Work(async () => {
        if (_catalog is null) return;
        await ReadPosition(); await Seek(_index);
        _exportLibrary = await AssetStore.LoadAsync(ProjectId, _lifetime.Token);
        _exportReel = _exportLibrary.Reels.FirstOrDefault(r => r.Media.Id == Media.Id)
            ?? throw new WorkspaceStoreException("Restore the source reel before saving a frame.");
        _exportFrame = new(_exportReel.Id, CurrentFrame);
    });
    private async Task<SavedAssetImage> SaveExport(DerivedImageRequest request)
    {
        if (SaveImage is not null) return await SaveImage(request);
        var library = await AssetStore.LoadAsync(ProjectId, _lifetime.Token);
        return await AssetStore.SaveDerivedImageAsync(ProjectId, request, library.Revision, _lifetime.Token);
    }
    private void CloseExport() { _exportFrame = null; _focusExport = true; }
    private async Task ExportSaved(SavedAssetImage result)
    {
        _savedImage = result; CloseExport(); await ImageSaved.InvokeAsync(result);
    }
    private void Move(ReelKeyframe pick, int by) { var at = _draft.Frames.IndexOf(pick); _undo = ShotCopy.Of(_draft); _draft.Frames.RemoveAt(at); _draft.Frames.Insert(at + by, pick); }
    private void Remove(ReelKeyframe pick) { _undo = ShotCopy.Of(_draft); _draft.Frames.Remove(pick); if (_replace == pick.Id) _replace = null; }
    private Task Save() => Work(async () => {
        ReferenceVideos.ValidateKeyframes(Media, _draft);
        await MediaStore.PrepareFramesAsync(ProjectId, _draft.Frames.Select(f => f.Frame), _settings, _lifetime.Token);
        _saving = true;
        try { await Applied.InvokeAsync(ShotCopy.Of(_draft)); } finally { _saving = false; }
    });
    private async Task Cancel() { await _lifetime.CancelAsync(); await Cancelled.InvokeAsync(); }
    private static string N(double n) => n.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string CropStyle(ReelKeyframe f) { var c = f.Crop ?? new(); return $"left:{N(c.X*100)}%;top:{N(c.Y*100)}%;width:{N(c.Width*100)}%;height:{N(c.Height*100)}%"; }
    private static string CropMax(ReelKeyframe f, string field) => N(field == "Horizontal" ? 1 - (f.Crop?.Width ?? 1) : field == "Vertical" ? 1 - (f.Crop?.Height ?? 1) : 1);
    private static string CropValue(ReelKeyframe f, string field) { var c = f.Crop ?? new(); return N(field switch { "Width" => c.Width, "Height" => c.Height, "Horizontal" => c.X, _ => c.Y }); }
    private static void CropChanged(ReelKeyframe f, string field, ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value)) return;
        var c = f.Crop ?? new(); c = field switch { "Width" => c with { Width = value }, "Height" => c with { Height = value }, "Horizontal" => c with { X = value }, _ => c with { Y = value } };
        f.Crop = c with { X = Math.Clamp(c.X, 0, 1-c.Width), Y = Math.Clamp(c.Y, 0, 1-c.Height) };
    }
    public async ValueTask DisposeAsync() { _disposed = true; await _lifetime.CancelAsync(); if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _player); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } _lifetime.Dispose(); }
}
