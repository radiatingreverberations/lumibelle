@implements IAsyncDisposable

<section class="prompt-enhancement" aria-label="Prompt enhancement" @ref="_origin">
    <TextAssistance Request="EnhancementPresentation" Preparing="_submitting" HasError="@(_pending is not null)" ReviewRequested="InspectEnhancement" CancelRequested="CancelRequest" @ref="_assist" ProjectId="Context.ProjectId" Studio="TextAssistantStudio.PromptEnhancement" Label="Improve prompt" Title="Improve prompt" Disabled="@(Blocked || string.IsNullOrWhiteSpace(Context.Prompt))" ModelLocked="@(Blocked || _busy)" SelectionChanged="ModelChanged" Opened="LoadSettings">
        <ChildContent><p class="field-hint">@Context.AssetName · @Context.Workflow.Label() · @(Context.IsEdit ? "Edit" : "Create")</p>
    <label class="enhancement-direction">Direction for AI<textarea rows="2" maxlength="20000" placeholder="For example: make the lighting warmer and keep the banners in view." @bind="_direction" @bind:event="oninput" disabled="@(Blocked || _busy)"></textarea></label>
    <fieldset class="composition-context" disabled="@(Blocked || _busy)"><legend class="sr-only">Request context</legend>
        @* The prompt guide and notes are always sent; the row only shows what they cost. *@
        <label class="check-row composition-context-fixed" title="Your prompt and direction, the workflow's prompt guide, and the asset and reference notes are always sent."><input type="checkbox" checked disabled /><span>Prompt, guide and notes</span>
            <span class="composition-context-tokens" data-context="text">@($"≈{TextTokens:N0} tokens")</span></label>
        @if (Context.IsEdit)
        {
            <label class="check-row inspect-references"><input type="checkbox" aria-label="Inspect reference images" @bind="_inspect" /><span>Inspect reference images · @Context.References.Count image@(Context.References.Count == 1 ? "" : "s")</span>
                <span class="composition-context-tokens" data-context="images">@(ImageTokens is { } images ? $"≈{images:N0} tokens" : "")</span></label>
        }
    </fieldset>
    @if (Context.IsEdit && _inspect)
    {
        <p class="field-hint">Sends the images, with their submitted crops, to @_model?.Model.Name through @_model?.Model.Backend.</p>
        @if (VisionIssue is { } issue) { <p class="field-error" role="status">@issue</p> }
    }
@if (_inlineError is not null) { <p role="alert">@_inlineError</p> }</ChildContent>
        <Actions><MudButton Class="enhance-button ai-assist-action" OnClick="Start" Disabled="@(!CanEnhance)" Variant="Variant.Filled" Color="Color.Primary"><AiAssistIcon />Enhance</MudButton></Actions>
    </TextAssistance>
    @if (_pending is not null) { <button @onclick="RetryEnqueue" disabled="@_submitting">Retry saving request</button> }
    @if (_undoContext is not null)
    { <button class="prompt-undo" type="button" @onclick="Undo" disabled="@(Blocked || _busy)">Undo enhancement</button> }
    @if (_inlineError is not null) { <p class="field-error" role="alert">@_inlineError</p> }
</section>

<InlineDialog Visible="_open" VisibleChanged="VisibilityChanged" Options="Options" Class="prompt-enhancement-dialog" DefaultFocus="DefaultFocus.FirstChild" OnKeyDown="DialogKeyDown">
    <TitleContent><h2>Enhance prompt</h2></TitleContent>
    <DialogContent>
        <lumibelle.Components.AI.AiResultAcknowledgement Observed="@(_observedResultJob is { } read && read.Id == _job?.Id ? new[] { read } : [])" />
        <MudIconButton Class="review-close dialog-close" Icon="@Icons.Material.Outlined.Close" OnClick="Close" aria-label="Close prompt enhancement" />
        @if (_request is { } request)
        {
            @if (_job is { } capturedJob) { <AiTextRequestDetails JobId="capturedJob.Id" /> }
            <p class="enhancement-attribution">@request.Context.Workflow.Label() · @(request.Context.IsEdit ? "Edit" : "Create") · @request.Model.Backend · @request.Model.Name</p>
            @if (!string.IsNullOrWhiteSpace(request.Direction)) { <p class="enhancement-direction-used"><strong>Direction:</strong> @request.Direction</p> }
            @if (_job is { } job)
            { <lumibelle.Components.AI.AiJobProgressView Job="job" Queue="Jobs.View" Progress="Jobs.Progress(job.Id)" /> }
            @if (_busy) { <p class="field-hint">You can close this preview or leave Assets. The request keeps running in AI activity.</p> }
            <div class="enhancement-comparison@(ReplacesEdited ? " with-current" : "")">
                <section><label for="enhancement-original">Original prompt</label><textarea id="enhancement-original" readonly rows="10" value="@request.Context.Prompt"></textarea></section>
                @if (ReplacesEdited) { <section><label for="enhancement-current">Current prompt, replaced when applied</label><textarea id="enhancement-current" readonly rows="10" value="@Context.Prompt"></textarea></section> }
                <section><label for="enhancement-suggestion">Suggested prompt</label><textarea id="enhancement-suggestion" rows="10" @bind="_suggestion" @bind:event="oninput"
                    disabled="@(_busy || _result?.Kind != PromptEnhancementKind.Prompt)" placeholder="Your suggestion will appear here."></textarea></section>
            </div>
            @if (_result is { Kind: not PromptEnhancementKind.Prompt } result)
            { <p role="status" class="enhancement-clarification"><strong>@(result.Kind == PromptEnhancementKind.NeedsInput ? "More detail needed: " : "Setup change needed: ")</strong>@result.Text Return to the prompt to make this change, then enhance again.</p> }
            @if (Superseded is { } superseded) { <p class="field-hint" role="status">@superseded</p> }
            @* Restoring the captured composer controls lets the suggestion apply to the setup it was written for. *@
            @if (request.Context.Fingerprint() != Context.Fingerprint()) { <button @onclick="RestoreSetup" disabled="@(_busy || _applying || Blocked)">Load captured prompt setup</button> }
            @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
            @if (!string.IsNullOrEmpty(_raw))
            { <details class="enhancement-response"><summary>Response details</summary><pre>@_raw</pre></details> }
        }
    </DialogContent>
    <DialogActions>
        @if (_request is not null && Superseded is null && Changed is { } changed) { <AssistedApplyWarning Changed="changed" Retry="enhance again" Consequence="Applying can be undone." /> }
        @if (!_busy && InspectionJob is { } inspected && !TextRequestPresentation.IsActive(inspected)) { <MudButton OnClick="NewRequestFromReview">New request</MudButton> }
        @if (CanDiscard) { <MudButton OnClick="DiscardSuggestion">Discard</MudButton> }
        <MudButton OnClick="ApplySuggestion" Disabled="@(!CanApply)" Color="Color.Primary" Variant="Variant.Filled">@(Changed is null ? "Apply changes" : AssistedApplyWarning.ApplyAnyway)</MudButton>
        @if (!_busy && _error is not null && Changes.Count == 0 && _pending is null)
        { <MudButton OnClick="Retry" Disabled="@Blocked" Variant="Variant.Outlined">Retry</MudButton> }
        @if (_active is not null) { <MudButton OnClick="CancelRequest">Cancel enhancement</MudButton> }
        <MudButton OnClick="Close">@(_result is { Kind: not PromptEnhancementKind.Prompt } ? "Back to prompt" : "Close")</MudButton>
    </DialogActions>
</InlineDialog>

@* Request execution is application-owned; the code-behind only captures and reviews it. *@
