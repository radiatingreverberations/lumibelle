<section class="character-look-overview" aria-label="Character looks overview">
    <details open>
        <summary>Looks <span>@Asset.Looks.Count(l => !l.Archived)</span></summary>
        <p class="look-overview-hint">Choose an appearance to prepare its image prompt and references.</p>
        <div class="look-cards">
            @foreach (var look in Asset.Looks.Where(l => !l.Archived))
            {
                var count = Asset.Images.Count(i => i.LookId == look.Id && i.PendingReview != true);
                <article class="look-card @(Selected == look.Id ? "selected" : "")" data-look-id="@look.Id" @key="look.Id" aria-label="@look.Name">
                    <div class="look-card-heading"><h3>@look.Name</h3><span>@count @(count == 1 ? "image" : "images")</span></div>
                    <CharacterLookInfo Look="look" Disabled="Disabled" Create="Create" Manage="Manage" />
                </article>
            }
        </div>
    </details>
</section>

@code {
    [Parameter, EditorRequired] public ReferenceAsset Asset { get; set; } = default!;
    [Parameter] public Guid? Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid> Create { get; set; }
    [Parameter] public EventCallback<Guid> Manage { get; set; }
}
