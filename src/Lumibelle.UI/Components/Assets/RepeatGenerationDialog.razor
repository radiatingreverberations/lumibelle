<InlineDialog Visible="Visible" VisibleChanged="VisibilityChanged" Options="Options" DefaultFocus="DefaultFocus.FirstChild" Class="repeat-generation-dialog" Title="@Title" CloseLabel="Close regenerate">
    <DialogContent>
        <p>@Description</p>
        <dl class="repeat-generation-summary"><dt>Save to</dt><dd>@Destination</dd><dt>Settings</dt><dd>@Summary</dd></dl>
        <div class="repeat-generation-options">
            <label class="repeat-count">Takes
                <select aria-label="Take count" @bind="_count" disabled="@(Locked || Busy || _sameSeed)">
                    @for (var count = 1; count <= 4; count++) { <option value="@count">@count</option> }
                </select>
            </label>
            @if (SourceSeed is { } seed) {
                <label class="repeat-seed"><input type="checkbox" checked="@_sameSeed" @onchange="ChangeSeed" disabled="@(Locked || Busy)" /> Use original seed</label>
                <p class="field-hint">Original seed @seed</p>
            }
        </div>
        @ChildContent
        <details><summary>Saved prompt</summary><pre class="submitted-input">@Prompt</pre></details>
        @if (Notice is not null) { <p class="field-hint">@Notice</p> }
        @if (Error is not null) { <p class="field-error" role="alert">@Error</p> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="Busy" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton OnClick="Confirm" Disabled="Busy" Variant="Variant.Filled" Color="Color.Primary" Style="min-width:9rem">@(Busy ? "Queueing…" : $"Queue {_count} {Kind}{(_count == 1 ? "" : "s")}")</MudButton>
    </DialogActions>
</InlineDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Generate more images";
    [Parameter] public string Description { get; set; } = "Add takes using the saved prompt, references and settings, with a new seed for each take.";
    [Parameter] public string Kind { get; set; } = "image";
    [Parameter] public string Destination { get; set; } = "";
    [Parameter] public string Summary { get; set; } = "";
    [Parameter] public string Prompt { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Locked { get; set; }
    [Parameter] public int InitialCount { get; set; } = 1;
    [Parameter] public bool InitialKeepSeed { get; set; }
    [Parameter] public long? SourceSeed { get; set; }
    [Parameter] public string? Notice { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<Choices> Confirmed { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private DialogOptions Options => new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = !Busy };
    private int _count = 1, _randomCount = 1;
    private bool _sameSeed, _wasVisible;
    public sealed record Choices(int Count, bool KeepSeed);
    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible) { _randomCount = Math.Clamp(InitialCount, 1, 4); _sameSeed = InitialKeepSeed && SourceSeed is not null; _count = _sameSeed ? 1 : _randomCount; }
        _wasVisible = Visible;
    }
    private void ChangeSeed(ChangeEventArgs args)
    {
        if (Busy || Locked) return;
        _sameSeed = args.Value is true;
        if (_sameSeed) { _randomCount = _count; _count = 1; } else _count = _randomCount;
    }
    private Task Cancel() => Busy ? Task.CompletedTask : Closed.InvokeAsync();
    private Task Confirm() => Busy ? Task.CompletedTask : Confirmed.InvokeAsync(new(_count, _sameSeed));
    private Task VisibilityChanged(bool visible) => visible ? Task.CompletedTask : Cancel();
}
