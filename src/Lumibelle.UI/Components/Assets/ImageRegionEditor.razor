@implements IAsyncDisposable
@inject IAssetStore AssetStore
@inject IJSRuntime JS
@* A per-opening MudDialog: Escape goes through DialogEscape so painted strokes are guarded like the close button. *@
<MudDialog @ref="_dialog" Visible="_visible" Options="Options" Class="region-editor-dialog media-details-dialog">
    <TitleContent><DialogHeader Title="@Title" Context="@Label" CloseLabel="@($"Close {Title.ToLowerInvariant()}")" Close="RequestCancel" CloseDisabled="_busy" /></TitleContent>
    <DialogContent>
        <DialogEscape Pressed="RequestCancel" />
        @if (_selection is not null)
        {
            <div class="region-controls">
                @if (EditArea) { <label>Paint<select @bind="_layer" @bind:after="Render"><option value="edit">Edit pixels</option><option value="context">Input crop</option></select></label> }
                <label>Tool<select @bind="_tool" @bind:after="Render"><option value="brush">Brush</option><option value="rectangle">Rectangle</option><option value="erase">Eraser</option><option value="pan">Pan</option></select></label>
                <label>Brush size<input type="range" min="1" max="30" @bind="_brush" @bind:after="Render" /> @_brush%</label>
                <label>Zoom<input type="range" min="100" max="400" step="25" @bind="_zoom" @bind:after="Render" /> @_zoom%</label>
                <button disabled="@(_undo.Count == 0)" @onclick="Undo">Undo</button><button disabled="@(_redo.Count == 0)" @onclick="Redo">Redo</button><button @onclick="Clear">@(EditArea ? "Clear edit area" : "Clear protection")</button>
                <label>View<select @bind="_view" @bind:after="Render"><option value="selection">Selections</option><option value="original">Original</option><option value="input">What the model receives</option></select></label>
            </div>
            <div class="region-controls region-input-crop" role="group" aria-label="Input crop">
                <span role="status"><strong>Model input:</strong> @InputCropLabel</span>
                @if (EditArea) {
                    <button disabled="@_busy" @onclick="CropInputToSelection">Crop input to selection</button>
                    <button @onclick="AdjustInputCrop">Adjust input crop</button>
                    <button @onclick="FullContext">Use full image</button>
                }
            </div>
            <p class="field-hint">@(EditArea
                ? "Paint blue where the result may change. Pixels outside the edit area stay unchanged. Purple protection stays in place. Selecting an area does not crop the input."
                : ReferenceOnly ? "Paint purple to hide parts of this reference from the model. The original reference stays unchanged."
                : "Paint purple to hide pixels from the model and restore them in the result. Your existing edit-area selection is kept.")</p>
            <div class="region-stage" @ref="_stage"><canvas @ref="_canvas" tabindex="0" aria-label="Image selection canvas; use precise rectangle controls for keyboard selection"></canvas></div>
            <details class="region-precise"><summary>Precise rectangle controls</summary>
                <div class="region-controls">
                    <label>Left %<input type="number" min="0" max="99.9" step="0.1" @bind="_left" /></label><label>Top %<input type="number" min="0" max="99.9" step="0.1" @bind="_top" /></label>
                    <label>Width %<input type="number" min="0.1" max="100" step="0.1" @bind="_width" /></label><label>Height %<input type="number" min="0.1" max="100" step="0.1" @bind="_height" /></label>
                    <button @onclick="AddRectangle">@(EditArea ? "Apply rectangle to selected paint layer" : "Protect rectangle")</button>
                </div>
            </details>
            <p class="field-hint">@_selection.Width × @_selection.Height source pixels · @_selection.Strokes.Count(s => s.Protect != EditArea) @(EditArea ? "edit" : "protection") strokes · @_aspect canvas.</p>
        }
        else { <p role="status">Loading source pixels…</p> }
        @if (_error is not null) { <p class="field-error" role="alert">@_error</p> }
    </DialogContent>
    <DialogActions>
        <DialogFooter>
            <Tools><button type="button" class="lumi-button danger" disabled="@_busy" @onclick="RemoveLayer">@(EditArea ? "Remove edit area" : "Remove protection")</button></Tools>
            <ChildContent>
                <DialogDismiss Label="Cancel" OnDismiss="RequestCancel" Disabled="_busy" Confirming="_confirmingDiscard" OnDiscard="Cancel" OnKeepEditing="() => _confirmingDiscard = false" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _selection is null)" OnClick="Apply">@(EditArea ? "Apply edit area" : "Apply protection")</MudButton>
            </ChildContent>
        </DialogFooter>
    </DialogActions>
</MudDialog>
@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public AssetImageReference Source { get; set; } = null!;
    [Parameter] public RegionalImageSelection? Initial { get; set; }
    [Parameter] public ImageCropRegion? Crop { get; set; }
    [Parameter] public string Aspect { get; set; } = "1:1";
    [Parameter] public int Resolution { get; set; } = 1024;
    [Parameter] public QwenImage21Options? QwenImage21 { get; set; }
    [Parameter] public bool ReferenceOnly { get; set; }
    [Parameter] public bool EditArea { get; set; }
    [Parameter] public string Label { get; set; } = "Image 1";
    [Parameter] public EventCallback<RegionalImageSelection?> Applied { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private MudDialog? _dialog; private bool _visible = true, _confirmingDiscard;
    private static readonly DialogOptions Options = DialogSizes.Media with { CloseOnEscapeKey = false };
    private string Title => EditArea ? "Edit area" : "Protect areas";
    private RegionalImageSelection? _selection;
    private byte[]? _original;
    private IJSObjectReference? _module; private DotNetObjectReference<ImageRegionEditor>? _reference;
    private ElementReference _canvas, _stage;
    private string _layer = "protect", _tool = "brush", _view = "selection", _aspect = "1:1";
    private int _brush = 5, _zoom = 100;
    private double _left = 25, _top = 25, _width = 50, _height = 50;
    private bool _busy, _disposed, _attached;
    private string? _error;
    private readonly Stack<RegionalImageSelection> _undo = [], _redo = [];
    private string InputCropLabel
    {
        get
        {
            if (_selection is null) return "";
            var crop = ImageGeometry.CropPixels(_selection.Width, _selection.Height, _selection.Context);
            return $"{(crop.Width == _selection.Width && crop.Height == _selection.Height ? "Full image" : "Cropped")} · {crop.Width} × {crop.Height} source pixels";
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _aspect = Aspect;
            if (EditArea && ReferenceOnly) throw new AiGenerationException("An edit area is only available for Image 1.");
            _layer = EditArea ? "edit" : "protect";
            await using var media = await AssetStore.OpenImageAsync(ProjectId, Source.AssetId, Source.ImageId);
            if (media is null) throw new AiGenerationException("The source image is unavailable.");
            _original = await RegionalImageEdits.OriginalAsync(media.Content);
            var size = ImageInspector.Inspect(_original);
            var hash = RegionalImageEdits.Hash(_original);
            if (Initial is not null && (Initial.Source != Source || Initial.SourceHash != hash)) throw new AiGenerationException("The source changed. Remove the old selections and select the areas again.");
            _selection = Initial?.Copy() ?? new() { Source = Source, SourceHash = hash, Width = size.Width, Height = size.Height, Context = Crop ?? new() { X = 0, Y = 0, Width = 1, Height = 1 } };
            if (EditArea) _selection = _selection with { Mode = RegionalEditMode.Edit };
        }
        catch (Exception e) { _error = e.Message; }
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_attached || _selection is null || _disposed) return;
        _attached = true;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("image-regions.js"));
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attach", _canvas, _stage, _reference, Data(_original!));
        await Render();
    }
    private static string Data(byte[] png) => "data:image/png;base64," + Convert.ToBase64String(png);
    private async Task Render()
    {
        if (_module is null || _selection is null || _disposed) return;
        try
        {
            string? preview = null;
            if (_view == "input") { using var stream = new MemoryStream(_original!); preview = Data((await RegionalImageEdits.PrepareAsync(stream, _selection, _aspect, resolution: Resolution, qwen: QwenImage21)).Png); }
            await _module.InvokeVoidAsync("render", _canvas, _selection, new { layer = _layer, tool = _tool, brush = _brush / 100.0, zoom = _zoom / 100.0, view = _view }, preview);
        }
        catch (Exception e) { _error = e.Message; }
    }
    private async Task Change(RegionalImageSelection next)
    { _undo.Push(_selection!); _redo.Clear(); _selection = next; _error = null; _confirmingDiscard = false; await Render(); }
    [JSInvokable] public async Task Stroke(MaskStroke stroke)
    {
        if (_disposed || _busy || _selection is null) return;
        await InvokeAsync(async () => { await Change(_selection with { Strokes = _selection.Strokes.Append(stroke with { Protect = !EditArea }).ToArray() }); StateHasChanged(); });
    }
    [JSInvokable] public async Task Context(ImageCropRegion crop)
    { if (_disposed || _busy || _selection is null || !EditArea) return; await InvokeAsync(async () => { await Change(_selection with { Context = crop }); StateHasChanged(); }); }
    private async Task AddRectangle()
    {
        if (_left < 0 || _top < 0 || _width <= 0 || _height <= 0 || _left + _width > 100 || _top + _height > 100) { _error = "Keep the rectangle inside the image."; return; }
        if (_layer == "context") await Context(new() { X = _left / 100, Y = _top / 100, Width = _width / 100, Height = _height / 100 });
        else await Stroke(new(_layer == "protect", _tool == "erase", true, .01, [new(_left / 100, _top / 100), new((_left + _width) / 100, (_top + _height) / 100)]));
    }
    private Task FullContext() => Context(new() { X = 0, Y = 0, Width = 1, Height = 1 });
    private async Task CropInputToSelection()
    {
        if (_selection is null || _busy) return;
        try
        {
            var crop = RegionalImageEdits.CropToSelection(_selection);
            _view = "input";
            await Change(_selection with { Context = crop });
        }
        catch (AiGenerationException e) { _error = e.Message; }
    }
    private async Task AdjustInputCrop() { _layer = "context"; _tool = "rectangle"; _view = "selection"; await Render(); }
    private Task Clear() => Change(_selection! with { Strokes = _selection.Strokes.Where(s => s.Protect == EditArea).ToArray() });
    private async Task Undo() { if (_undo.TryPop(out var previous)) { _redo.Push(_selection!); _selection = previous; await Render(); } }
    private async Task Redo() { if (_redo.TryPop(out var next)) { _undo.Push(_selection!); _selection = next; await Render(); } }
    private async Task Apply()
    {
        if (_selection is null) return;
        _busy = true;
        try {
            RegionalImageEdits.Validate(_selection);
            var masks = RegionalImageEdits.Masks(_selection);
            if (!ReferenceOnly && !masks.Edit.Any(x => x)) throw new AiGenerationException(EditArea ? "Select at least one editable pixel outside the protected areas." : "Leave at least one editable pixel unprotected.");
            if (!EditArea && !masks.Protect.Any(x => x)) await RemoveLayer();
            else await Finish(_selection);
        }
        catch (Exception e) { _error = e.Message; } finally { _busy = false; }
    }
    // Painted or cropped changes since opening ask before they are discarded.
    private Task RequestCancel()
    {
        if (_busy || _confirmingDiscard) return Task.CompletedTask;
        if (_undo.Count > 0) { _confirmingDiscard = true; return Task.CompletedTask; }
        return Cancel();
    }
    private async Task Cancel() { if (_busy) return; _visible = false; if (_dialog is not null) await _dialog.CloseAsync(); await Cancelled.InvokeAsync(); }
    private Task RemoveLayer() {
        var selection = _selection ?? Initial;
        if (selection is null) return Finish(null);
        var remaining = selection with { Mode = EditArea ? RegionalEditMode.Protect : selection.Mode,
            Strokes = selection.Strokes.Where(s => s.Protect == EditArea).ToArray() };
        return Finish(remaining.Mode == RegionalEditMode.Protect && !remaining.Strokes.Any(s => s.Protect && !s.Erase) ? null : remaining);
    }
    private async Task Finish(RegionalImageSelection? selection) { _visible = false; if (_dialog is not null) await _dialog.CloseAsync(); await Applied.InvokeAsync(selection); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_module is not null) { await _module.InvokeVoidAsync("detach", _canvas); await _module.DisposeAsync(); } } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
