@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="asset-list" @ref="_element">
@foreach (var asset in Items) {
    var kept = asset.Images.Where(i => i.PendingReview != true).ToArray();
    var cover = kept.FirstOrDefault(i => i.IsCover) ?? kept.FirstOrDefault();
    <div class="asset-list-row @(asset.Id == SelectedId ? "selected" : "")" @key="asset.Id" data-asset-id="@asset.Id">
        <button class="asset-drag" data-asset-drag disabled="@(Disabled || !_orderReady)" aria-label="Move @asset.Name" title="Drag to reorder; click for Move to…" @onclick="() => MoveRequested.InvokeAsync(asset.Id)">⠿</button>
        <button class="asset-choice" aria-pressed="@(asset.Id == SelectedId ? "true" : "false")" @onclick="() => Selected.InvokeAsync(asset.Id)">
            @if (cover is not null) { <img src="@($"/media/projects/{ProjectId}/assets/{asset.Id}/images/{cover.Id}")" alt="" loading="lazy" /> }
            else { <span class="asset-choice-placeholder" aria-hidden="true">◇</span> }
            <span><strong>@asset.Name</strong><small>@asset.Category · @kept.Length @(kept.Length == 1 ? "image" : "images")</small>@if (asset.Images.Count - kept.Length > 0) { <small>@(asset.Images.Count - kept.Length) pending review</small> }</span>
        </button>
        <MudMenu Icon="@Icons.Material.Outlined.MoreHoriz" AriaLabel="@($"Actions for {asset.Name}")" Size="Size.Small" Dense="true">
            <MudMenuItem role="menuitem" OnClick="() => Rename.InvokeAsync(asset.Id)">Rename</MudMenuItem>
            <MudMenuItem role="menuitem" Disabled="Disabled" OnClick="() => MoveRequested.InvokeAsync(asset.Id)">Move to…</MudMenuItem>
            <MudMenuItem role="menuitem" Disabled="Disabled" OnClick="() => Delete.InvokeAsync(asset.Id)" Class="danger-link">Delete</MudMenuItem>
        </MudMenu>
        @if (ReviewReady.Contains(asset.Id)) {
            <button class="asset-prompt-review" data-prompt-state="ReviewReady" aria-label="@($"Review the enhanced prompt for {asset.Name}")" title="An enhanced prompt is ready. Review it, then apply or discard it." @onclick="() => ReviewRequested.InvokeAsync(asset.Id)">Review ready <span aria-hidden="true">→</span></button>
        }
    </div>
}
</div>
@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public IEnumerable<ReferenceAsset> Items { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid> Selected { get; set; }
    [Parameter] public EventCallback<Guid> Rename { get; set; }
    [Parameter] public EventCallback<Guid> Delete { get; set; }
    [Parameter] public EventCallback<Guid> MoveRequested { get; set; }
    [Parameter] public EventCallback<AssetMove> Moved { get; set; }
    // Assets whose finished prompt enhancement has not been applied or discarded.
    [Parameter] public IReadOnlySet<Guid> ReviewReady { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<Guid> ReviewRequested { get; set; }
    public sealed record AssetMove(Guid Id, Guid Target, bool After);
    private ElementReference _element;
    private DotNetObjectReference<AssetLibraryList>? _reference;
    private IJSObjectReference? _module, _drag;
    private bool _orderReady, _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("asset-library-order.js"));
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        _drag = await _module.InvokeAsync<IJSObjectReference>("attach", _element, _reference);
        if (_disposed) { await _drag.InvokeVoidAsync("dispose"); await _drag.DisposeAsync(); return; }
        _orderReady = true;
        StateHasChanged();
    }
    [JSInvokable] public Task Move(string id, string target, bool after) => Disabled ? Task.CompletedTask : Moved.InvokeAsync(new(Guid.Parse(id), Guid.Parse(target), after));
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_drag is not null) { await _drag.InvokeVoidAsync("dispose"); await _drag.DisposeAsync(); } if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
