@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="reference-image-menu" @ref="_element" @onkeydown="KeyDownAsync">
    <MudMenu @ref="_menu" @bind-Open="_open" PopoverClass="reference-image-menu-popover" Icon="@Icons.Material.Outlined.MoreHoriz" AriaLabel="Image actions" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        <div role="menu" aria-label="Image actions" @onkeydown="KeyDownAsync">
            @if (Rename.HasDelegate) { <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(Rename)">Rename</MudMenuItem> }
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(EditDetails)">Edit details</MudMenuItem>
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(Crop)" Disabled="CropDisabled">Crop image</MudMenuItem>
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(Move)" Disabled="MoveDisabled">Move to asset…</MudMenuItem>
            @if (CreateSimilar.HasDelegate && Image.Generation is not null) { <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(CreateSimilar)" Disabled="CreateSimilarDisabled">Create similar</MudMenuItem> }
            @if (ChangeLook.HasDelegate) { <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(ChangeLook)" Disabled="ChangeLookDisabled">Change look…</MudMenuItem> }
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(ToggleReference)">@(Image.IsReference ? "Unapprove reference" : "Approve reference")</MudMenuItem>
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(MakeCover)" Disabled="Image.IsCover">Make cover</MudMenuItem>
            <MudDivider />
            <MudMenuItem role="menuitem" AutoClose="false" OnClick="() => ActivateAsync(Trash)" Disabled="DeleteDisabled" Class="danger-link">Move to Trash</MudMenuItem>
        </div>
    </MudMenu>
</div>
@code {
    [Parameter, EditorRequired] public AssetImage Image { get; set; } = null!;
    [Parameter] public bool CropDisabled { get; set; }
    [Parameter] public bool MoveDisabled { get; set; }
    [Parameter] public bool ChangeLookDisabled { get; set; }
    [Parameter] public bool DeleteDisabled { get; set; }
    [Parameter] public bool CreateSimilarDisabled { get; set; }
    [Parameter] public EventCallback CreateSimilar { get; set; }
    [Parameter] public EventCallback EditDetails { get; set; }
    [Parameter] public EventCallback Rename { get; set; }
    [Parameter] public EventCallback Crop { get; set; }
    [Parameter] public EventCallback Move { get; set; }
    [Parameter] public EventCallback ChangeLook { get; set; }
    [Parameter] public EventCallback ToggleReference { get; set; }
    [Parameter] public EventCallback MakeCover { get; set; }
    [Parameter] public EventCallback Trash { get; set; }
    private MudMenu? _menu;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _open;
    private async Task CloseAsync()
    {
        if (_menu is not null) await _menu.CloseMenuAsync();
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("assets-studio.js"));
        await _module.InvokeVoidAsync("focusReferenceImageActions", _element);
    }
    private async Task ActivateAsync(EventCallback action)
    {
        // Close and focus the card first so dialogs return to a persistent control.
        await CloseAsync();
        await action.InvokeAsync();
    }
    private Task KeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape" && _open ? CloseAsync() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
