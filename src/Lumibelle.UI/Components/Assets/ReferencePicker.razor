<div class="reference-picker">
    @if (Toolbar is not null) { <div class="reference-picker-toolbar">@Toolbar</div> }
    <div class="reference-mobile-tabs" role="tablist" aria-label="Reference editor">
        <button @ref="_browseTab" role="tab" id="@(_id + "-browse-tab")" aria-controls="@(_id + "-browse")" aria-selected="@(!SelectedTab ? "true" : "false")" tabindex="@(!SelectedTab ? 0 : -1)" @onclick="() => SelectTab(false)" @onkeydown="TabKey">@(IncludeReels ? "Browse" : "Browse images")</button>
        <button @ref="_selectionTab" role="tab" id="@(_id + "-selected-tab")" aria-controls="@(_id + "-selected")" aria-selected="@(SelectedTab ? "true" : "false")" tabindex="@(SelectedTab ? 0 : -1)" @onclick="() => SelectTab(true)" @onkeydown="TabKey">Selected references (@SelectedCount)</button>
    </div>
    <div class="manual-reference-columns @(SelectedTab ? "show-selected" : "show-browse")">
        <section id="@(_id + "-browse")" class="reference-browser" aria-label="Browse references">
            <h3>@(IncludeReels ? "Add from Assets" : "Add images from Assets")</h3>
            @BrowserNotice
            <ProjectImagePicker Library="Library" BrowseOnly="true" IncludeReels="IncludeReels" OnlyKind="@OnlyKind"
                Maximum="@(Disabled ? 0 : Maximum)" Excluded="Excluded" ImagePicked="ImagePicked"
                MaximumReels="@(Disabled ? 0 : MaximumReels)" ExcludedVideoMedia="ExcludedVideoMedia" ReferencePicked="ReferencePicked" ReelAction="@ReelAction" ImageAction="@ImageAction" />
        </section>
        <section id="@(_id + "-selected")" class="reference-selection" aria-label="Selected references">
            @if (SelectionToolbar is not null) { <div class="reference-selection-toolbar">@SelectionToolbar</div> }
            <div class="reference-selection-content">@Selection</div>
        </section>
    </div>
    <footer class="manual-reference-footer reference-editor-footer">@Footer</footer>
</div>

@code {
    [Parameter, EditorRequired] public AssetLibrary Library { get; set; } = null!;
    [Parameter] public bool IncludeReels { get; set; }
    [Parameter] public string? OnlyKind { get; set; }
    [Parameter] public int Maximum { get; set; }
    [Parameter] public int MaximumReels { get; set; }
    // Replaces the reel named in the label instead of adding one, such as "Replace Video 3".
    [Parameter] public string? ReelAction { get; set; }
    [Parameter] public string? ImageAction { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlyList<AssetImageReference> Excluded { get; set; } = [];
    [Parameter] public IReadOnlyList<Guid> ExcludedVideoMedia { get; set; } = [];
    [Parameter] public EventCallback<AssetImageReference> ImagePicked { get; set; }
    [Parameter] public EventCallback<AssetReferenceChoice> ReferencePicked { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public bool SelectedTab { get; set; }
    [Parameter] public EventCallback<bool> SelectedTabChanged { get; set; }
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? BrowserNotice { get; set; }
    [Parameter] public RenderFragment? SelectionToolbar { get; set; }
    [Parameter, EditorRequired] public RenderFragment Selection { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment Footer { get; set; } = null!;
    private readonly string _id = "references-" + Guid.NewGuid().ToString("N");
    private ElementReference _browseTab, _selectionTab;
    private Task SelectTab(bool selected) => SelectedTabChanged.InvokeAsync(selected);
    private async Task TabKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var selected = e.Key == "End" || e.Key != "Home" && !SelectedTab;
        await SelectTab(selected);
        await (selected ? _selectionTab : _browseTab).FocusAsync();
    }
}
