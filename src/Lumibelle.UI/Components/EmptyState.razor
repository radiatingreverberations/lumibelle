@* An empty collection or workspace: what is missing, why, and the one action that fills it.
   Compact states sit inside a pane, list or gallery; full states fill a page or workspace. *@
<div class="empty-state @(Compact ? "compact" : null) @Class" @attributes="AdditionalAttributes">
    @if (Icon is not null) { <div class="empty-icon" aria-hidden="true"><MudIcon Icon="@Icon" /></div> }
    @if (Title is not null)
    {
        @switch (HeadingLevel)
        {
            case 1: <h1 class="empty-state-title">@Title</h1> break;
            case 3: <h3 class="empty-state-title">@Title</h3> break;
            default: <h2 class="empty-state-title">@Title</h2> break;
        }
    }
    @if (ChildContent is not null) { <div class="empty-state-text">@ChildContent</div> }
    @if (Actions is not null) { <div class="empty-state-actions">@Actions</div> }
</div>
@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    // 1 when the empty state replaces a whole page (not found, load error); 2 inside a workspace; 3 inside a section.
    [Parameter] public int HeadingLevel { get; set; } = 2;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
